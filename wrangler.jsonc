{
  "name": "weilizhe8",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DESKS", "class_name": "StudentDesk" }]
  },
  "migrations": [{ "tag": "desk-sync-v1", "new_sqlite_classes": ["StudentDesk"] }]
}
