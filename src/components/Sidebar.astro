---
const groups = [
  { title: '学习管理', items: [ ['dashboard','layout-dashboard','今日概览'], ['calendar','calendar-check','日程与任务'], ['courses','book-open','课程管理'], ['gpa','chart-no-axes-combined','绩点计算'] ] },
  { title: '常用工具', items: [ ['tools','compass','常用工具'], ['script-builder','terminal','测试脚本生成器'], ['base-converter','binary','进制转换'], ['latex-tool','sigma','LaTeX 工具'], ['video-dl','video','视频获取'] ] },
  { title: '实验与灵感', items: [ ['spinner','disc-3','我来决策'], ['em-master','atom','电磁大师'], ['momentum-shooter','orbit','动量射击'] ] },
];
---
<a class="skip-link" href="#main-content">跳转到主要内容</a>
<button id="nav-backdrop" class="nav-backdrop" aria-label="关闭导航" tabindex="-1"></button>
<aside id="app-sidebar" class="app-sidebar t-bg-sidebar">
  <div class="sidebar-brand"><span class="brand-mark"><i data-lucide="waypoints"></i></span><div><strong>WEILIZHE8</strong><span>学术终端 / PERSONAL DESK</span></div></div>
  <div class="sidebar-semester"><span class="status-dot"></span>大二上<span>2026 AUTUMN</span></div>
  <nav id="sidebar-nav" aria-label="主导航">
    {groups.map(group => <section class="nav-group"><h2>{group.title}</h2>{group.items.map(([tab, icon, label]) => <button data-tab={tab} aria-current={tab === 'dashboard' ? 'page' : undefined} class:list={['sidebar-btn', {active:tab === 'dashboard'}]}><i data-lucide={icon}></i><span>{label}</span>{tab === 'dashboard' && <span class="nav-current-dot"></span>}</button>)}</section>)}
  </nav>
  <div class="sidebar-footer"><button data-tab="backup" class="sidebar-btn"><i data-lucide="hard-drive-download"></i><span>数据备份</span></button><button onclick="toggleTheme()" class="theme-toggle-btn"><i data-lucide="sun" id="icon-sun"></i><i data-lucide="moon" class="hidden" id="icon-moon"></i><span id="theme-label">亮色模式</span></button><p>为每一天的积累，留一个位置。</p></div>
</aside>

<script>
  declare const lucide: { createIcons: () => void };

  function updateThemeUI() {
    const theme = document.documentElement.getAttribute('data-theme');
    const iconSun = document.getElementById('icon-sun');
    const iconMoon = document.getElementById('icon-moon');
    const label = document.getElementById('theme-label');
    if (iconSun && iconMoon && label) {
      if (theme === 'light') {
        iconSun.classList.remove('hidden');
        iconMoon.classList.add('hidden');
        label.textContent = '暗色模式';
      } else {
        iconSun.classList.add('hidden');
        iconMoon.classList.remove('hidden');
        label.textContent = '亮色模式';
      }
    }
    lucide.createIcons();
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('wd_theme', next);
    updateThemeUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateThemeUI);
  } else {
    updateThemeUI();
  }

  // Expose to inline onclick handlers
  (window as any).toggleTheme = toggleTheme;
</script>
