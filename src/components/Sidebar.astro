---
---

<aside class="w-56 flex-shrink-0 flex flex-col h-screen select-none t-bg-sidebar" style="border-right:1px solid var(--border-default)">
  <!-- Brand -->
  <div class="px-4 py-4" style="border-bottom:1px solid var(--border-subtle)">
    <div class="flex items-center gap-3">
      <div style="width:26px;height:26px;border-radius:6px;background:linear-gradient(135deg,var(--accent-light),var(--accent));flex-shrink:0"></div>
      <div>
        <div style="font-weight:700;font-size:13px;color:var(--text-primary);letter-spacing:-0.3px;line-height:1.2">WEILIZHE8</div>
        <div style="font-size:8px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-weight:600;letter-spacing:0.5px">ACADEMIC TERMINAL</div>
      </div>
    </div>
  </div>

  <!-- Nav Items -->
  <nav class="flex-1 py-3 px-2 space-y-0.5 overflow-y-auto" id="sidebar-nav">
    <button data-tab="dashboard" class="sidebar-btn active w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-primary);background:linear-gradient(135deg,var(--bg-card-hover) 0%,var(--bg-card) 100%);border:1px solid rgba(124,62,212,0.12)">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--accent);border-color:var(--accent)">01</span>
      <span>控制面板</span>
    </button>
    <button data-tab="calendar" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">02</span>
      <span>日程与倒计时</span>
    </button>
    <button data-tab="courses" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">03</span>
      <span>课程管理</span>
    </button>
    <button data-tab="gpa" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">04</span>
      <span>绩点计算</span>
    </button>
    <button data-tab="tools" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">05</span>
      <span>常用工具</span>
    </button>
    <button data-tab="script-builder" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">06</span>
      <span>测试脚本生成器</span>
    </button>
    <button data-tab="base-converter" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">07</span>
      <span>进制转化器</span>
    </button>
    <button data-tab="latex-tool" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">08</span>
      <span>Latex工具</span>
    </button>
    <button data-tab="spinner" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">09</span>
      <span>我来决策</span>
    </button>
    <button data-tab="em-master" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">10</span>
      <span>电磁大师</span>
    </button>
    <button data-tab="momentum-shooter" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">11</span>
      <span>动量射击</span>
    </button>
    <button data-tab="video-dl" class="sidebar-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-md text-xs font-semibold transition-all"
      style="color:var(--text-secondary);border:1px solid transparent">
      <span class="font-mono text-[9px] font-semibold px-1 py-0.5 rounded border" style="color:var(--text-muted);border-color:var(--border-default)">12</span>
      <span>视频获取</span>
    </button>
  </nav>

  <!-- Footer -->
  <div class="p-3 space-y-2" style="border-top:1px solid var(--border-subtle)">
    <button onclick="toggleTheme()" class="theme-toggle-btn w-full">
      <i data-lucide="sun" class="w-3 h-3 flex-shrink-0" id="icon-sun"></i>
      <i data-lucide="moon" class="w-3 h-3 flex-shrink-0 hidden" id="icon-moon"></i>
      <span id="theme-label">亮色模式</span>
    </button>
    <div class="flex items-center justify-between px-1" style="font-size:8px;color:var(--text-muted);font-weight:600">
      <span>BUILD 2.0</span>
      <span class="flex items-center gap-1">
        <span style="width:5px;height:5px;border-radius:50%;background:var(--border-default)"></span>
        <span style="width:5px;height:5px;border-radius:50%;background:var(--accent)"></span>
      </span>
    </div>
  </div>
</aside>

<script>
  declare const lucide: { createIcons: () => void };

  function updateThemeUI() {
    const theme = document.documentElement.getAttribute('data-theme');
    const iconSun = document.getElementById('icon-sun');
    const iconMoon = document.getElementById('icon-moon');
    const label = document.getElementById('theme-label');
    if (iconSun && iconMoon && label) {
      if (theme === 'light') {
        iconSun.classList.remove('hidden');
        iconMoon.classList.add('hidden');
        label.textContent = '暗色模式';
      } else {
        iconSun.classList.add('hidden');
        iconMoon.classList.remove('hidden');
        label.textContent = '亮色模式';
      }
    }
    lucide.createIcons();
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('wd_theme', next);
    updateThemeUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateThemeUI);
  } else {
    updateThemeUI();
  }

  // Expose to inline onclick handlers
  (window as any).toggleTheme = toggleTheme;
</script>
