---
interface Props {
  title: string;
  active?: 'home' | 'calendar' | 'courses' | 'tools';
}
const { title, active } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Weilizhe8 - Personal Dashboard" />
  <title>{title} | Weilizhe8</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <nav class="sidebar glass" aria-label="主导航">
    <a href="/" class="logo" aria-label="首页">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
        <rect width="28" height="28" rx="7" fill="var(--color-primary)"/>
        <text x="14" y="19" text-anchor="middle" fill="white" font-size="15" font-weight="700" font-family="Inter, sans-serif">W</text>
      </svg>
      <span>Weilizhe8</span>
    </a>
    <div class="nav-links">
      <a href="/" class:list={['nav-item', { active: active === 'home' }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        概览
      </a>
      <a href="/calendar" class:list={['nav-item', { active: active === 'calendar' }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        日历
      </a>
      <a href="/courses" class:list={['nav-item', { active: active === 'courses' }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        课程
      </a>
      <a href="/tools" class:list={['nav-item', { active: active === 'tools' }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        工具
      </a>
    </div>
  </nav>

  <main class="main-content">
    <div class="container">
      <slot />
    </div>
  </main>

  <nav class="bottom-nav glass" aria-label="移动端导航">
    <a href="/" class:list={['bottom-nav-item', { active: active === 'home' }]}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>概览</span>
    </a>
    <a href="/calendar" class:list={['bottom-nav-item', { active: active === 'calendar' }]}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span>日历</span>
    </a>
    <a href="/courses" class:list={['bottom-nav-item', { active: active === 'courses' }]}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      <span>课程</span>
    </a>
    <a href="/tools" class:list={['bottom-nav-item', { active: active === 'tools' }]}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      <span>工具</span>
    </a>
  </nav>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  body {
    display: grid;
    grid-template-columns: 220px 1fr;
    grid-template-rows: 1fr auto;
  }

  .sidebar {
    grid-row: 1;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-height: 100dvh;
    position: sticky;
    top: 0;
    border-right: 1px solid var(--glass-border);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-foreground);
    padding: 0 0.25rem;
  }
  .logo:hover {
    color: var(--color-foreground);
    opacity: 0.8;
  }
  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    color: #86868B;
    font-size: 0.88rem;
    font-weight: 500;
    transition: all var(--transition);
  }
  .nav-item:hover {
    background: rgba(0,0,0,0.04);
    color: var(--color-foreground);
  }
  .nav-item.active {
    background: rgba(0,122,255,0.08);
    color: var(--color-primary);
    font-weight: 600;
  }

  .main-content {
    grid-row: 1;
    padding: 2rem 0 3rem;
  }

  .bottom-nav {
    display: none;
  }

  @media (max-width: 768px) {
    body {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      padding-bottom: 72px;
    }
    .sidebar {
      display: none;
    }
    .main-content {
      padding: 1rem 0;
    }
    .bottom-nav {
      grid-row: 2;
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 0.35rem 0.5rem;
      padding-bottom: max(0.35rem, env(safe-area-inset-bottom));
      justify-content: space-around;
      z-index: 100;
      border-top: 1px solid var(--glass-border);
    }
    .bottom-nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.1rem;
      padding: 0.3rem 0.6rem;
      border-radius: 8px;
      color: #86868B;
      font-size: 0.65rem;
      font-weight: 500;
      min-width: 56px;
    }
    .bottom-nav-item.active {
      color: var(--color-primary);
      font-weight: 600;
    }
  }
</style>
