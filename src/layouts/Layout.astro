---
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>weilizhe8 · 学术终端</title>
  <meta name="description" content="个人学术仪表盘" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
        }
      }
    }
  </script>
  <script is:inline src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <!-- Anti-FOUC: set theme BEFORE render -->
  <script is:inline>
    (function() {
      var saved = localStorage.getItem('wd_theme');
      var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <style is:global>
    /* ============================================================
       CSS VARIABLE THEME SYSTEM — Purple Accent
       ============================================================ */
    :root, [data-theme="dark"] {
      --bg-page:        #0a0a0a;
      --bg-card:        #111113;
      --bg-card-hover:  #161618;
      --bg-input:       #161618;
      --bg-sidebar:     #0c0c0e;
      --border-default: #1a1a1a;
      --border-subtle:  #1f1f22;
      --text-primary:   #fafafa;
      --text-secondary: #a1a1aa;
      --text-muted:     #71717a;
      --accent:         #7c3ed4;
      --accent-soft:    #a78bfa;
      --accent-light:   #c4b5fd;
      --accent-glow:    rgba(124,62,212,0.10);
      --accent-ring:    rgba(124,62,212,0.50);
      --accent-border-subtle: rgba(124,62,212,0.12);
      --success:        #34d399;
      --success-soft:   rgba(52,211,153,0.12);
      --warning:        #fbbf24;
      --warning-soft:   rgba(251,191,36,0.12);
      --danger:         #f87171;
      --danger-soft:    rgba(248,113,113,0.08);
      --shadow:         0 1px 2px rgba(0,0,0,0.4);
      --shadow-lg:      0 4px 12px rgba(0,0,0,0.5);
    }

    [data-theme="light"] {
      --bg-page:        #fafafa;
      --bg-card:        #ffffff;
      --bg-card-hover:  #f5f5f7;
      --bg-input:       #f0f0f3;
      --bg-sidebar:     #f5f5f7;
      --border-default: #e5e5e7;
      --border-subtle:  #f0f0f3;
      --text-primary:   #0a0a0a;
      --text-secondary: #52525b;
      --text-muted:     #9a9aa5;
      --accent:         #6d28d9;
      --accent-soft:    #7c3ed4;
      --accent-light:   #8b5cf6;
      --accent-glow:    rgba(109,40,217,0.06);
      --accent-ring:    rgba(109,40,217,0.50);
      --accent-border-subtle: rgba(109,40,217,0.12);
      --success:        #059669;
      --success-soft:   rgba(5,150,105,0.1);
      --warning:        #d97706;
      --warning-soft:   rgba(217,119,6,0.1);
      --danger:         #dc2626;
      --danger-soft:    rgba(220,38,38,0.08);
      --shadow:         0 1px 3px rgba(0,0,0,0.06);
      --shadow-lg:      0 4px 16px rgba(0,0,0,0.08);
    }

    /* ============================================================
       GLOBAL RESET & BASE
       ============================================================ */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    *, *::before, *::after {
      transition: background-color 0.2s ease, border-color 0.2s ease, color 0.15s ease, box-shadow 0.2s ease;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-primary);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .hidden { display: none !important; }

    /* ============================================================
       SCROLLBAR
       ============================================================ */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-default); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

    /* ============================================================
       LUCIDE ICONS
       ============================================================ */
    .lucide { stroke-width: 1.5; }

    /* ============================================================
       MODAL OVERLAY
       ============================================================ */
    .modal-overlay {
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(3px);
    }
    [data-theme="light"] .modal-overlay {
      background: rgba(0,0,0,0.3);
      backdrop-filter: blur(4px);
    }

    /* ============================================================
       TAB PANE ANIMATION
       ============================================================ */
    .tab-pane {
      animation: fadeTab 0.2s ease;
    }
    @keyframes fadeTab {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       PROGRESS BAR
       ============================================================ */
    .progress-fill {
      transition: width 0.6s ease;
    }

    /* ============================================================
       CARD HOVER ANIMATION
       ============================================================ */
    .card-hover {
      transition: transform 0.3s cubic-bezier(0.4,0,0.2,1),
                  border-color 0.3s cubic-bezier(0.4,0,0.2,1),
                  box-shadow 0.3s cubic-bezier(0.4,0,0.2,1);
      cursor: pointer;
    }
    .card-hover:hover {
      transform: scale(1.02);
      border-color: var(--accent);
      box-shadow: 0 4px 20px var(--accent-glow);
    }

    /* ============================================================
       CARD GRADIENT BASE
       ============================================================ */
    .card-gradient {
      background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-card-hover) 100%);
    }

    /* ============================================================
       FORM INPUT CALENDAR PICKER
       ============================================================ */
    input[type="datetime-local"]::-webkit-calendar-picker-indicator,
    input[type="date"]::-webkit-calendar-picker-indicator,
    input[type="time"]::-webkit-calendar-picker-indicator {
      filter: invert(0.6);
      cursor: pointer;
    }
    [data-theme="light"] input[type="datetime-local"]::-webkit-calendar-picker-indicator,
    [data-theme="light"] input[type="date"]::-webkit-calendar-picker-indicator,
    [data-theme="light"] input[type="time"]::-webkit-calendar-picker-indicator {
      filter: invert(0);
    }
    input[type="date"], input[type="time"] {
      color-scheme: dark;
    }
    [data-theme="light"] input[type="date"],
    [data-theme="light"] input[type="time"] {
      color-scheme: light;
    }

    /* ============================================================
       ACCENT PREFIX (>>> ConductorAI style)
       ============================================================ */
    .accent-prefix {
      color: var(--accent);
      font-family: 'JetBrains Mono', monospace;
      font-weight: 500;
    }

    /* ============================================================
       THEME-AWARE UTILITY CLASSES
       ============================================================ */
    .t-bg-card    { background: var(--bg-card); }
    .t-bg-input   { background: var(--bg-input); }
    .t-bg-page    { background: var(--bg-page); }
    .t-bg-hover   { background: var(--bg-card-hover); }
    .t-bg-sidebar { background: var(--bg-sidebar); }
    .t-border     { border-color: var(--border-default); }
    .t-border-sub { border-color: var(--border-subtle); }
    .t-text       { color: var(--text-primary); }
    .t-text-sec   { color: var(--text-secondary); }
    .t-text-muted { color: var(--text-muted); }
    .t-accent     { color: var(--accent); }
    .t-accent-soft { color: var(--accent-soft); }
    .t-accent-bg        { background: var(--accent); }
    .t-accent-bg-soft   { background: var(--accent-glow); }
    .t-accent-bg-hover:hover { background: var(--accent-glow); filter: brightness(1.3); }
    .t-accent-border    { border-color: var(--accent); }
    .t-accent-border-soft { border-color: rgba(124,62,212,0.25); }
    .t-accent-ring:focus { border-color: var(--accent-soft); outline: none; }
    .t-bg-progress      { background: linear-gradient(90deg, var(--accent), var(--accent-soft)); }
    .t-bg-progress-track { background: var(--border-default); }
    .t-hover-bg:hover           { background: var(--bg-card-hover); }
    .t-hover-accent:hover       { color: var(--accent-soft); }
    .t-hover-accent-light:hover { color: var(--accent-light); }
    .t-hover-accent-border:hover { border-color: var(--accent-ring); }
    .t-ring-accent              { box-shadow: 0 0 0 1px var(--accent-ring); }

    /* ============================================================
       THEME TOGGLE BUTTON
       ============================================================ */
    .theme-toggle-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.6rem;
      border-radius: 0.4rem;
      font-size: 0.65rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid var(--border-default);
      background: var(--bg-card);
      color: var(--text-secondary);
      transition: all 0.2s ease;
    }
    .theme-toggle-btn:hover {
      background: var(--bg-card-hover);
      color: var(--text-primary);
      border-color: var(--accent);
    }

    /* ============================================================
       STATUS DOT
       ============================================================ */
    .status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 8px rgba(52,211,153,0.4);
    }
  </style>
</head>
<body>
  <slot />
  <script is:inline>
    lucide.createIcons();
  </script>
</body>
</html>
