    function openModal(id: string) {
      const el = document.getElementById(id);
      if (el) { el.classList.remove('hidden'); el.setAttribute('role', 'dialog'); el.setAttribute('aria-modal', 'true'); const heading = el.querySelector('h2'); if (heading) { if (!heading.id) heading.id = id + '-heading'; el.setAttribute('aria-labelledby', heading.id); } }
    }

    function closeModal(id: string) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
      const form = el?.querySelector('form');
      if (form) form.reset();
      if (id === 'modal-event') {
        const titleEl = document.getElementById('modal-event-title');
        if (titleEl) titleEl.textContent = '新增日程';
      }
      if (id === 'modal-course') {
