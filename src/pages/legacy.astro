    // ============================================================
    // SEMESTER PROGRESS
    // ============================================================
    function renderSemesterProgress() {
      const now = Date.now();
      const start = SEMESTER.start.getTime();
      const end = SEMESTER.end.getTime();
      const totalDays = Math.ceil((end - start) / 86400000);
      const elapsed = Math.min(totalDays, Math.max(0, Math.floor((now - start) / 86400000)));
      const remaining = Math.max(0, Math.ceil((end - now) / 86400000));
      const week = Math.min(SEMESTER.totalWeeks, Math.max(1, Math.floor((now - start) / (7 * 86400000)) + 1));
      const pct = Math.min(100, Math.max(0, (elapsed / totalDays) * 100));

      const barEl = document.getElementById('semester-bar');
      if (barEl) barEl.style.width = pct.toFixed(1) + '%';
      const labelEl = document.getElementById('semester-label');
      if (labelEl) labelEl.textContent = `Week ${week} / ${SEMESTER.totalWeeks}`;
      const elapsedEl = document.getElementById('semester-elapsed');
      if (elapsedEl) elapsedEl.textContent = `已用 ${elapsed} 天`;
      const remEl = document.getElementById('semester-remaining');
      if (remEl) remEl.textContent = `剩余 ${remaining} 天`;
      const weeks = document.getElementById('semester-weeks');
      if (weeks) weeks.innerHTML = Array.from({ length: 16 }, (_, i) => `<span class="${i + 1 < week ? 'week-past' : i + 1 === week ? 'week-current' : ''}">${String(i + 1).padStart(2, '0')}</span>`).join('');
    }

    // ============================================================
    // EVENTS RENDERING
    // ============================================================
    let eventFilter: 'active' | 'completed' = 'active';
    function taskMarkup(e: Task, compact = false) {
      const completed = isCompleted(e);
      const overdue = !completed && Date.parse(e.deadline) < Date.now();
      const date = new Date(e.deadline).toLocaleString('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      return `<article class="task-row ${completed ? 'is-completed' : ''} ${overdue ? 'is-overdue' : ''}">
        <button class="task-check" data-task-action="toggle" data-task-id="${escapeHtml(e.id)}" aria-label="${completed ? '恢复任务' : '完成任务'}：${escapeHtml(e.name)}" title="${completed ? '恢复到待办' : '完成并归档'}"><i data-lucide="${completed ? 'check' : 'circle'}"></i></button>
        <div class="task-content"><h4>${escapeHtml(e.name)}</h4><p><span class="task-category">${escapeHtml(e.category)}</span><time>${date}</time>${e.location ? `<span>${escapeHtml(e.location)}</span>` : ''}</p>
        ${completed ? `<span class="task-completed-time">完成于 ${new Date(e.completedAt!).toLocaleString('zh-CN')}</span>` : overdue ? '<span class="overdue-label">已逾期 · 待处理</span>' : ''}</div>
        ${compact ? '' : `<div class="task-actions"><button class="icon-action" data-task-action="edit" data-task-id="${escapeHtml(e.id)}" aria-label="编辑任务"><i data-lucide="pencil"></i></button><button class="icon-action" data-task-action="delete" data-task-id="${escapeHtml(e.id)}" aria-label="删除任务"><i data-lucide="trash-2"></i></button></div>`}
      </article>`;
    }
    function emptyTasks(title: string, description: string) {
      return `<div class="empty-tasks"><i data-lucide="check-check"></i><strong>${title}</strong><p>${description}</p></div>`;
    }
    function renderEvents() {
      const events: Task[] = load(KEYS.events);
      const groups = taskGroups(events);
      const put = (id: string, html: string) => { const el = document.getElementById(id); if (el) el.innerHTML = html; };
      put('today-count', String(groups.today.length)); put('week-count', String(groups.week.length));
      put('active-count', String(groups.active.length)); put('completed-count', String(groups.completed.length));
      put('today-tasks', groups.today.map(e => taskMarkup(e, true)).join('') || emptyTasks('今天没有到期任务', '可以先准备本周安排，或记下一件想完成的事。'));
      put('week-tasks', groups.week.map(e => taskMarkup(e, true)).join('') || emptyTasks('本周余下时间暂无安排', '提前记下作业和计划，给自己留一点余量。'));
      const summary = document.getElementById('daily-summary');
      if (summary) summary.textContent = groups.today.length ? `今天有 ${groups.today.length} 件事待处理${groups.overdue.length ? `，其中 ${groups.overdue.length} 件已逾期` : ''}。完成一件，就少一件牵挂。` : '今天没有到期任务。按自己的节奏，开始新的积累。';
      const sunday = new Date(groups.nextMonday); sunday.setDate(sunday.getDate() - 1);
      const range = document.getElementById('week-range');
      if (range) range.textContent = `${groups.monday.getMonth() + 1}.${groups.monday.getDate()} — ${sunday.getMonth() + 1}.${sunday.getDate()}`;
      const visible = eventFilter === 'completed' ? groups.completed.sort((a, b) => Date.parse(b.completedAt!) - Date.parse(a.completedAt!)) : groups.active;
      put('events-list', visible.map(e => taskMarkup(e)).join('') || emptyTasks(eventFilter === 'completed' ? '还没有完成记录' : '所有待办都处理好了', eventFilter === 'completed' ? '勾选完成的任务会保存在这里。' : '新增一项任务，开始下一步。'));
      const title = document.getElementById('events-list-title'); if (title) title.textContent = eventFilter === 'completed' ? '已完成 · 可恢复' : '全部待办';
      document.querySelectorAll('[data-task-filter]').forEach(button => button.setAttribute('aria-pressed', String((button as HTMLElement).dataset.taskFilter === eventFilter)));
      renderQuadrantView(); lucide.createIcons();
    }
    function toggleTask(id: string) {
      const events: Task[] = load(KEYS.events); const task = events.find(e => e.id === id);
      if (!task) return;
      if (isCompleted(task)) delete task.completedAt; else task.completedAt = new Date().toISOString();
      save(KEYS.events, events); renderEvents();
    }

    function quadrantToFields(q: string): { importance: string; urgency: string } {
      if (q === 'q1') return { importance: 'high', urgency: 'high' };
      if (q === 'q2') return { importance: 'high', urgency: 'low' };
      if (q === 'q3') return { importance: 'low', urgency: 'high' };
      return { importance: 'low', urgency: 'low' };
    }

    function fieldsToQuadrant(importance: string, urgency: string): string {
      if (importance === 'high' && urgency === 'high') return 'q1';
      if (importance === 'high' && urgency === 'low') return 'q2';
      if (importance === 'low' && urgency === 'high') return 'q3';
      return 'q4';
    }

    function addEvent(data: { name: string; deadline: string; category: string; location?: string; importance?: string; urgency?: string }) {
      const events = load(KEYS.events);
      events.push({ id: generateId(), importance: 'low', urgency: 'low', ...data });
      save(KEYS.events, events);
      renderEvents();
    }

    async function deleteEvent(id: string) {
      if (!await requestConfirmation('永久删除这条任务？若只是做完了，请选择勾选完成。', '删除任务')) return;
      const events = load(KEYS.events).filter((e: any) => e.id !== id);
      save(KEYS.events, events);
      renderEvents();
    }

    function editEvent(id: string) {
      const events = load(KEYS.events);
      const event = events.find((e: any) => e.id === id);
      if (!event) return;
      const form = document.getElementById('form-event') as HTMLFormElement;
      if (!form) return;
      (form.querySelector('[name="editId"]') as HTMLInputElement).value = event.id;
      (form.querySelector('[name="name"]') as HTMLInputElement).value = event.name || '';
      (form.querySelector('[name="deadlineDate"]') as HTMLInputElement).value = event.deadline ? event.deadline.slice(0, 10) : '';
      (form.querySelector('[name="deadlineTime"]') as HTMLInputElement).value = event.deadline ? event.deadline.slice(11, 16) : '';
      (form.querySelector('[name="category"]') as HTMLSelectElement).value = event.category || '作业';
      (form.querySelector('[name="location"]') as HTMLInputElement).value = event.location || '';
      const qSelect = form.querySelector('[name="quadrant"]') as HTMLSelectElement;
      if (qSelect) qSelect.value = fieldsToQuadrant(event.importance || 'low', event.urgency || 'low');
      const titleEl = document.getElementById('modal-event-title');
      if (titleEl) titleEl.textContent = '编辑日程';
      openModal('modal-event');
    }

    function switchCalendarView(mode: string) {
      const listView = document.getElementById('calendar-list-view');
      const quadrantView = document.getElementById('quadrant-view');
      const btnList = document.getElementById('btn-view-list');
      const btnQuadrant = document.getElementById('btn-view-quadrant');
      if (listView && quadrantView) {
        if (mode === 'quadrant') {
          eventFilter = 'active';
          renderEvents();
          listView.classList.add('hidden');
          quadrantView.classList.remove('hidden');
          if (btnList) { btnList.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border t-border text-zinc-400 hover:text-zinc-200 t-hover-bg transition-colors'; }
          if (btnQuadrant) { btnQuadrant.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium t-accent-bg-soft border t-accent-border-soft t-accent-soft btn-hover transition-colors'; }
          renderQuadrantView();
        } else {
          listView.classList.remove('hidden');
          quadrantView.classList.add('hidden');
          if (btnList) { btnList.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium t-accent-bg-soft border t-accent-border-soft t-accent-soft btn-hover transition-colors'; }
          if (btnQuadrant) { btnQuadrant.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border t-border text-zinc-400 hover:text-zinc-200 t-hover-bg transition-colors'; }
        }
        localStorage.setItem('wd_calendar_view', mode);
      }
    }

    function renderQuadrantView() {
      const quadView = document.getElementById('quadrant-view');
      if (!quadView || quadView.classList.contains('hidden')) return;
      const events = load(KEYS.events).filter((e: Task) => !isCompleted(e));
      ['q1','q2','q3','q4'].forEach(q => {
        const container = document.getElementById('quadrant-' + q + '-items');
        if (!container) return;
        const quadEvents = events.filter((e: any) => {
          return fieldsToQuadrant(e.importance || 'low', e.urgency || 'low') === q;
        });
        quadEvents.sort((a: any, b: any) => new Date(a.deadline).getTime() - new Date(b.deadline).getTime());
        if (quadEvents.length === 0) {
          container.innerHTML = '<p class="text-[11px] text-zinc-600 text-center py-4">拖拽日程到此处</p>';
        } else {
          container.innerHTML = quadEvents.map((e: any) => {
            const cd = formatCountdown(e.deadline);
            const d = new Date(e.deadline);
            const dateStr = `${d.getMonth() + 1}月${d.getDate()}日`;
            const timeStr = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
            return `
              <div class="quadrant-event t-bg-input rounded-lg p-2.5 cursor-grab active:cursor-grabbing group" draggable="true" ondragstart="handleDragStart(event, '${escapeHtml(e.id)}')" data-event-id="${escapeHtml(e.id)}">
                <div class="flex items-center gap-1.5">
                  <i data-lucide="grip-vertical" class="w-3 h-3 text-zinc-600 flex-shrink-0"></i>
                  <span class="text-xs text-zinc-300 truncate flex-1 font-medium">${escapeHtml(e.name)}</span>
                  <span class="text-[9px] px-1 py-0.5 rounded font-medium flex-shrink-0 ${CATEGORY_COLORS[e.category] || 'text-zinc-500'}">${escapeHtml(e.category)}</span>
                </div>
                <div class="flex items-center justify-between mt-1.5">
                  <span class="text-[10px] text-zinc-500 font-mono">${dateStr} ${timeStr}</span>
                  <span class="font-mono text-[10px] ${cd.expired ? 'text-rose-500/60' : 'text-zinc-500'}">${cd.text}</span>
                </div>
                <div class="flex items-center justify-end gap-1.5 mt-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                  <button class="icon-action" data-task-action="toggle" data-task-id="${escapeHtml(e.id)}" aria-label="完成任务"><i data-lucide="check"></i></button>
                  <button aria-label="编辑任务" onclick="event.stopPropagation();editEvent('${escapeHtml(e.id)}')" class="icon-action text-zinc-600 t-hover-accent transition-colors p-0.5">
                    <i data-lucide="pencil" class="w-3 h-3"></i>
                  </button>
                  <button aria-label="删除任务" onclick="event.stopPropagation();deleteEvent('${escapeHtml(e.id)}')" class="icon-action text-zinc-600 hover:text-rose-500/60 transition-colors p-0.5">
                    <i data-lucide="trash-2" class="w-3 h-3"></i>
                  </button>
                </div>
              </div>`;
          }).join('');
        }
      });
      lucide.createIcons();
    }

    let dragEventId: string | null = null;

    function handleDragStart(e: DragEvent, eventId: string) {
      dragEventId = eventId;
      if (e.dataTransfer) {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', eventId);
      }
    }

    function handleDragOver(e: DragEvent) {
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      const target = e.currentTarget as HTMLElement;
      if (target) target.classList.add('ring-1', 't-ring-accent');
    }

    function handleDragLeave(e: DragEvent) {
      const target = e.currentTarget as HTMLElement;
      if (target) target.classList.remove('ring-1', 't-ring-accent');
    }

    function handleDrop(e: DragEvent, quadrant: string) {
      e.preventDefault();
      const target = e.currentTarget as HTMLElement;
      if (target) target.classList.remove('ring-1', 't-ring-accent');
      const id = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || dragEventId;
      if (!id) return;
      const events = load(KEYS.events);
      const idx = events.findIndex((ev: any) => ev.id === id);
      if (idx === -1) return;
      const fields = quadrantToFields(quadrant);
      events[idx].importance = fields.importance;
      events[idx].urgency = fields.urgency;
      save(KEYS.events, events);
      renderEvents();
      dragEventId = null;
    }

    (window as any).switchCalendarView = switchCalendarView;
    (window as any).handleDragStart = handleDragStart;
    (window as any).handleDragOver = handleDragOver;
    (window as any).handleDragLeave = handleDragLeave;
    (window as any).handleDrop = handleDrop;
    (window as any).deleteEvent = deleteEvent;
    (window as any).editEvent = editEvent;

    // ============================================================
    // QUICK LINKS RENDERING
    // ============================================================
    function renderQuickLinks() {
      const links = load(KEYS.quickLinks);
      const container = document.getElementById('quick-links');
      if (!container) return;
      if (links.length === 0) {
        container.innerHTML = '<p class="text-sm text-zinc-600 col-span-2">暂无链接</p>';
        return;
      }
      container.innerHTML = links.map((l: any, i: number) => `
        <a href="${escapeHtml(l.url)}" target="_blank" rel="noopener"
          class="flex items-center justify-between p-3 t-bg-input border t-border rounded-lg card-hover group no-underline">
          <span class="text-sm text-zinc-300 group-hover:text-zinc-200 truncate">${escapeHtml(l.name)}</span>
          <button aria-label="移除快速链接" onclick="event.preventDefault();removeQuickLink(${i})" class="text-zinc-700 hover:text-rose-500/60 transition-colors opacity-0 group-hover:opacity-100 flex-shrink-0 ml-2">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </a>
      `).join('');
      lucide.createIcons();
    }

    function removeQuickLink(index: number) {
      const links = load(KEYS.quickLinks);
      links.splice(index, 1);
      save(KEYS.quickLinks, links);
      renderQuickLinks();
    }

    (window as any).removeQuickLink = removeQuickLink;

    // ============================================================
    // COURSES RENDERING
    // ============================================================
    function migrateCourses() {
      const courses = load(KEYS.courses);
      let changed = false;
      for (const c of courses) {
        if (!Array.isArray(c.components)) {
          c.components = [];
          if (typeof c.midtermWeight === 'number' && c.midtermWeight > 0) {
            c.components.push({ name: '平时', weight: c.midtermWeight });
          }
          if (typeof c.finalWeight === 'number' && c.finalWeight > 0) {
            c.components.push({ name: '期末', weight: c.finalWeight });
          }
          delete c.midtermWeight;
          delete c.finalWeight;
          changed = true;
        }
      }
      if (changed) save(KEYS.courses, courses);
    }

    function addComponentRow(name: string = '', weight: number = 0) {
      const container = document.getElementById('components-container');
      if (!container) return;
      const empty = document.getElementById('components-empty');
      if (empty) empty.style.display = 'none';

      const row = document.createElement('div');
      row.className = 'component-row flex items-center gap-2';
      row.innerHTML =
        `<input type="text" name="compName" value="${escapeHtml(name)}" placeholder="例如：平时作业"
          class="flex-1 t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder-zinc-600 focus:outline-none t-accent-ring transition-colors" />
        <input type="number" name="compWeight" min="0" max="100" value="${weight || ''}" placeholder="0"
          class="w-16 t-bg-input border t-border rounded-lg px-2 py-2 text-sm text-zinc-200 text-center focus:outline-none t-accent-ring transition-colors" />
        <span class="text-xs text-zinc-500 flex-shrink-0">%</span>
        <button type="button" class="btn-remove-component text-zinc-600 hover:text-rose-500/60 transition-colors p-1 flex-shrink-0"
          onclick="removeComponentRow(this)">
          <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>`;
      container.appendChild(row);
      lucide.createIcons();
    }

    function removeComponentRow(btn: HTMLElement) {
      const row = btn.closest('.component-row');
      if (row) row.remove();
      const container = document.getElementById('components-container');
      const empty = document.getElementById('components-empty');
      if (container && empty && container.querySelectorAll('.component-row').length === 0) {
        empty.style.display = '';
      }
      updateWeightTotal();
    }

    function clearComponentRows() {
      const container = document.getElementById('components-container');
      if (!container) return;
      container.querySelectorAll('.component-row').forEach(r => r.remove());
      const empty = document.getElementById('components-empty');
      if (empty) empty.style.display = '';
    }

    function updateWeightTotal() {
      const container = document.getElementById('components-container');
      const totalEl = document.getElementById('weight-total');
      if (!container || !totalEl) return;
      let total = 0;
      container.querySelectorAll('[name="compWeight"]').forEach(inp => {
        total += parseInt((inp as HTMLInputElement).value) || 0;
      });
      totalEl.textContent = `合计: ${total}%`;
      if (total === 100) {
        totalEl.className = 'text-[10px] text-emerald-500';
      } else if (total > 0) {
        totalEl.className = 'text-[10px] text-amber-500';
      } else {
        totalEl.className = 'text-[10px] text-zinc-500';
      }
    }

    (window as any).removeComponentRow = removeComponentRow;
    function renderCourses() {
      const courses = load(KEYS.courses);
      courses.sort((a: any, b: any) => (b.credits || 0) - (a.credits || 0));
      const container = document.getElementById('courses-grid');
      if (!container) return;
      if (courses.length === 0) {
        container.innerHTML = '<p class="text-sm text-zinc-600">暂无课程</p>';
        return;
      }
      container.innerHTML = courses.map((c: any) => {
        let deadlinesHtml = '';
        if (c.projectName && c.projectDeadline) {
          const cd = formatCountdown(c.projectDeadline);
          deadlinesHtml += `
            <div class="flex items-center justify-between mt-1">
              <span class="text-xs text-zinc-500 truncate">${escapeHtml(c.projectName)}</span>
              <span class="font-mono text-xs ${cd.expired ? 'text-rose-500/60' : 'text-zinc-400'} flex-shrink-0 ml-2">${cd.text}</span>
            </div>`;
        }
        if (c.finalExamDeadline) {
          const cd = formatCountdown(c.finalExamDeadline);
          const d = new Date(c.finalExamDeadline);
          const dateStr = `${d.getMonth() + 1}月${d.getDate()}日`;
          const timeStr = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
          const locStr = c.finalExamLocation ? `<span class="text-zinc-600 mx-1">${escapeHtml(c.finalExamLocation)}</span>` : '';
          deadlinesHtml += `
            <div class="flex items-center justify-between mt-1">
              <span class="text-xs text-zinc-500 truncate">期末考试 <span class="font-mono text-zinc-500">${dateStr} ${timeStr}</span>${locStr}</span>
              <span class="font-mono text-xs ${cd.expired ? 'text-rose-500/60' : 'text-zinc-400'} flex-shrink-0 ml-2">${cd.text}</span>
            </div>`;
        }
        if (deadlinesHtml) {
          deadlinesHtml = `<div class="mt-3 pt-3 border-t t-border-sub">${deadlinesHtml}</div>`;
        }
        return `
          <div class="t-bg-card card-gradient border t-border rounded-xl p-5 card-hover group relative">
            <div class="absolute top-3 right-3 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              <button aria-label="编辑课程" onclick="editCourse('${escapeHtml(c.id)}')" class="icon-action text-zinc-600 t-hover-accent transition-colors p-0.5">
                <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
              </button>
              <button aria-label="删除课程" onclick="deleteCourse('${escapeHtml(c.id)}')" class="icon-action text-zinc-600 hover:text-rose-500/60 transition-colors p-0.5">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              </button>
            </div>
            <h4 class="text-sm font-medium text-zinc-200 mb-3 pr-6 truncate">${escapeHtml(c.name)}</h4>
            <div class="flex items-center gap-4 text-xs text-zinc-500 mb-2">
              <span>${c.credits} 学分</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-1">
              ${(c.components || []).map((comp: any) =>
                `<span class="text-[10px] px-1.5 py-0.5 rounded t-bg-input text-zinc-400 border t-border">${escapeHtml(comp.name)} ${comp.weight}%</span>`
              ).join('') || '<span class="text-xs text-zinc-500">成绩构成待公布</span>'}
            </div>
            ${deadlinesHtml}
          </div>`;
      }).join('');
      lucide.createIcons();
    }

    function addCourse(data: any) {
      const courses = load(KEYS.courses);
      const course = { id: generateId(), ...data };
      courses.push(course);
      save(KEYS.courses, courses);

      const events = load(KEYS.events);
      if (data.projectName && data.projectDeadline) {
        events.push({
          id: generateId(),
          name: `${data.name} · ${data.projectName}`,
          deadline: data.projectDeadline,
          category: 'pre',
        });
      }
      if (data.finalExamDeadline) {
        events.push({
          id: generateId(),
          name: `${data.name} · 期末考试`,
          deadline: data.finalExamDeadline,
          category: '考试',
        });
      }
      save(KEYS.events, events);
      renderEvents();
      renderCourses();
    }

    function deleteCourse(id: string) {
      const courses = load(KEYS.courses).filter((c: any) => c.id !== id);
      save(KEYS.courses, courses);
      renderCourses();
    }

    function editCourse(id: string) {
      const courses = load(KEYS.courses);
      const course = courses.find((c: any) => c.id === id);
      if (!course) return;
      const form = document.getElementById('form-course') as HTMLFormElement;
      if (!form) return;
      (form.querySelector('[name="editId"]') as HTMLInputElement).value = course.id;
      (form.querySelector('[name="name"]') as HTMLInputElement).value = course.name || '';
      (form.querySelector('[name="credits"]') as HTMLInputElement).value = String(course.credits ?? 3);
      (form.querySelector('[name="projectName"]') as HTMLInputElement).value = course.projectName || '';
      (form.querySelector('[name="projectDeadlineDate"]') as HTMLInputElement).value = course.projectDeadline ? course.projectDeadline.slice(0, 10) : '';
      (form.querySelector('[name="projectDeadlineTime"]') as HTMLInputElement).value = course.projectDeadline ? course.projectDeadline.slice(11, 16) : '';
      (form.querySelector('[name="finalExamDeadlineDate"]') as HTMLInputElement).value = course.finalExamDeadline ? course.finalExamDeadline.slice(0, 10) : '';
      (form.querySelector('[name="finalExamDeadlineTime"]') as HTMLInputElement).value = course.finalExamDeadline ? course.finalExamDeadline.slice(11, 16) : '';
      (form.querySelector('[name="finalExamLocation"]') as HTMLInputElement).value = course.finalExamLocation || '';

      clearComponentRows();
      const comps = course.components || [];
      if (comps.length > 0) {
        comps.forEach((c: any) => addComponentRow(c.name, c.weight));
      } else {
        addComponentRow('', 0);
        addComponentRow('', 0);
      }
      updateWeightTotal();

      const titleEl = document.getElementById('modal-course-title');
      if (titleEl) titleEl.textContent = '编辑课程';
      openModal('modal-course');
    }

    (window as any).deleteCourse = deleteCourse;
    (window as any).editCourse = editCourse;

    // ============================================================
    // GPA CALCULATOR
    // ============================================================
    function loadGrades() {
      try { return JSON.parse(localStorage.getItem(KEYS.grades) || '{}'); }
      catch { return {}; }
    }

    function saveGrades(data: any) {
      localStorage.setItem(KEYS.grades, JSON.stringify(data));
    }

    function getGpaMode(): string {
      const grades = loadGrades();
      return grades.mode || 'five';
    }

    function switchGpaMode(mode: string) {
      const grades = loadGrades();
      grades.mode = mode;
      saveGrades(grades);

      const btnFive = document.getElementById('btn-gpa-five');
      const btnHundred = document.getElementById('btn-gpa-hundred');
      if (btnFive && btnHundred) {
        if (mode === 'five') {
          btnFive.className = 'px-3 py-1.5 rounded-md text-xs font-medium t-accent-bg-soft border t-accent-border-soft t-accent-soft btn-hover transition-colors';
          btnHundred.className = 'px-3 py-1.5 rounded-md text-xs font-medium border border-transparent text-zinc-400 hover:text-zinc-200 btn-hover transition-colors';
        } else {
          btnFive.className = 'px-3 py-1.5 rounded-md text-xs font-medium border border-transparent text-zinc-400 hover:text-zinc-200 btn-hover transition-colors';
          btnHundred.className = 'px-3 py-1.5 rounded-md text-xs font-medium t-accent-bg-soft border t-accent-border-soft t-accent-soft btn-hover transition-colors';
        }
      }

      const labelEl = document.getElementById('gpa-label');
      if (labelEl) labelEl.textContent = mode === 'five' ? '5分制 GPA' : '百分制 GPA';

      renderGpaCourses();
      updateGpaResult();
    }

    function setGpaGrade(courseId: string, grade: string) {
      const grades = loadGrades();
      if (!grades.grades) grades.grades = {};
      if (grade === '') {
        delete grades.grades[courseId];
      } else {
        grades.grades[courseId] = grade;
      }
      saveGrades(grades);
      updateGpaResult();
    }

    function updateGpaResult() {
      const courses = load(KEYS.courses);
      const grades = loadGrades();
      const gradeEntries = grades.grades || {};
      const mode = grades.mode || 'five';

      let totalWeighted = 0;
      let totalCredits = 0;

      for (const c of courses) {
        const g = gradeEntries[c.id];
        if (!g) continue;
        const credits = c.credits || 0;

        if (mode === 'five') {
          const info = GRADE_MAP[g];
          if (info) {
            totalWeighted += info.gpa * credits;
            totalCredits += credits;
          }
        } else {
          const pct = parseFloat(g);
          if (!isNaN(pct)) {
            const gradeKey = percentToGrade(pct);
            const info = GRADE_MAP[gradeKey];
            if (info) {
              totalWeighted += info.convert * credits;
              totalCredits += credits;
            }
          }
        }
      }

      const gpaValue = document.getElementById('gpa-value');
      const countEl = document.getElementById('gpa-course-count');
      const totalCreditsEl = document.getElementById('gpa-total-credits');
      if (gpaValue) {
        gpaValue.textContent = totalCredits > 0 ? (totalWeighted / totalCredits).toFixed(2) : '--';
      }
      if (countEl) {
        const count = Object.keys(gradeEntries).filter(id => courses.some((c: any) => c.id === id)).length;
        countEl.textContent = String(count);
      }
      if (totalCreditsEl) {
        totalCreditsEl.textContent = String(totalCredits);
      }
    }

    function renderGpaCourses() {
      const container = document.getElementById('gpa-courses');
      if (!container) return;

      const courses = load(KEYS.courses);
      if (courses.length === 0) {
        container.innerHTML = '<p class="text-sm text-zinc-600">请在"课程管理"中先注册课程</p>';
