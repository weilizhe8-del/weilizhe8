    async function checkBackendStatus() {
      const dot = document.getElementById('backend-status-dot');
      const text = document.getElementById('backend-status-text');
      try {
        const resp = await fetch(`${VIDEO_DL_BACKEND}/api/health`, { signal: AbortSignal.timeout(5000) });
        if (resp.ok) {
          if (dot) { dot.className = 'w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0'; dot.style.boxShadow = '0 0 6px rgba(52,211,153,0.4)'; }
          if (text) text.textContent = '服务正常';
        } else {
          if (dot) dot.className = 'w-2 h-2 rounded-full bg-amber-500 flex-shrink-0';
          if (text) text.textContent = '服务异常';
        }
      } catch {
        if (dot) dot.className = 'w-2 h-2 rounded-full bg-rose-500 flex-shrink-0';
        if (text) text.textContent = '服务不可达';
      }
    }

    function parseVideo() {
      const input = document.getElementById('video-url-input') as HTMLInputElement;
      const url = input?.value?.trim();
      if (!url) return;

      const btnParse = document.getElementById('btn-parse-video') as HTMLButtonElement;
      const btnText = document.getElementById('btn-parse-text');
      const btnSpinner = document.getElementById('btn-parse-spinner');
      const errorEl = document.getElementById('video-error');

      if (btnParse) btnParse.disabled = true;
      if (btnText) btnText.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      if (errorEl) errorEl.classList.add('hidden');

      fetch(`${VIDEO_DL_BACKEND}/api/info`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url, cookie: getStoredCookie() }),
        signal: AbortSignal.timeout(30000),
      })
        .then(async resp => {
          const data = await resp.json();
          if (!resp.ok) throw new Error(data.detail || '解析失败');
          showVideoInfo(data);
        })
        .catch(err => {
          const errorContainer = document.getElementById('video-error-container');
          if (errorEl) {
            errorEl.textContent = err.message || '解析失败，请检查链接是否有效';
            errorEl.classList.remove('hidden');
          }
          if (errorContainer) errorContainer.classList.remove('hidden');
          document.getElementById('video-info-panel')?.classList.add('hidden');
        })
        .finally(() => {
          if (btnParse) btnParse.disabled = false;
          if (btnText) btnText.classList.remove('hidden');
          if (btnSpinner) btnSpinner.classList.add('hidden');
        });
    }

    function showVideoInfo(data: any) {
      const panel = document.getElementById('video-info-panel');
      if (panel) panel.classList.remove('hidden');

      const titleEl = document.getElementById('video-title');
      const uploaderEl = document.getElementById('video-uploader');
      const durationEl = document.getElementById('video-duration');
      const thumbEl = document.getElementById('video-thumbnail') as HTMLImageElement;
      const formatsContainer = document.getElementById('format-options');

      if (titleEl) titleEl.textContent = data.title;
      if (uploaderEl) uploaderEl.textContent = data.uploader;
      if (durationEl) {
        const mins = Math.floor((data.duration || 0) / 60);
        const secs = (data.duration || 0) % 60;
        durationEl.textContent = `${mins}:${String(secs).padStart(2, '0')}`;
      }
      if (thumbEl) {
        thumbEl.src = data.thumbnail;
        thumbEl.style.display = data.thumbnail ? '' : 'none';
      }

      videoFormats = data.formats || [];
      selectedFormatId = null;
      currentVideoUrl = data.webpage_url || '';

      if (formatsContainer) {
        if (videoFormats.length === 0) {
          formatsContainer.innerHTML = '<span class="text-xs text-zinc-500">暂无可下载的清晰度</span>';
        } else {
          const displayFormats = videoFormats.slice(0, 8);
          selectedFormatId = displayFormats[0].format_id;

          formatsContainer.innerHTML = displayFormats.map((f: any, i: number) => {
            const sizeText = f.filesize_mb ? `${f.filesize_mb}MB` : '未知大小';
            const isSelected = i === 0;
            return `
              <button onclick="selectFormat('${f.format_id}', this)"
                class="format-btn px-4 py-2 rounded-lg text-xs font-medium border transition-all
                ${isSelected ? 't-accent-bg-soft border t-accent-border-soft t-accent-soft' : 't-bg-input t-border text-zinc-400 hover:text-zinc-200 hover:border-zinc-600'}"
                data-format-id="${f.format_id}">
                <span class="block">${f.resolution}</span>
                <span class="text-[10px] text-zinc-500">${sizeText}</span>
              </button>`;
          }).join('');
        }
      }

      const btnDl = document.getElementById('btn-download-video') as HTMLButtonElement;
      if (btnDl) btnDl.disabled = false;
      const btnDlText = document.getElementById('btn-dl-text');
      if (btnDlText) { btnDlText.classList.remove('hidden'); btnDlText.textContent = '下载视频'; }
      const btnDlSpinner = document.getElementById('btn-dl-spinner');
      if (btnDlSpinner) btnDlSpinner.classList.add('hidden');
      const errorEl = document.getElementById('video-error');
      if (errorEl) errorEl.classList.add('hidden');
      const errorContainer = document.getElementById('video-error-container');
      if (errorContainer) errorContainer.classList.add('hidden');
    }

    function selectFormat(formatId: string, el: HTMLElement) {
      selectedFormatId = formatId;
      document.querySelectorAll('.format-btn').forEach(btn => {
        btn.className = 'format-btn px-4 py-2 rounded-lg text-xs font-medium border transition-all t-bg-input t-border text-zinc-400 hover:text-zinc-200 hover:border-zinc-600';
      });
      el.className = 'format-btn px-4 py-2 rounded-lg text-xs font-medium border transition-all t-accent-bg-soft border t-accent-border-soft t-accent-soft';
    }

    function downloadVideo() {
      if (!selectedFormatId || !currentVideoUrl) return;

      const btnDl = document.getElementById('btn-download-video') as HTMLButtonElement;
      const btnText = document.getElementById('btn-dl-text');
      const btnSpinner = document.getElementById('btn-dl-spinner');
      const errorEl = document.getElementById('video-error');

      if (btnDl) btnDl.disabled = true;
      if (btnText) btnText.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      if (errorEl) errorEl.classList.add('hidden');

      fetch(`${VIDEO_DL_BACKEND}/api/download`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: currentVideoUrl, format_id: selectedFormatId, cookie: getStoredCookie() }),
        signal: AbortSignal.timeout(30000),
      })
        .then(async resp => {
          const data = await resp.json();
          if (!resp.ok) throw new Error(data.detail || '获取下载链接失败');

          if (data.is_composite) {
            const urls = String(data.download_url).split('+').filter(Boolean);
            urls.forEach(u => window.open(u, '_blank'));
          } else {
            window.open(data.download_url, '_blank');
          }
        })
        .catch(err => {
          const errorContainer = document.getElementById('video-error-container');
          if (errorEl) {
            errorEl.textContent = err.message || '获取下载链接失败，请稍后重试';
            errorEl.classList.remove('hidden');
          }
          if (errorContainer) errorContainer.classList.remove('hidden');
        })
        .finally(() => {
          if (btnDl) btnDl.disabled = false;
          if (btnText) btnText.classList.remove('hidden');
          if (btnSpinner) btnSpinner.classList.add('hidden');
        });
    }

    (window as any).parseVideo = parseVideo;
    (window as any).downloadVideo = downloadVideo;
    (window as any).selectFormat = selectFormat;

    // ============================================================
    // COUNTDOWN TICKER (update all rendered countdowns)
    // ============================================================
    function tickCountdowns() {
      renderEvents();
      renderCourses();
    }

    // ============================================================
    // EVENT LISTENERS SETUP
    // ============================================================
    function setupListeners() {
      // Sidebar tab switching
      document.querySelectorAll('.sidebar-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = (btn as HTMLElement).dataset.tab;
          if (tab) switchTab(tab);
        });
      });

      // Modal backdrop click to close
      document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', () => {
          const modalId = (overlay as HTMLElement).dataset.close;
          if (modalId) closeModal(modalId);
        });
      });

      // Modal cancel buttons
      document.querySelectorAll('[data-close]').forEach(el => {
        if (el.classList.contains('modal-overlay')) return;
        el.addEventListener('click', () => {
          const modalId = (el as HTMLElement).dataset.close;
          if (modalId) closeModal(modalId);
        });
      });

      // Escape key to close all modals
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllModals();
        if (e.key === 'Tab') {
          const modal = document.querySelector('[role="dialog"]:not(.hidden)');
          if (modal) {
            const focusable = Array.from(modal.querySelectorAll<HTMLElement>('button,input:not([type="hidden"]),select,textarea,a[href]')).filter(el => !el.hasAttribute('disabled'));
            const first = focusable[0], last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
          }
        }
      });

      // Inline event form (calendar tab)
      const formEventInline = document.getElementById('form-event-inline') as HTMLFormElement;
      if (formEventInline) {
        formEventInline.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formEventInline);
          const date = fd.get('deadlineDate') as string;
          const time = fd.get('deadlineTime') as string;
          const quadrant = fd.get('quadrant') as string;
          const fields = quadrantToFields(quadrant || 'q4');
          addEvent({
            name: fd.get('name') as string,
            deadline: `${date}T${time}`,
            category: fd.get('category') as string,
            location: fd.get('location') as string,
            importance: fields.importance,
            urgency: fields.urgency,
          });
          formEventInline.reset();
          (formEventInline.querySelector('[name="quadrant"]') as HTMLSelectElement).value = 'q4';
        });
      }

      // Modal event form
      const formEvent = document.getElementById('form-event') as HTMLFormElement;
      if (formEvent) {
        formEvent.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formEvent);
          const editId = (fd.get('editId') as string)?.trim();
          const date = fd.get('deadlineDate') as string;
          const time = fd.get('deadlineTime') as string;
          const quadrant = fd.get('quadrant') as string;
          const fields = quadrantToFields(quadrant || 'q4');
          const data = {
            name: fd.get('name') as string,
            deadline: `${date}T${time}`,
            category: fd.get('category') as string,
            location: fd.get('location') as string,
            importance: fields.importance,
            urgency: fields.urgency,
          };

          if (editId) {
            const events = load(KEYS.events);
            const idx = events.findIndex((ev: any) => ev.id === editId);
            if (idx !== -1) {
              events[idx] = { ...events[idx], ...data };
              save(KEYS.events, events);
              renderEvents();
            }
          } else {
            addEvent(data);
          }
          closeModal('modal-event');
        });
      }

      // Modal course form
      const formCourse = document.getElementById('form-course') as HTMLFormElement;
      if (formCourse) {
        formCourse.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formCourse);
          const editId = (fd.get('editId') as string)?.trim();

          const components: {name: string, weight: number}[] = [];
          document.querySelectorAll('#components-container .component-row').forEach(row => {
            const nameInput = row.querySelector('[name="compName"]') as HTMLInputElement;
            const weightInput = row.querySelector('[name="compWeight"]') as HTMLInputElement;
            const name = nameInput?.value?.trim();
            const weight = parseInt(weightInput?.value) || 0;
            if (name && weight > 0) {
              components.push({ name, weight });
            }
          });

          const pdDate = fd.get('projectDeadlineDate') as string;
          const pdTime = fd.get('projectDeadlineTime') as string;
          const feDate = fd.get('finalExamDeadlineDate') as string;
          const feTime = fd.get('finalExamDeadlineTime') as string;

          const data: any = {
            name: fd.get('name') as string,
            credits: parseInt(fd.get('credits') as string) || 3,
            components,
            projectName: fd.get('projectName') as string,
            projectDeadline: (pdDate && pdTime) ? `${pdDate}T${pdTime}` : '',
            finalExamDeadline: (feDate && feTime) ? `${feDate}T${feTime}` : '',
            finalExamLocation: fd.get('finalExamLocation') as string,
          };

          if (editId) {
            // Edit existing course
            const courses = load(KEYS.courses);
            const oldCourse = courses.find((c: any) => c.id === editId);
            const idx = courses.findIndex((c: any) => c.id === editId);
            if (idx !== -1) {
              courses[idx] = { ...courses[idx], ...data };
              save(KEYS.courses, courses);

              // Remove old linked DDLs
              let events = load(KEYS.events);
              if (oldCourse && oldCourse.projectName && oldCourse.projectDeadline) {
                const oldName = `${oldCourse.name} · ${oldCourse.projectName}`;
                events = events.filter((ev: any) =>
                  !(ev.name === oldName && ev.deadline === oldCourse.projectDeadline)
                );
              }
              if (oldCourse && oldCourse.finalExamDeadline) {
                const oldName = `${oldCourse.name} · 期末考试`;
                events = events.filter((ev: any) =>
                  !(ev.name === oldName && ev.deadline === oldCourse.finalExamDeadline)
                );
              }
              save(KEYS.events, events);

              // Create new linked DDLs
              if (data.projectName && data.projectDeadline) {
                events.push({
                  id: generateId(),
                  name: `${data.name} · ${data.projectName}`,
                  deadline: data.projectDeadline,
                  category: 'pre',
                });
              }
              if (data.finalExamDeadline) {
                events.push({
                  id: generateId(),
                  name: `${data.name} · 期末考试`,
                  deadline: data.finalExamDeadline,
                  category: '考试',
                });
              }
              save(KEYS.events, events);
              renderEvents();
            }
          } else {
            addCourse(data);
          }

          closeModal('modal-course');
        });
      }

      // Modal quick link form
      const formQuickLink = document.getElementById('form-quicklink') as HTMLFormElement;
      if (formQuickLink) {
        formQuickLink.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formQuickLink);
          const links = load(KEYS.quickLinks);
          links.push({
            name: fd.get('name') as string,
            url: fd.get('url') as string,
          });
          save(KEYS.quickLinks, links);
          renderQuickLinks();
          closeModal('modal-quicklink');
        });
      }

      // Add component button
      const btnAddComp = document.getElementById('btn-add-component');
      if (btnAddComp) {
        btnAddComp.addEventListener('click', () => {
          addComponentRow();
          updateWeightTotal();
        });
      }

      // Live weight total update
      const compContainer = document.getElementById('components-container');
      if (compContainer) {
        compContainer.addEventListener('input', (e) => {
          if ((e.target as HTMLElement).getAttribute('name') === 'compWeight') {
            updateWeightTotal();
          }
        });
      }

      // Modal tool form
      const formTool = document.getElementById('form-tool') as HTMLFormElement;
      if (formTool) {
        formTool.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formTool);
          addToolLink({
            name: fd.get('name') as string,
            url: fd.get('url') as string,
            category: fd.get('category') as string,
          });
          closeModal('modal-tool');
        });
      }
    }

    // Expose to global scope for inline onclick handlers
    (window as any).openModal = openModal;

    // ============================================================
    // INIT
    // ============================================================
    function syncCourseEvents() {
      const courses = load(KEYS.courses);
      const events = load(KEYS.events);
      let changed = false;
      courses.forEach((c: any) => {
        if (c.projectName && c.projectDeadline) {
          const evName = `${c.name} · ${c.projectName}`;
          if (!events.some((ev: any) => ev.name === evName)) {
            events.push({ id: generateId(), name: evName, deadline: c.projectDeadline, category: 'pre' });
            changed = true;
          }
        }
        if (c.finalExamDeadline) {
          const evName = `${c.name} · 期末考试`;
          if (!events.some((ev: any) => ev.name === evName)) {
            events.push({ id: generateId(), name: evName, deadline: c.finalExamDeadline, category: '考试', location: c.finalExamLocation || '' });
            changed = true;
          }
        }
      });
      if (changed) save(KEYS.events, events);
    }

    function setupDeskInteractions() {
      document.addEventListener('click', event => {
        const target = (event.target as Element).closest<HTMLElement>('button');
        if (!target) return;
        if (target.hasAttribute('data-new-task')) {
          closeModal('modal-event');
          openModal('modal-event');
          const form = document.getElementById('form-event') as HTMLFormElement;
          const now = new Date();
          (form.elements.namedItem('deadlineDate') as HTMLInputElement).value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
          (form.elements.namedItem('deadlineTime') as HTMLInputElement).value = '23:59';
          (form.elements.namedItem('name') as HTMLInputElement).focus();
        }
        if (target.dataset.goTab) switchTab(target.dataset.goTab);
        if (target.dataset.taskFilter) {
          eventFilter = target.dataset.taskFilter === 'completed' ? 'completed' : 'active';
          if (eventFilter === 'completed') switchCalendarView('list');
          renderEvents();
        }
        const id = target.dataset.taskId;
        if (id) {
          if (target.dataset.taskAction === 'toggle') toggleTask(id);
          if (target.dataset.taskAction === 'edit') editEvent(id);
          if (target.dataset.taskAction === 'delete') deleteEvent(id);
        }
      });
      const menu = document.getElementById('mobile-menu');
      menu?.addEventListener('click', () => { const open = document.body.classList.toggle('nav-open'); menu.setAttribute('aria-expanded', String(open)); });
      document.getElementById('nav-backdrop')?.addEventListener('click', () => { document.body.classList.remove('nav-open'); menu?.setAttribute('aria-expanded', 'false'); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') { document.body.classList.remove('nav-open'); menu?.setAttribute('aria-expanded', 'false'); } });
      document.querySelectorAll('input[type="time"]').forEach(input => input.setAttribute('aria-label', '截止时刻'));
      // Associate the existing visible labels with their fields.
      document.querySelectorAll('form label').forEach((label, i) => {
        const input = label.parentElement?.querySelector('input,select,textarea');
        if (input) { if (!input.id) input.id = `field-${i}`; label.setAttribute('for', input.id); }
      });
      window.addEventListener('storage', e => { if (e.key?.startsWith('wd_')) { renderEvents(); renderCourses(); } });
    }

    function init() {
      initDemoDataIfEmpty();
      migrateCourses();
      syncCourseEvents();
      checkBackendStatus();
      updateCookieStatus();
      setupListeners();
      setupBackup(() => { renderEvents(); renderCourses(); renderGpa(); renderQuickLinks(); renderToolLinks(); renderWheel(); });
      setupDeskInteractions();
      updateClock();
      renderSemesterProgress();
      renderEvents();
      renderQuickLinks();
      renderCourses();
      renderToolLinks();
      const savedView = localStorage.getItem('wd_calendar_view');
      if (savedView === 'quadrant') switchCalendarView('quadrant');

      setInterval(updateClock, 1000);
      setInterval(tickCountdowns, 30000);
      setInterval(renderSemesterProgress, 60000);
    }

    // Wait for DOM and Lucide
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Layout>
