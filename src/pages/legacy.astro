    // ============================================================
    // CLOCK
    // ============================================================
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('clock');
      const dateEl = document.getElementById('current-date');
      if (el) el.textContent = now.toLocaleTimeString('zh-CN', { hour12: false });
      if (dateEl) {
        dateEl.textContent = now.toLocaleDateString('zh-CN', {
          year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short',
        });
      }
    }

    // ============================================================
    // COUNTDOWN FORMATTER
    // ============================================================
    function formatCountdown(deadline: string): { text: string; expired: boolean } {
      const diff = new Date(deadline).getTime() - Date.now();
      if (diff <= 0) return { text: '已到期', expired: true };
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      if (d > 0) return { text: `${d}<span class="text-zinc-500 mx-0.5">天</span>${h}<span class="text-zinc-500 mx-0.5">小时</span>`, expired: false };
      if (h > 0) return { text: `${h}<span class="text-zinc-500 mx-0.5">小时</span>${m}<span class="text-zinc-500 mx-0.5">分钟</span>`, expired: false };
      return { text: `${m}<span class="text-zinc-500 mx-0.5">分钟</span>`, expired: false };
    }

    // ============================================================
    // TAB SWITCHING
    // ============================================================
    function switchTab(tab: string) {
      document.querySelectorAll('.sidebar-btn').forEach(btn => {
        const isActive = (btn as HTMLElement).dataset.tab === tab;
        btn.classList.toggle('active', isActive);
        if (isActive) btn.setAttribute('aria-current', 'page'); else btn.removeAttribute('aria-current');
        const badge = (btn as HTMLElement).querySelector('span.font-mono') as HTMLElement;
        if (isActive) {
          (btn as HTMLElement).style.color = 'var(--text-primary)';
          (btn as HTMLElement).style.background = 'linear-gradient(135deg, var(--bg-card-hover) 0%, var(--bg-card) 100%)';
          (btn as HTMLElement).style.border = '1px solid var(--accent-border-subtle)';
          if (badge) { badge.style.color = 'var(--accent)'; badge.style.borderColor = 'var(--accent)'; }
        } else {
          (btn as HTMLElement).style.color = 'var(--text-secondary)';
          (btn as HTMLElement).style.background = '';
          (btn as HTMLElement).style.border = '1px solid transparent';
          if (badge) { badge.style.color = 'var(--text-muted)'; badge.style.borderColor = 'var(--border-default)'; }
        }
      });
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
      const pane = document.getElementById('tab-' + tab);
      if (pane) pane.classList.remove('hidden');
      const titleEl = document.getElementById('tab-title');
      if (titleEl) titleEl.textContent = (window as any).__TAB_TITLES?.[tab] || tab;
      document.body.classList.remove('nav-open');
      document.getElementById('mobile-menu')?.setAttribute('aria-expanded', 'false');
      if (tab === 'gpa') renderGpa();
      if (tab === 'spinner') renderWheel();
    }

    (window as any).__TAB_TITLES = { dashboard: '今日概览', backup: '数据备份', calendar: '日程与任务', courses: '课程管理', gpa: '绩点计算', tools: '常用工具', 'script-builder': '测试脚本生成器', 'base-converter': '进制转换', 'latex-tool': 'LaTeX 工具', spinner: '我来决策', 'em-master': '电磁大师', 'momentum-shooter': '动量射击', 'video-dl': '视频获取' };

    function toggleFullscreen(id: string) {
      const pane = document.getElementById(id);
      if (!pane) return;
      const btn = pane.querySelector('.fullscreen-btn') as HTMLElement;
