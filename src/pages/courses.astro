---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="课程管理" active="courses">
  <div class="nexus-root">
    <div class="nexus-header">
      <div>
        <div class="nexus-tag">
          <span class="nexus-dot"></span>
          <span class="tech-font">Academic Core // 课程资源中心</span>
        </div>
        <h1 class="nexus-title">本学期课程规划与评估</h1>
        <p class="nexus-sub">管理课程属性、学分配置、成绩占比及核心作业时限</p>
      </div>
      <button class="nexus-btn-primary" id="add-course-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        新增注册课程
      </button>
    </div>

    <div id="course-list" class="nexus-grid"></div>

    <!-- Grade calculator -->
    <div class="nexus-panel" id="grade-calc-section">
      <div class="nexus-panel-header">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
        <span>成绩计算器</span>
        <span class="nexus-panel-hint">选择一个课程，输入已出分项目的得分</span>
      </div>
      <div class="nexus-panel-body">
        <div class="calc-select-row">
          <select id="grade-course-select" class="nexus-input">
            <option value="">-- 选择课程 --</option>
          </select>
        </div>
        <div id="grade-calc-body">
          <p class="nexus-empty">请先选择课程</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Course form modal -->
  <div class="nexus-modal-overlay" id="course-modal" style="display:none">
    <div class="nexus-modal">
      <div class="nexus-modal-head">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <h3 id="course-modal-title">录入新课程档案</h3>
        </div>
        <button class="nexus-modal-close" id="c-close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="course-form" class="nexus-form">
        <label class="nexus-label">
          课程名称
          <input type="text" id="c-name" required placeholder="如：数字电子技术" class="nexus-input" />
        </label>

        <div class="nexus-form-row">
          <label class="nexus-label">
            学分
            <input type="number" id="c-credits" min="0" step="0.5" value="3" class="nexus-input" />
          </label>
          <label class="nexus-label">
            授课教师
            <input type="text" id="c-teacher" placeholder="可选" class="nexus-input" />
          </label>
        </div>

        <fieldset class="nexus-fieldset">
          <legend>成绩计算方法</legend>
          <div id="grading-items"></div>
          <button type="button" class="nexus-btn-outline nexus-btn-sm" id="add-grading-item">+ 添加评分项</button>
          <div class="nexus-grade-summary" id="grade-summary" style="display:none">
            <span>总分权值: <strong id="grade-total-weight">0%</strong></span>
            <span class="nexus-grade-note" id="grade-note"></span>
          </div>
        </fieldset>

        <fieldset class="nexus-fieldset">
          <legend>日程联动：期末 DDL</legend>
          <label class="nexus-label">
            考试/作业名称
            <input type="text" id="c-ddl-name" placeholder="如：期末综合测评" class="nexus-input" />
          </label>
          <label class="nexus-label" style="margin-top:0.5rem">
            截止日期
            <input type="date" id="c-ddl" class="nexus-input" />
          </label>
        </fieldset>

        <div class="nexus-form-actions">
          <button type="button" class="nexus-btn-outline" id="c-close-btn">取消</button>
          <button type="submit" class="nexus-btn-primary">确认部署</button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

  .nexus-root {
    color: #e2e8f0;
  }
  .tech-font {
    font-family: 'Share Tech Mono', monospace;
  }

  /* ── Header ── */
  .nexus-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  @media (max-width: 640px) {
    .nexus-header { flex-direction: column; }
  }
  .nexus-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .nexus-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #a855f7;
    animation: nexus-pulse 2s ease-in-out infinite;
  }
  @keyframes nexus-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  .nexus-tag span {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #a855f7;
  }
  .nexus-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .nexus-sub {
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 0.15rem;
  }

  /* ── Buttons ── */
  .nexus-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #9333ea;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms ease;
    white-space: nowrap;
  }
  .nexus-btn-primary:hover {
    background: #7e22ce;
  }
  .nexus-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.9rem;
    background: transparent;
    color: #94a3b8;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 150ms ease;
  }
  .nexus-btn-outline:hover {
    background: rgba(255,255,255,0.04);
    color: #e2e8f0;
  }
  .nexus-btn-sm {
    padding: 0.28rem 0.65rem;
    font-size: 0.7rem;
    border-radius: 6px;
  }
  .nexus-btn-ghost {
    background: transparent;
    border: none;
    color: #64748b;
    cursor: pointer;
    font-size: 0.72rem;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: all 150ms ease;
  }
  .nexus-btn-ghost:hover {
    color: #e2e8f0;
    background: rgba(255,255,255,0.04);
  }
  .nexus-btn-ghost.danger {
    color: #f87171;
  }
  .nexus-btn-ghost.danger:hover {
    background: rgba(248,113,113,0.08);
  }

  /* ── Grid ── */
  .nexus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 768px) {
    .nexus-grid { grid-template-columns: 1fr; }
  }

  /* ── Course Card ── */
  .nexus-card {
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 200ms ease, box-shadow 200ms ease;
    position: relative;
  }
  .nexus-card:hover {
    border-color: rgba(168,85,247,0.15);
    box-shadow: 0 4px 24px rgba(168,85,247,0.06);
  }

  .nexus-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .nexus-card-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .nexus-card-badge {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.66rem;
    font-weight: 600;
    color: #a855f7;
    background: rgba(168,85,247,0.08);
    padding: 0.2em 0.65em;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
    border: 1px solid rgba(168,85,247,0.12);
  }
  .nexus-card-teacher {
    font-size: 0.76rem;
    color: #64748b;
    margin-top: -0.35rem;
  }

  /* Grading box */
  .nexus-card-box {
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
  }
  .nexus-card-box .box-label {
    font-size: 0.62rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    display: block;
    margin-bottom: 0.15rem;
  }
  .nexus-card-box .box-text {
    font-size: 0.78rem;
    color: #cbd5e1;
    font-weight: 500;
    line-height: 1.45;
  }
  .nexus-card-box .box-text.muted {
    color: #475569;
    font-weight: 400;
  }

  /* DDL box */
  .nexus-ddl-box {
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nexus-ddl-box .ddl-left .box-label {
    font-size: 0.62rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    display: block;
    margin-bottom: 0.15rem;
  }
  .nexus-ddl-box .ddl-left .ddl-date {
    font-size: 0.76rem;
    font-weight: 500;
    color: #cbd5e1;
  }
  .nexus-ddl-box .ddl-left .ddl-date.urgent {
    color: #f87171;
  }
  .nexus-countdown {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nexus-countdown.safe   { background: rgba(52,211,153,0.08);  color: #34d399; }
  .nexus-countdown.warning { background: rgba(251,191,36,0.08);  color: #fbbf24; }
  .nexus-countdown.danger { background: rgba(248,113,113,0.08); color: #f87171; }
  .nexus-countdown.none   { background: rgba(255,255,255,0.03);  color: #475569; }

  .nexus-card-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.25rem;
    padding-top: 0.25rem;
    border-top: 1px solid rgba(255,255,255,0.04);
  }

  /* ── Modal ── */
  .nexus-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
  }
  .nexus-modal {
    width: 500px;
    max-width: 92vw;
    max-height: 85vh;
    overflow-y: auto;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .nexus-modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .nexus-modal-head h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }
  .nexus-modal-close {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 6px;
    transition: color 150ms;
  }
  .nexus-modal-close:hover { color: #fff; }

  /* ── Form ── */
  .nexus-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .nexus-label {
    display: block;
    font-size: 0.76rem;
    font-weight: 500;
    color: #94a3b8;
  }
  .nexus-input {
    display: block;
    width: 100%;
    margin-top: 0.2rem;
    padding: 0.5rem 0.65rem;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    color: #e2e8f0;
    font-size: 0.84rem;
    font-family: inherit;
    transition: border-color 150ms;
  }
  .nexus-input:focus {
    outline: none;
    border-color: rgba(168,85,247,0.5);
  }
  .nexus-input::placeholder { color: #475569; }
  select.nexus-input { cursor: pointer; }

  .nexus-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  @media (max-width: 500px) {
    .nexus-form-row { grid-template-columns: 1fr; }
  }
  .nexus-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .nexus-fieldset {
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    padding: 0.75rem;
  }
  .nexus-fieldset legend {
    font-size: 0.76rem;
    font-weight: 600;
    color: #94a3b8;
    padding: 0 0.3rem;
  }

  /* Grading rows inside fieldset */
  .grading-row {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .grading-row input { flex: 1; }
  .grading-row .weight-input { width: 80px; flex: none; }
  .grading-row .del-btn {
    color: #64748b;
    cursor: pointer;
    font-size: 0.82rem;
    padding: 0.2rem;
  }
  .grading-row .del-btn:hover { color: #f87171; }

  .nexus-grade-summary {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .nexus-grade-note { margin-left: 0.75rem; font-weight: 500; color: #f87171; }
  .nexus-grade-note.ok { color: #34d399; }

  /* ── Grade Calculator Panel ── */
  .nexus-panel {
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
  }
  .nexus-panel-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    font-size: 0.88rem;
    font-weight: 600;
    color: #fff;
  }
  .nexus-panel-hint {
    font-size: 0.72rem;
    color: #475569;
    font-weight: 400;
  }
  .nexus-panel-body {
    padding: 1rem 1.25rem;
  }
  .calc-select-row { margin-bottom: 0.75rem; }

  .nexus-empty {
    text-align: center;
    color: #475569;
    font-size: 0.82rem;
    padding: 1.5rem 0;
  }

  /* Calculator rows */
  .calc-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    font-size: 0.82rem;
  }
  .calc-row .item-name { width: 150px; font-weight: 500; color: #cbd5e1; }
  .calc-row .item-weight { color: #64748b; font-size: 0.76rem; width: 50px; text-align: right; }
  .calc-row input[type="number"] { width: 90px; }
  .calc-result {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(168,85,247,0.06);
    border: 1px solid rgba(168,85,247,0.1);
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.05rem;
    color: #e2e8f0;
  }
  .calc-result .score { color: #a855f7; }
</style>

<script>
  interface GradingItem { item: string; weight: number; }
  interface Course { id: string; name: string; credits: number; teacher: string; ddl: string; ddlName: string; grading: GradingItem[]; }

  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
  function load<T>(k: string, fb: T): T { try { const r = localStorage.getItem(k); return r ? JSON.parse(r) : fb; } catch { return fb; } }
  function save<T>(k: string, v: T) { localStorage.setItem(k, JSON.stringify(v)); }

  let courses: Course[] = load<Course[]>('weilizhe8_courses', []);
  let editingCId: string | null = null;

  function ddlCountdown(ddl: string): { days: number; label: string; cls: string } {
    if (!ddl) return { days: -1, label: '暂无', cls: 'none' };
    const diff = new Date(ddl).getTime() - Date.now();
    const days = Math.ceil(diff / 86400000);
    if (days <= 0) return { days: 0, label: '已截止', cls: 'danger' };
    if (days <= 3) return { days, label: `T-${days}天`, cls: 'danger' };
    if (days <= 7) return { days, label: `T-${days}天`, cls: 'warning' };
    return { days, label: `T-${days}天`, cls: 'safe' };
  }

  function renderCourses() {
    const container = document.getElementById('course-list')!;
    if (courses.length === 0) {
      container.innerHTML = `<div class="nexus-empty" style="grid-column:1/-1;padding:3rem 1rem">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="margin:0 auto 0.75rem;display:block;color:#334155"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <p style="margin-bottom:0.75rem">当前无注册课程</p>
        <button class="nexus-btn-outline" onclick="document.getElementById('add-course-btn')!.click()">添加第一门课程</button>
      </div>`;
    } else {
      container.innerHTML = courses.map(c => {
        const gradingSummary = c.grading.filter(g => g.item).map(g => `${g.item} ${g.weight}%`).join(' · ');
        const cd = ddlCountdown(c.ddl);
        const ddlStr = c.ddl || '暂无';
        return `<div class="nexus-card">
          <div class="nexus-card-top">
            <span class="nexus-card-name">${c.name}</span>
            <span class="nexus-card-badge">${c.credits} 学分</span>
          </div>
          ${c.teacher ? `<div class="nexus-card-teacher">${c.teacher}</div>` : ''}
          <div class="nexus-card-box">
            <span class="box-label">成绩评定公式</span>
            <span class="box-text${gradingSummary ? '' : ' muted'}">${gradingSummary || '未设置评分项'}</span>
          </div>
          <div class="nexus-ddl-box">
            <div class="ddl-left">
              <span class="box-label">${c.ddlName || '作业进度监控'}</span>
              <span class="ddl-date${cd.cls === 'danger' && c.ddl ? ' urgent' : ''}">${ddlStr.replace('T', ' ')}</span>
            </div>
            <span class="nexus-countdown ${cd.cls}">${cd.label}</span>
          </div>
          <div class="nexus-card-actions">
            <button class="nexus-btn-ghost" data-edit="${c.id}">编辑</button>
            <button class="nexus-btn-ghost danger" data-delete="${c.id}">删除</button>
          </div>
        </div>`;
      }).join('');
    }

    container.querySelectorAll('[data-edit]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-edit')!;
        const course = courses.find(c => c.id === id);
        if (course) openCourseModal(course);
      });
    });
    container.querySelectorAll('[data-delete]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-delete')!;
        const course = courses.find(c => c.id === id);
        if (course && confirm(`确定删除课程"${course.name}"？`)) {
          courses = courses.filter(c => c.id !== id);
          save('weilizhe8_courses', courses);
          renderCourses();
          renderGradeSelector();
        }
      });
    });

    renderGradeSelector();
  }

  // Course modal
  document.getElementById('add-course-btn')!.addEventListener('click', () => openCourseModal(null));
  document.getElementById('c-close')!.addEventListener('click', () => {
    document.getElementById('course-modal')!.style.display = 'none';
  });
  document.getElementById('c-close-btn')!.addEventListener('click', () => {
    document.getElementById('course-modal')!.style.display = 'none';
  });

  function openCourseModal(course: Course | null) {
    editingCId = course?.id ?? null;
    document.getElementById('course-modal-title')!.textContent = course ? '编辑课程档案' : '录入新课程档案';
    (document.getElementById('c-name') as HTMLInputElement).value = course?.name ?? '';
    (document.getElementById('c-credits') as HTMLInputElement).value = String(course?.credits ?? 3);
    (document.getElementById('c-teacher') as HTMLInputElement).value = course?.teacher ?? '';
    (document.getElementById('c-ddl') as HTMLInputElement).value = course?.ddl ?? '';
    (document.getElementById('c-ddl-name') as HTMLInputElement).value = course?.ddlName ?? '';
    document.getElementById('course-modal')!.style.display = 'flex';

    const gradingContainer = document.getElementById('grading-items')!;
    const items = course?.grading ?? [{ item: '', weight: 40 }, { item: '', weight: 60 }];
    gradingContainer.innerHTML = '';
    items.forEach(g => addGradingRow(g.item, g.weight));
    updateGradeSummary();
  }

  function addGradingRow(item: string, weight: number) {
    const container = document.getElementById('grading-items')!;
    const row = document.createElement('div');
    row.className = 'grading-row';
    row.innerHTML = `
      <input type="text" class="g-item nexus-input" value="${item}" placeholder="如：期末考试" style="flex:1" />
      <input type="number" class="weight-input g-weight nexus-input" value="${weight}" min="0" max="100" step="1" style="width:80px;flex:none" />
      <span style="color:#64748b">%</span>
      <span class="del-btn" title="删除">&#10005;</span>
    `;
    row.querySelector('.del-btn')!.addEventListener('click', () => {
      row.remove();
      updateGradeSummary();
    });
    row.querySelector('.g-item')!.addEventListener('input', updateGradeSummary);
    row.querySelector('.g-weight')!.addEventListener('input', updateGradeSummary);
    container.appendChild(row);
  }

  document.getElementById('add-grading-item')!.addEventListener('click', () => addGradingRow('', 0));

  function updateGradeSummary() {
    const weights = document.querySelectorAll<HTMLInputElement>('.g-weight');
    let total = 0;
    weights.forEach(w => total += Number(w.value) || 0);
    const summary = document.getElementById('grade-summary')!;
    const note = document.getElementById('grade-note')!;
    summary.style.display = 'block';
    document.getElementById('grade-total-weight')!.textContent = `${total}%`;
    if (total === 100) {
      note.textContent = '✓';
      note.className = 'nexus-grade-note ok';
    } else if (total > 100) {
      note.textContent = `超出 ${total - 100}%`;
      note.className = 'nexus-grade-note';
    } else {
      note.textContent = `缺少 ${100 - total}%`;
      note.className = 'nexus-grade-note';
    }
  }

  // Course form submit
  document.getElementById('course-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const credits = parseFloat((document.getElementById('c-credits') as HTMLInputElement).value) || 0;
    const teacher = (document.getElementById('c-teacher') as HTMLInputElement).value.trim();
    const ddl = (document.getElementById('c-ddl') as HTMLInputElement).value;
    const ddlName = (document.getElementById('c-ddl-name') as HTMLInputElement).value.trim();

    const grading: GradingItem[] = [];
    const items = document.querySelectorAll<HTMLInputElement>('.g-item');
    const weights = document.querySelectorAll<HTMLInputElement>('.g-weight');
    items.forEach((item, i) => {
      const name = item.value.trim();
      if (name) grading.push({ item: name, weight: Number(weights[i]?.value) || 0 });
    });

    if (!name) return;

    if (editingCId) {
      const idx = courses.findIndex(c => c.id === editingCId);
      if (idx !== -1) courses[idx] = { ...courses[idx], name, credits, teacher, ddl, ddlName, grading };
      editingCId = null;
    } else {
      courses.push({ id: uid(), name, credits, teacher, ddl, ddlName, grading });
    }

    save('weilizhe8_courses', courses);
    renderCourses();
    document.getElementById('course-modal')!.style.display = 'none';
  });

  // Grade calculator
  function renderGradeSelector() {
    const sel = document.getElementById('grade-course-select') as HTMLSelectElement;
    sel.innerHTML = '<option value="">-- 选择课程 --</option>' + courses.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
  }

  document.getElementById('grade-course-select')!.addEventListener('change', () => {
    const id = (document.getElementById('grade-course-select') as HTMLSelectElement).value;
    const body = document.getElementById('grade-calc-body')!;
    if (!id) {
      body.innerHTML = '<p class="nexus-empty">请先选择课程</p>';
      return;
    }
    const course = courses.find(c => c.id === id);
    if (!course || course.grading.length === 0) {
      body.innerHTML = '<p class="nexus-empty">该课程未设置评分项</p>';
      return;
    }

    body.innerHTML = `
      ${course.grading.map((g) => `
        <div class="calc-row">
          <span class="item-name">${g.item}</span>
          <span class="item-weight">${g.weight}%</span>
          <input type="number" class="g-score nexus-input" min="0" max="100" step="0.1" placeholder="得分" data-weight="${g.weight}" style="width:90px" />
        </div>
      `).join('')}
      <div class="calc-result">
        加权总分: <span class="score" id="calc-result-display">--</span>
      </div>
    `;

    body.querySelectorAll('.g-score').forEach(input => {
      input.addEventListener('input', () => {
        let total = 0;
        const rows = body.querySelectorAll<HTMLInputElement>('.g-score');
        rows.forEach(r => {
          const score = parseFloat(r.value);
          const weight = parseFloat(r.getAttribute('data-weight')!);
          if (!isNaN(score)) total += score * weight / 100;
        });
        document.getElementById('calc-result-display')!.textContent = total > 0 ? total.toFixed(1) : '--';
      });
    });
  });

  // Init
  renderCourses();
</script>
