---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="课程管理" active="courses">
  <div class="courses-layout">
    <section class="courses-main">
      <div class="section-header">
        <h2>我的课程</h2>
        <button class="btn btn-primary btn-sm" id="add-course-btn">+ 添加课程</button>
      </div>
      <div id="course-list"></div>
    </section>
  </div>

  <!-- Course form modal -->
  <div class="modal-overlay" id="course-modal" style="display:none">
    <div class="modal-card card">
      <h3 id="course-modal-title">添加课程</h3>
      <form id="course-form" class="form-compact">
        <label>课程名称 <input type="text" id="c-name" required placeholder="如：数字电子技术" /></label>
        <div class="form-row">
          <label>学分 <input type="number" id="c-credits" min="0" step="0.5" value="3" /></label>
          <label>授课教师 <input type="text" id="c-teacher" placeholder="可选" /></label>
        </div>

        <fieldset class="grading-section">
          <legend>成绩计算方法</legend>
          <div id="grading-items"></div>
          <button type="button" class="btn btn-outline btn-sm" id="add-grading-item">+ 添加评分项</button>
          <div class="grade-summary" id="grade-summary" style="display:none">
            <span>总分权值: <strong id="grade-total-weight">0%</strong></span>
            <span class="grade-note" id="grade-note"></span>
          </div>
        </fieldset>

        <fieldset class="grading-section">
          <legend>日程联动：期末 DDL</legend>
          <label>考试/作业名称 <input type="text" id="c-ddl-name" placeholder="如：期末综合测评" /></label>
          <label style="margin-top:0.5rem">截止日期 <input type="date" id="c-ddl" /></label>
        </fieldset>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-sm">保存</button>
          <button type="button" class="btn btn-outline btn-sm" id="c-close">取消</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Grade calculator -->
  <section class="card" style="margin-top:1.5rem" id="grade-calc-section">
    <h3 style="margin-bottom:0.5rem">成绩计算器</h3>
    <p class="text-muted" style="font-size:0.82rem;margin-bottom:1rem">选择一个课程，输入已出分项目的得分</p>
    <div class="form-row" style="margin-bottom:1rem">
      <label style="flex:1">
        <select id="grade-course-select" class="input-full">
          <option value="">-- 选择课程 --</option>
        </select>
      </label>
    </div>
    <div id="grade-calc-body">
      <p class="text-muted" style="text-align:center">请先选择课程</p>
    </div>
  </section>
</BaseLayout>

<style>
  .courses-layout {
    display: block;
  }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .section-header h2 {
    font-size: 1.35rem;
  }

  #course-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.85rem;
  }

  /* ── Course Card ── */
  .course-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: box-shadow var(--transition), border-color var(--transition);
    box-shadow: var(--shadow-sm);
    position: relative;
  }
  .course-card:hover {
    border-color: rgba(0,122,255,0.15);
    box-shadow: var(--shadow-md);
  }

  .course-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .course-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-foreground);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .course-credits {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-primary);
    background: rgba(0,122,255,0.06);
    padding: 0.2em 0.65em;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
    border: 1px solid rgba(0,122,255,0.1);
  }

  .course-teacher {
    font-size: 0.78rem;
    color: #86868B;
    margin-top: -0.25rem;
  }

  /* Grading inset box */
  .course-grading-box {
    background: #F9F9FB;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.75rem;
  }
  .course-grading-box .grading-label {
    font-size: 0.64rem;
    color: #86868B;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin-bottom: 0.2rem;
    display: block;
  }
  .course-grading-box .grading-text {
    font-size: 0.8rem;
    color: #3A3A3C;
    font-weight: 500;
    line-height: 1.45;
  }
  .course-grading-box .grading-text.empty {
    color: #C7C7CC;
    font-weight: 400;
  }

  /* DDL inset box */
  .course-ddl-box {
    background: #F9F9FB;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .course-ddl-box .ddl-label {
    font-size: 0.64rem;
    color: #86868B;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin-bottom: 0.15rem;
    display: block;
  }
  .course-ddl-box .ddl-date-text {
    font-size: 0.78rem;
    font-weight: 500;
    color: #3A3A3C;
  }
  .course-ddl-box .ddl-date-text.urgent {
    color: var(--color-destructive);
  }
  .course-countdown {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .course-countdown.safe {
    background: rgba(52,199,89,0.08);
    color: #34C759;
  }
  .course-countdown.warning {
    background: rgba(255,149,0,0.08);
    color: #FF9500;
  }
  .course-countdown.danger {
    background: rgba(255,59,48,0.08);
    color: var(--color-destructive);
  }
  .course-countdown.none {
    background: #F2F2F7;
    color: #86868B;
  }

  .course-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.3rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-border);
  }

  /* ── Modal ── */
  .modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    z-index: 200;
  }
  .modal-card {
    width: 480px;
    max-width: 92vw;
    max-height: 85vh;
    overflow-y: auto;
  }
  .modal-card h3 { margin-bottom: 1rem; }

  .form-compact label {
    display: block;
    font-size: 0.84rem;
    font-weight: 500;
    color: #6E6E73;
    margin-bottom: 0.55rem;
  }
  .form-compact input, .form-compact select, .input-full {
    display: block;
    width: 100%;
    margin-top: 0.15rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .form-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .grading-section {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    margin-top: 0.25rem;
  }
  .grading-section legend {
    font-size: 0.84rem;
    font-weight: 600;
    color: #6E6E73;
    padding: 0 0.3rem;
  }
  .grading-row {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .grading-row input {
    flex: 1;
  }
  .grading-row .weight-input {
    width: 80px;
    flex: none;
  }
  .grading-row .del-btn {
    color: #86868B;
    cursor: pointer;
    font-size: 0.82rem;
    padding: 0.2rem;
  }
  .grading-row .del-btn:hover { color: var(--color-destructive); }
  .grade-summary {
    margin-top: 0.5rem;
    font-size: 0.82rem;
  }
  .grade-note { color: var(--color-destructive); margin-left: 0.75rem; font-weight: 500; }
  .grade-note.ok { color: #34C759; }

  /* ── Grade Calculator ── */
  .calc-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    font-size: 0.86rem;
  }
  .calc-row .item-name { width: 140px; font-weight: 500; }
  .calc-row .item-weight { color: #86868B; font-size: 0.8rem; width: 50px; text-align: right; }
  .calc-row input[type="number"] { width: 90px; }
  .calc-result {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: var(--color-muted);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .calc-result .score { color: var(--color-primary); }

  @media (max-width: 768px) {
    #course-list {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .course-actions {
      position: static;
      margin-top: 0.5rem;
    }
  }
</style>

<script>
  interface GradingItem { item: string; weight: number; }
  interface Course { id: string; name: string; credits: number; teacher: string; ddl: string; ddlName: string; grading: GradingItem[]; }

  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
  function load<T>(k: string, fb: T): T { try { const r = localStorage.getItem(k); return r ? JSON.parse(r) : fb; } catch { return fb; } }
  function save<T>(k: string, v: T) { localStorage.setItem(k, JSON.stringify(v)); }

  let courses: Course[] = load<Course[]>('weilizhe8_courses', []);
  let editingCId: string | null = null;

  function ddlCountdown(ddl: string): { days: number; label: string; cls: string } {
    if (!ddl) return { days: -1, label: '暂无', cls: 'none' };
    const diff = new Date(ddl).getTime() - Date.now();
    const days = Math.ceil(diff / 86400000);
    if (days <= 0) return { days: 0, label: '已截止', cls: 'danger' };
    if (days <= 3) return { days, label: `${days} 天`, cls: 'danger' };
    if (days <= 7) return { days, label: `${days} 天`, cls: 'warning' };
    if (days <= 30) return { days, label: `${days} 天`, cls: 'safe' };
    return { days, label: `${days} 天`, cls: 'safe' };
  }

  function renderCourses() {
    const container = document.getElementById('course-list')!;
    if (courses.length === 0) {
      container.innerHTML = `<div class="empty-state" style="grid-column:1/-1">
        <p>还没有添加课程</p>
        <button class="btn btn-primary btn-sm" onclick="document.getElementById('add-course-btn')!.click()">添加第一门课程</button>
      </div>`;
    } else {
      container.innerHTML = courses.map(c => {
        const gradingSummary = c.grading.filter(g => g.item).map(g => `${g.item} ${g.weight}%`).join(' · ');
        const cd = ddlCountdown(c.ddl);
        const ddlStr = c.ddl || '暂无';
        return `<div class="course-card">
          <div class="course-top">
            <span class="course-name">${c.name}</span>
            <span class="course-credits">${c.credits} 学分</span>
          </div>
          ${c.teacher ? `<div class="course-teacher">${c.teacher}</div>` : ''}
          <div class="course-grading-box">
            <span class="grading-label">成绩评定</span>
            <span class="grading-text${gradingSummary ? '' : ' empty'}">${gradingSummary || '未设置评分项'}</span>
          </div>
          <div class="course-ddl-box">
            <div>
              <span class="ddl-label">${c.ddlName || '期末 DDL'}</span>
              <span class="ddl-date-text${cd.cls === 'danger' && c.ddl ? ' urgent' : ''}">${ddlStr}</span>
            </div>
            <span class="course-countdown ${cd.cls}">${cd.label}</span>
          </div>
          <div class="course-actions">
            <button class="btn btn-ghost btn-sm" data-edit="${c.id}">编辑</button>
            <button class="btn btn-ghost btn-sm" data-delete="${c.id}" style="color:var(--color-destructive)">删除</button>
          </div>
        </div>`;
      }).join('');
    }

    container.querySelectorAll('[data-edit]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-edit')!;
        const course = courses.find(c => c.id === id);
        if (course) openCourseModal(course);
      });
    });
    container.querySelectorAll('[data-delete]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-delete')!;
        const course = courses.find(c => c.id === id);
        if (course && confirm(`确定删除课程"${course.name}"？`)) {
          courses = courses.filter(c => c.id !== id);
          save('weilizhe8_courses', courses);
          renderCourses();
          renderGradeSelector();
        }
      });
    });

    renderGradeSelector();
  }

  // Course modal
  document.getElementById('add-course-btn')!.addEventListener('click', () => openCourseModal(null));
  document.getElementById('c-close')!.addEventListener('click', () => {
    document.getElementById('course-modal')!.style.display = 'none';
  });

  function openCourseModal(course: Course | null) {
    editingCId = course?.id ?? null;
    document.getElementById('course-modal-title')!.textContent = course ? '编辑课程' : '添加课程';
    (document.getElementById('c-name') as HTMLInputElement).value = course?.name ?? '';
    (document.getElementById('c-credits') as HTMLInputElement).value = String(course?.credits ?? 3);
    (document.getElementById('c-teacher') as HTMLInputElement).value = course?.teacher ?? '';
    (document.getElementById('c-ddl') as HTMLInputElement).value = course?.ddl ?? '';
    (document.getElementById('c-ddl-name') as HTMLInputElement).value = course?.ddlName ?? '';
    document.getElementById('course-modal')!.style.display = 'flex';

    const gradingContainer = document.getElementById('grading-items')!;
    const items = course?.grading ?? [{ item: '', weight: 40 }, { item: '', weight: 60 }];
    gradingContainer.innerHTML = '';
    items.forEach(g => addGradingRow(g.item, g.weight));
    updateGradeSummary();
  }

  function addGradingRow(item: string, weight: number) {
    const container = document.getElementById('grading-items')!;
    const row = document.createElement('div');
    row.className = 'grading-row';
    row.innerHTML = `
      <input type="text" class="g-item" value="${item}" placeholder="如：期末考试" />
      <input type="number" class="weight-input g-weight" value="${weight}" min="0" max="100" step="1" />
      <span>%</span>
      <span class="del-btn g-del" title="删除">✕</span>
    `;
    row.querySelector('.g-del')!.addEventListener('click', () => {
      row.remove();
      updateGradeSummary();
    });
    row.querySelector('.g-item')!.addEventListener('input', updateGradeSummary);
    row.querySelector('.g-weight')!.addEventListener('input', updateGradeSummary);
    container.appendChild(row);
  }

  document.getElementById('add-grading-item')!.addEventListener('click', () => addGradingRow('', 0));

  function updateGradeSummary() {
    const weights = document.querySelectorAll<HTMLInputElement>('.g-weight');
    let total = 0;
    weights.forEach(w => total += Number(w.value) || 0);
    const summary = document.getElementById('grade-summary')!;
    const note = document.getElementById('grade-note')!;
    summary.style.display = 'block';
    document.getElementById('grade-total-weight')!.textContent = `${total}%`;
    if (total === 100) {
      note.textContent = '✓';
      note.className = 'grade-note ok';
    } else if (total > 100) {
      note.textContent = `超出 ${total - 100}%`;
      note.className = 'grade-note';
    } else {
      note.textContent = `缺少 ${100 - total}%`;
      note.className = 'grade-note';
    }
  }

  // Course form submit
  document.getElementById('course-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const credits = parseFloat((document.getElementById('c-credits') as HTMLInputElement).value) || 0;
    const teacher = (document.getElementById('c-teacher') as HTMLInputElement).value.trim();
    const ddl = (document.getElementById('c-ddl') as HTMLInputElement).value;
    const ddlName = (document.getElementById('c-ddl-name') as HTMLInputElement).value.trim();

    const grading: GradingItem[] = [];
    const items = document.querySelectorAll<HTMLInputElement>('.g-item');
    const weights = document.querySelectorAll<HTMLInputElement>('.g-weight');
    items.forEach((item, i) => {
      const name = item.value.trim();
      if (name) grading.push({ item: name, weight: Number(weights[i]?.value) || 0 });
    });

    if (!name) return;

    if (editingCId) {
      const idx = courses.findIndex(c => c.id === editingCId);
      if (idx !== -1) courses[idx] = { ...courses[idx], name, credits, teacher, ddl, ddlName, grading };
      editingCId = null;
    } else {
      courses.push({ id: uid(), name, credits, teacher, ddl, ddlName, grading });
    }

    save('weilizhe8_courses', courses);
    renderCourses();
    document.getElementById('course-modal')!.style.display = 'none';
  });

  // Grade calculator
  function renderGradeSelector() {
    const sel = document.getElementById('grade-course-select') as HTMLSelectElement;
    sel.innerHTML = '<option value="">-- 选择课程 --</option>' + courses.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
  }

  document.getElementById('grade-course-select')!.addEventListener('change', () => {
    const id = (document.getElementById('grade-course-select') as HTMLSelectElement).value;
    const body = document.getElementById('grade-calc-body')!;
    if (!id) {
      body.innerHTML = '<p class="text-muted" style="text-align:center">请先选择课程</p>';
      return;
    }
    const course = courses.find(c => c.id === id);
    if (!course || course.grading.length === 0) {
      body.innerHTML = '<p class="text-muted" style="text-align:center">该课程未设置评分项</p>';
      return;
    }

    body.innerHTML = `
      ${course.grading.map((g) => `
        <div class="calc-row">
          <span class="item-name">${g.item}</span>
          <span class="item-weight">${g.weight}%</span>
          <input type="number" class="g-score" min="0" max="100" step="0.1" placeholder="得分" data-weight="${g.weight}" />
        </div>
      `).join('')}
      <div class="calc-result">
        加权总分: <span class="score" id="calc-result-display">--</span>
      </div>
    `;

    body.querySelectorAll('.g-score').forEach(input => {
      input.addEventListener('input', () => {
        let total = 0;
        const rows = body.querySelectorAll<HTMLInputElement>('.g-score');
        rows.forEach(r => {
          const score = parseFloat(r.value);
          const weight = parseFloat(r.getAttribute('data-weight')!);
          if (!isNaN(score)) total += score * weight / 100;
        });
        document.getElementById('calc-result-display')!.textContent = total > 0 ? total.toFixed(1) : '--';
      });
    });
  });

  // Init
  renderCourses();
</script>
