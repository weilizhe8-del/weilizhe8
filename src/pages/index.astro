    // ============================================================
    // COUNTDOWN FORMATTER
    // ============================================================
    function formatCountdown(deadline: string): { text: string; expired: boolean } {
      const diff = new Date(deadline).getTime() - Date.now();
      if (diff <= 0) return { text: '已到期', expired: true };
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      if (d > 0) return { text: `${d}<span class="text-zinc-500 mx-0.5">天</span>${h}<span class="text-zinc-500 mx-0.5">小时</span>`, expired: false };
      if (h > 0) return { text: `${h}<span class="text-zinc-500 mx-0.5">小时</span>${m}<span class="text-zinc-500 mx-0.5">分钟</span>`, expired: false };
      return { text: `${m}<span class="text-zinc-500 mx-0.5">分钟</span>`, expired: false };
    }

    // ============================================================
    // TAB SWITCHING
    // ============================================================
    function switchTab(tab: string) {
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
      const textPri = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim();
      const bgHover = getComputedStyle(document.documentElement).getPropertyValue('--bg-card-hover').trim();
      document.querySelectorAll('.sidebar-btn').forEach(btn => {
        const isActive = (btn as HTMLElement).dataset.tab === tab;
        btn.classList.toggle('active', isActive);
        if (isActive) {
          (btn as HTMLElement).style.cssText = 'color:' + textPri + ';background:' + bgHover + ';border-left-color:' + accent + ';';
          const icon = btn.querySelector('.lucide');
          if (icon) (icon as HTMLElement).style.color = accent;
        } else {
          (btn as HTMLElement).style.cssText = 'color:var(--text-secondary)';
          const icon = btn.querySelector('.lucide');
          if (icon) (icon as HTMLElement).style.color = '';
        }
      });
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
      const pane = document.getElementById('tab-' + tab);
      if (pane) pane.classList.remove('hidden');
      const titleEl = document.getElementById('tab-title');
      if (titleEl) {
        const title = (window as any).__TAB_TITLES?.[tab] || tab;
        titleEl.innerHTML = '<span class=\"accent-prefix\">&gt;&gt;&gt;</span> ' + title;
      }
      if (tab === 'gpa') renderGpa();
      if (tab === 'spinner') renderWheel();
    }

