---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Modals from '../components/Modals.astro';
---

<Layout title="Core - Astro Terminal">
  <Sidebar />

  <div class="flex-1 flex flex-col h-screen overflow-hidden">
    <header class="h-14 border-b border-zinc-800/40 px-8 flex items-center justify-between bg-[#0d0e12]/80 backdrop-blur-md shrink-0">
      <span id="page-title" class="text-[11px] uppercase tracking-widest text-zinc-500 font-semibold">控制面板</span>
      <div class="flex items-center gap-6 text-[11px] text-zinc-500 tracking-wider">
        <span id="current-date" class="mono">202X.00.00</span>
        <span id="current-time" class="mono text-zinc-400">00:00:00</span>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto p-8 no-scrollbar bg-gradient-to-b from-[#0e0f14] to-[#0d0e12]">

      <!-- TAB 1: 控制面板 -->
      <div id="tab-dashboard" class="tab-content space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="md:col-span-2 p-6 rounded-lg bg-[#14151a] border border-zinc-800/40">
            <h2 class="text-sm font-semibold text-zinc-100 mb-1">学期进程纵览</h2>
            <p class="text-xs text-zinc-400">
              目前注册课程 <span id="dash-course-count" class="text-sky-400 mono font-semibold">0</span> 门，活动中日程提醒共有 <span id="dash-event-count" class="text-sky-400 mono font-semibold">0</span> 项。
            </p>
          </div>
          <div class="p-6 rounded-lg bg-[#14151a] border border-zinc-800/40 flex flex-col justify-between">
            <div class="flex justify-between items-center text-[11px] text-zinc-500 font-semibold">
              <span>SEMESTER PROGRESS</span>
              <span class="text-zinc-400 mono">WEEK 8 / 18</span>
            </div>
            <div class="my-3">
              <div class="w-full bg-zinc-800/60 rounded-full h-1">
                <div class="bg-sky-400 h-1 rounded-full" style="width: 44.4%"></div>
              </div>
            </div>
            <span class="text-[10px] text-zinc-500">已用 53 天 / 剩余 67 天</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="p-6 rounded-lg bg-[#14151a] border border-zinc-800/40">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-zinc-800/30">
              <h3 class="text-xs font-semibold text-zinc-200 uppercase tracking-wider">临近倒计时</h3>
              <span class="text-[10px] text-zinc-500">URGENT</span>
            </div>
            <div id="dash-countdown-list" class="space-y-2"></div>
          </div>

          <div class="p-6 rounded-lg bg-[#14151a] border border-zinc-800/40">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-zinc-800/30">
              <h3 class="text-xs font-semibold text-zinc-200 uppercase tracking-wider">快速导航</h3>
              <span class="text-[10px] text-zinc-500">QUICK LINKS</span>
            </div>
            <div id="dash-tools-list" class="grid grid-cols-2 gap-2"></div>
          </div>
        </div>
      </div>

      <!-- TAB 2: 日程倒计时 -->
      <div id="tab-calendar" class="tab-content space-y-6 hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="p-6 rounded-lg bg-[#14151a] border border-zinc-800/40 h-fit">
            <h3 class="text-xs font-semibold text-zinc-200 uppercase tracking-wider mb-4">创建倒计时</h3>
            <form id="event-form" class="space-y-4 text-xs">
              <div>
                <label class="block text-zinc-500 mb-1">事件名称</label>
                <input type="text" id="event-title" required placeholder="算法期中测验" class="w-full bg-[#1b1c23] border border-zinc-800 rounded px-3 py-2 text-zinc-200 focus:outline-none">
              </div>
              <div>
                <label class="block text-zinc-500 mb-1">目标时间</label>
                <input type="datetime-local" id="event-date" required class="w-full bg-[#1b1c23] border border-zinc-800 rounded px-3 py-2 text-zinc-200 focus:outline-none">
              </div>
              <div>
                <label class="block text-zinc-500 mb-1">类别属性</label>
                <select id="event-tag" class="w-full bg-[#1b1c23] border border-zinc-800 rounded px-3 py-2 text-zinc-200">
                  <option value="course">学术任务</option>
                  <option value="exam">考试/测评</option>
                  <option value="personal">个人日程</option>
                </select>
              </div>
              <button type="submit" class="w-full py-2 bg-zinc-800 hover:bg-zinc-750 text-zinc-200 font-medium rounded transition-all">写入日程库</button>
            </form>
          </div>

          <div class="lg:col-span-2 p-6 rounded-lg bg-[#14151a] border border-zinc-800/40">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-zinc-800/30">
              <h3 class="text-xs font-semibold text-zinc-200 uppercase tracking-wider">全部日程队列</h3>
              <span class="text-[10px] text-zinc-500">SCHEDULE LIST</span>
            </div>
            <div id="full-events-list" class="space-y-2"></div>
          </div>
        </div>
      </div>

      <!-- TAB 3: 课程管理 -->
      <div id="tab-courses" class="tab-content space-y-6 hidden">
        <div class="flex justify-between items-center">
          <div>
            <h3 class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Academic Tracker</h3>
            <h2 class="text-base font-bold text-zinc-100">本学期在研课程</h2>
          </div>
          <button id="add-course-btn" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-750 text-zinc-200 text-xs font-medium rounded transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i> 注册课程
          </button>
        </div>
        <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
      </div>

      <!-- TAB 4: 常用工具 -->
      <div id="tab-tools" class="tab-content space-y-6 hidden">
        <div class="flex justify-between items-center">
          <div>
            <h3 class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Web Directory</h3>
            <h2 class="text-base font-bold text-zinc-100">常用学术与工具入口</h2>
          </div>
          <button id="add-tool-btn" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-750 text-zinc-200 text-xs font-medium rounded transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i> 新增站点
          </button>
        </div>
        <div id="tools-container" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>
      </div>

    </div>
  </div>

  <Modals />
</Layout>

<script is:inline>
  // ── Data layer (localStorage with default fallback) ──
  let events = JSON.parse(localStorage.getItem('weilizhe8_events') || 'null') || [
    { id: 1, title: '高等数学 期中测验', date: new Date(Date.now() + 3*86400000).toISOString().slice(0, 16), tag: 'exam' },
    { id: 2, title: '计算机网络大作业 DDL', date: new Date(Date.now() + 12*86400000).toISOString().slice(0, 16), tag: 'course' }
  ];
  let courses = JSON.parse(localStorage.getItem('weilizhe8_courses') || 'null') || [
    { id: 1, name: '高等数学 (II)', credits: 5, formula: '期末 60% + 期中 20% + 作业 20%', ddlTitle: '期末小总结', ddlDate: new Date(Date.now() + 18*86400000).toISOString().slice(0, 16) }
  ];
  let tools = JSON.parse(localStorage.getItem('weilizhe8_tools') || 'null') || [
    { id: 1, name: 'GitHub', url: 'https://github.com', category: '学习资源' },
    { id: 2, name: 'ChatGPT', url: 'https://chat.openai.com', category: '实用工具' },
    { id: 3, name: '中国知网', url: 'https://www.cnki.net', category: '学习资源' },
    { id: 4, name: 'Notion', url: 'https://www.notion.so', category: '实用工具' }
  ];

  function persist() {
    localStorage.setItem('weilizhe8_events', JSON.stringify(events));
    localStorage.setItem('weilizhe8_courses', JSON.stringify(courses));
    localStorage.setItem('weilizhe8_tools', JSON.stringify(tools));
  }

  // ── Clock ──
  function updateTime() {
    const now = new Date();
    const timeEl = document.getElementById('current-time');
    const dateEl = document.getElementById('current-date');
    if (timeEl) timeEl.innerText = now.toTimeString().split(' ')[0];
    if (dateEl) dateEl.innerText = now.getFullYear() + '.' + String(now.getMonth() + 1).padStart(2, '0') + '.' + String(now.getDate()).padStart(2, '0');
  }

  // ── Helpers ──
  function getRemainingDays(targetDate) {
    const diff = +new Date(targetDate) - +new Date();
    if (diff <= 0) return '已到期';
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    return days > 0 ? `${days}天 ${hours}小时` : `${hours}小时`;
  }

  function refreshIcons() {
    if (window.lucide) window.lucide.createIcons();
  }

  // ── Render ──
  function renderAll() {
    renderDashboard();
    renderCalendar();
    renderCourses();
    renderTools();
    refreshIcons();
  }

  function renderDashboard() {
    const cCount = document.getElementById('dash-course-count');
    const eCount = document.getElementById('dash-event-count');
    if (cCount) cCount.innerText = String(courses.length);
    if (eCount) eCount.innerText = String(events.length);

    const cdContainer = document.getElementById('dash-countdown-list');
    if (cdContainer) {
      cdContainer.innerHTML = '';
      const sorted = [...events].sort((a, b) => +new Date(a.date) - +new Date(b.date)).slice(0, 3);
      if (sorted.length === 0) {
        cdContainer.innerHTML = '<span class="text-xs text-zinc-600 block py-2">暂无待办倒计时</span>';
      } else {
        sorted.forEach(ev => {
          cdContainer.innerHTML += `<div class="flex items-center justify-between p-2.5 rounded hover:bg-zinc-800/20 transition-all"><span class="text-xs text-zinc-300 font-medium">${ev.title}</span><span class="text-xs mono text-sky-400 font-medium">${getRemainingDays(ev.date)}</span></div>`;
        });
      }
    }

    const toolsContainer = document.getElementById('dash-tools-list');
    if (toolsContainer) {
      toolsContainer.innerHTML = '';
      tools.slice(0, 4).forEach(t => {
        toolsContainer.innerHTML += `<a href="${t.url}" target="_blank" rel="noopener" class="p-2.5 rounded bg-zinc-900/40 border border-zinc-800/20 text-center text-xs text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/30 transition-all block truncate">${t.name}</a>`;
      });
    }
  }

  function renderCalendar() {
    const container = document.getElementById('full-events-list');
    if (!container) return;
    container.innerHTML = '';

    if (events.length === 0) {
      container.innerHTML = '<p class="text-xs text-zinc-600 text-center py-8">暂无日程倒计时数据</p>';
      return;
    }

    const sorted = [...events].sort((a, b) => +new Date(a.date) - +new Date(b.date));
    sorted.forEach(ev => {
      const isOver = +new Date(ev.date) - +new Date() <= 0;
      container.innerHTML += `<div class="flex items-center justify-between p-3.5 rounded bg-[#1b1c23]/30 border border-zinc-800/30 hover:border-zinc-800/60 transition-all">
        <div class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full ${ev.tag === 'exam' ? 'bg-rose-500/60' : 'bg-sky-400/60'}"></span>
          <div>
            <h4 class="text-xs font-semibold text-zinc-200">${ev.title}</h4>
            <p class="text-[10px] text-zinc-500 mt-0.5">时限: ${ev.date.replace('T', ' ')}</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <span class="text-xs mono ${isOver ? 'text-zinc-600' : 'text-sky-400 font-semibold'}">${getRemainingDays(ev.date)}</span>
          <button class="delete-event-btn text-zinc-600 hover:text-zinc-400 transition-colors" data-id="${ev.id}"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
        </div>
      </div>`;
    });

    container.querySelectorAll('.delete-event-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget).getAttribute('data-id') || '';
        events = events.filter(ev => String(ev.id) !== id);
        persist();
        renderAll();
      });
    });
  }

  function renderCourses() {
    const grid = document.getElementById('courses-grid');
    if (!grid) return;
    grid.innerHTML = '';

    if (courses.length === 0) {
      grid.innerHTML = '<div class="col-span-full text-center p-12 text-zinc-600 text-xs">尚无注册课程记录</div>';
      return;
    }

    courses.forEach(c => {
      let ddlHtml = '';
      if (c.ddlTitle && c.ddlDate) {
        ddlHtml = `<div class="mt-4 pt-3 border-t border-zinc-800/40"><div class="flex justify-between items-center text-[10px] text-zinc-500"><span class="truncate w-32"><i data-lucide="bell" class="w-3 h-3 inline mr-1 text-zinc-600"></i>${c.ddlTitle}</span><span class="mono text-sky-400 font-medium">${getRemainingDays(c.ddlDate)}</span></div></div>`;
      }

      grid.innerHTML += `<div class="p-5 rounded-lg bg-[#14151a] border border-zinc-800/40 hover:border-zinc-800/80 transition-all flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-2">
            <h4 class="text-xs font-bold text-zinc-200">${c.name}</h4>
            <span class="text-[10px] font-semibold text-zinc-500 mono">${c.credits} CREDITS</span>
          </div>
          <p class="text-[11px] text-zinc-400"><span class="text-zinc-600">评定:</span> ${c.formula || '未录入'}</p>
        </div>
        ${ddlHtml}
        <div class="flex justify-end gap-2 mt-4 pt-2 border-t border-zinc-800/20">
          <button class="delete-course-btn text-[10px] text-zinc-600 hover:text-rose-400/80 transition-all" data-id="${c.id}">删除课程</button>
        </div>
      </div>`;
    });

    grid.querySelectorAll('.delete-course-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget).getAttribute('data-id') || '';
        courses = courses.filter(c => String(c.id) !== id);
        persist();
        renderAll();
      });
    });
  }

  function renderTools() {
    const container = document.getElementById('tools-container');
    if (!container) return;
    container.innerHTML = '';

    const categories = ['学习资源', '实用工具', '社区娱乐'];
    categories.forEach(cat => {
      const catTools = tools.filter((t) => t.category === cat);
      if (catTools.length === 0) return;

      let html = `<div class="p-5 rounded-lg bg-[#14151a] border border-zinc-800/40 space-y-3"><h4 class="text-[10px] font-semibold text-zinc-500 uppercase tracking-widest pb-1.5 border-b border-zinc-800/30">${cat}</h4><div class="space-y-1.5">`;

      catTools.forEach((t) => {
        html += `<div class="flex items-center justify-between p-2 rounded hover:bg-zinc-800/20 transition-all"><a href="${t.url}" target="_blank" rel="noopener" class="text-xs text-zinc-400 hover:text-zinc-200 transition-colors truncate">${t.name}</a><button class="delete-tool-btn text-zinc-700 hover:text-zinc-500 transition-all" data-id="${t.id}"><i data-lucide="minus-circle" class="w-3.5 h-3.5"></i></button></div>`;
      });

      html += '</div></div>';
      container.innerHTML += html;
    });

    container.querySelectorAll('.delete-tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget).getAttribute('data-id') || '';
        tools = tools.filter((t) => String(t.id) !== id);
        persist();
        renderAll();
      });
    });
  }

  // ── Init ──
  document.addEventListener('DOMContentLoaded', () => {
    updateTime();
    setInterval(updateTime, 1000);
    renderAll();

    // Hash-based tab restore
    const hash = window.location.hash.slice(1);
    const validTabs = ['dashboard', 'calendar', 'courses', 'tools'];
    if (validTabs.includes(hash)) {
      const btn = document.querySelector(`[data-tab="${hash}"]`);
      if (btn) btn.click();
    }

    // Tab switching
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetTab = (e.currentTarget).getAttribute('data-tab') || 'dashboard';

        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        document.getElementById('tab-' + targetTab)?.classList.remove('hidden');

        document.querySelectorAll('.nav-btn').forEach(b => {
          b.classList.remove('bg-zinc-800/40', 'text-zinc-100');
          b.classList.add('text-zinc-400');
          const i = b.querySelector('i');
          if (i) i.classList.remove('text-sky-400');
        });

        const activeBtn = document.getElementById('nav-' + targetTab);
        if (activeBtn) {
          activeBtn.classList.add('bg-zinc-800/40', 'text-zinc-100');
          const i = activeBtn.querySelector('i');
          if (i) i.classList.add('text-sky-400');
        }

        const titles = { dashboard: '控制面板', calendar: '日程倒计时', courses: '课程管理', tools: '快捷工具' };
        const pageTitle = document.getElementById('page-title');
        if (pageTitle) pageTitle.innerText = titles[targetTab] || '';
        window.location.hash = targetTab;
      });
    });

    // Event form
    const eventForm = document.getElementById('event-form');
    if (eventForm) {
      eventForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const titleEl = document.getElementById('event-title');
        const dateEl = document.getElementById('event-date');
        const tagEl = document.getElementById('event-tag');
        events.push({ id: Date.now(), title: titleEl.value, date: dateEl.value, tag: tagEl.value });
        persist();
        eventForm.reset();
        renderAll();
      });
    }

    // Modals
    const cModal = document.getElementById('course-modal');
    const tModal = document.getElementById('tool-modal');
    const toggleModal = (modal, show) => {
      if (!modal) return;
      if (show) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
      else { modal.classList.remove('flex'); modal.classList.add('hidden'); }
    };

    document.getElementById('add-course-btn')?.addEventListener('click', () => toggleModal(cModal, true));
    document.getElementById('close-course-modal')?.addEventListener('click', () => toggleModal(cModal, false));
    document.getElementById('cancel-course-btn')?.addEventListener('click', () => toggleModal(cModal, false));

    document.getElementById('add-tool-btn')?.addEventListener('click', () => toggleModal(tModal, true));
    document.getElementById('close-tool-modal')?.addEventListener('click', () => toggleModal(tModal, false));
    document.getElementById('cancel-tool-btn')?.addEventListener('click', () => toggleModal(tModal, false));

    // Course form
    document.getElementById('course-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('course-name')).value;
      const credits = parseInt((document.getElementById('course-credits')).value);
      const formula = (document.getElementById('course-formula')).value;
      const ddlTitle = (document.getElementById('course-ddl-name')).value;
      const ddlDate = (document.getElementById('course-ddl-date')).value;

      courses.push({ id: Date.now(), name, credits, formula, ddlTitle, ddlDate });

      if (ddlTitle && ddlDate) {
        events.push({ id: Date.now() + 1, title: `[${name}] ${ddlTitle}`, date: ddlDate, tag: 'course' });
      }

      persist();
      toggleModal(cModal, false);
      (e.target).reset();
      renderAll();
    });

    // Tool form
    document.getElementById('tool-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('tool-name')).value;
      const url = (document.getElementById('tool-url')).value;
      const category = (document.getElementById('tool-category')).value;
      tools.push({ id: Date.now(), name, url, category });
      persist();
      toggleModal(tModal, false);
      (e.target).reset();
      renderAll();
    });
  });
</script>
