---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Modals from '../components/Modals.astro';
---

<Layout>
  <div class="flex h-screen overflow-hidden">
    <Sidebar />
    <main class="flex-1 flex flex-col overflow-hidden">
      <!-- Header -->
      <header class="h-16 flex items-center justify-between px-8 border-b border-zinc-800/40 flex-shrink-0">
        <h1 class="text-sm font-medium text-zinc-500 tracking-wide" id="tab-title">控制面板</h1>
        <div class="flex items-center gap-5">
          <span class="text-xs text-zinc-500" id="current-date"></span>
          <span class="font-mono text-sm text-zinc-200 tabular-nums tracking-wider" id="clock">00:00:00</span>
        </div>
      </header>

      <!-- Tab Content -->
      <div class="flex-1 overflow-y-auto p-8">

        <!-- ====== Tab 1: Dashboard ====== -->
        <div id="tab-dashboard" class="tab-pane space-y-8">
          <!-- Semester Progress -->
          <div class="bg-[#14151a] border border-zinc-800/40 rounded-xl p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-zinc-500 uppercase tracking-wider">学期进度</span>
              <span class="font-mono text-xs text-zinc-600" id="semester-label">Week ? / ?</span>
            </div>
            <div class="h-1 bg-[#1b1c23] rounded-full overflow-hidden">
              <div class="progress-fill h-full bg-sky-400/60 rounded-full" id="semester-bar" style="width:0%"></div>
            </div>
            <div class="flex justify-between mt-3">
              <span class="text-xs text-zinc-500" id="semester-elapsed">已用 ? 天</span>
              <span class="text-xs text-zinc-600" id="semester-remaining">剩余 ? 天</span>
            </div>
          </div>

          <!-- Two Column -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Upcoming Deadlines -->
            <div class="bg-[#14151a] border border-zinc-800/40 rounded-xl p-6">
              <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-5">临近倒计时</h3>
              <div id="upcoming-deadlines" class="space-y-4">
                <p class="text-sm text-zinc-600">暂无日程</p>
              </div>
            </div>
            <!-- Quick Links -->
            <div class="bg-[#14151a] border border-zinc-800/40 rounded-xl p-6">
              <div class="flex items-center justify-between mb-5">
                <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">快速导航</h3>
                <button onclick="openModal('modal-quicklink')" class="text-xs text-sky-400/70 hover:text-sky-400 transition-colors">
                  <i data-lucide="plus" class="w-3.5 h-3.5 inline"></i>
                  新增
                </button>
              </div>
              <div id="quick-links" class="grid grid-cols-2 gap-3">
                <p class="text-sm text-zinc-600 col-span-2">暂无链接</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ====== Tab 2: Calendar ====== -->
        <div id="tab-calendar" class="tab-pane hidden">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Add Event Form -->
            <div class="bg-[#14151a] border border-zinc-800/40 rounded-xl p-6">
              <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-5">新增日程</h3>
              <form id="form-event-inline" class="space-y-4">
                <div>
                  <label class="block text-xs font-medium text-zinc-500 mb-1.5">事件名称</label>
                  <input type="text" name="name" required placeholder="例如：机器学习期末答辩"
                    class="w-full bg-[#1b1c23] border border-zinc-800/40 rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-sky-400/50 transition-colors" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-zinc-500 mb-1.5">截止时间</label>
                  <input type="datetime-local" name="deadline" required
                    class="w-full bg-[#1b1c23] border border-zinc-800/40 rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-400/50 transition-colors" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-zinc-500 mb-1.5">类别</label>
                  <select name="category"
                    class="w-full bg-[#1b1c23] border border-zinc-800/40 rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-400/50 transition-colors">
                    <option value="作业">作业</option>
                    <option value="pre">pre</option>
                    <option value="考试">考试</option>
                    <option value="个人">个人</option>
                  </select>
                </div>
                <button type="submit"
                  class="w-full py-2 rounded-lg bg-sky-400/10 border border-sky-400/30 text-sm text-sky-400 hover:bg-sky-400/20 transition-colors">
                  添加日程
                </button>
              </form>
            </div>
            <!-- Events Timeline -->
            <div class="lg:col-span-2 bg-[#14151a] border border-zinc-800/40 rounded-xl p-6">
              <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-5">全部日程</h3>
              <div id="events-list" class="space-y-3">
                <p class="text-sm text-zinc-600">暂无日程</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ====== Tab 3: Courses ====== -->
        <div id="tab-courses" class="tab-pane hidden space-y-6">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">在研课程</h3>
            <button onclick="openModal('modal-course')" class="text-xs text-sky-400/70 hover:text-sky-400 transition-colors">
              <i data-lucide="plus" class="w-3.5 h-3.5 inline"></i>
              注册课程
            </button>
          </div>
          <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            <p class="text-sm text-zinc-600">暂无课程</p>
          </div>
        </div>

        <!-- ====== Tab 4: Tools ====== -->
        <div id="tab-tools" class="tab-pane hidden space-y-8">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">常用工具</h3>
            <button onclick="openModal('modal-tool')" class="text-xs text-sky-400/70 hover:text-sky-400 transition-colors">
              <i data-lucide="plus" class="w-3.5 h-3.5 inline"></i>
              新增
            </button>
          </div>
          <div id="tools-sections"></div>
        </div>

      </div>
    </main>
    <Modals />
  </div>

  <script>
    declare const lucide: { createIcons: () => void };
    // ============================================================
    // DATA LAYER
    // ============================================================
    const KEYS = {
      events: 'wd_events',
      courses: 'wd_courses',
      quickLinks: 'wd_quick_links',
      toolLinks: 'wd_tool_links',
    };

    const SEMESTER = { start: new Date('2026-02-17'), end: new Date('2026-06-20'), totalWeeks: 18 };

    const CATEGORY_COLORS: Record<string, string> = {
      '作业': 'bg-sky-400/20 text-sky-400',
      'pre': 'bg-emerald-400/20 text-emerald-400',
      '考试': 'bg-amber-400/20 text-amber-400',
      '个人': 'bg-violet-400/20 text-violet-400',
    };

    const TOOL_CATEGORIES = ['学习资源', '实用工具', '其他资源'];

    function generateId() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }

    function load(key: string) {
      try { return JSON.parse(localStorage.getItem(key) || '[]'); }
      catch { return []; }
    }

    function save(key: string, data: any) {
      localStorage.setItem(key, JSON.stringify(data));
    }

    // ============================================================
    // DEMO DATA
    // ============================================================
    const DATA_VERSION = 3;

    function initDemoDataIfEmpty() {
      const storedVersion = parseInt(localStorage.getItem('wd_version') || '0');
      if (storedVersion < DATA_VERSION) {
        localStorage.removeItem(KEYS.courses);
        localStorage.removeItem(KEYS.events);
        localStorage.setItem('wd_version', String(DATA_VERSION));
      }
      if (load(KEYS.events).length === 0) {
        save(KEYS.events, [
          { id: generateId(), name: '机器学习期末大作业', deadline: '2026-06-15T23:59', category: 'pre' },
          { id: generateId(), name: '高等数值分析期中考试', deadline: '2026-04-20T14:00', category: '考试' },
          { id: generateId(), name: '论文综述提交', deadline: '2026-05-10T17:00', category: '作业' },
          { id: generateId(), name: '个人项目里程碑', deadline: '2026-05-30T09:00', category: '个人' },
        ]);
      }
      if (load(KEYS.courses).length === 0) {
        save(KEYS.courses, [
          { id: generateId(), name: '高等数学(B)下', credits: 5, components: [
            { name: '平时作业', weight: 20 }, { name: '期中考试', weight: 20 }, { name: '期末考试', weight: 60 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '2026-06-24T13:30', finalExamLocation: '南114' },
          { id: generateId(), name: '大学物理(精)I下', credits: 3, components: [
            { name: '平时作业', weight: 20 }, { name: '期中考试', weight: 20 }, { name: '期末考试', weight: 60 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '2026-06-22T13:30', finalExamLocation: '北215' },
          { id: generateId(), name: '电路理论', credits: 4, components: [
            { name: '平时作业', weight: 20 }, { name: '实验报告', weight: 20 }, { name: '期末考试', weight: 60 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '2026-06-25T13:30', finalExamLocation: '北312' },
          { id: generateId(), name: '中国近现代史纲要', credits: 3, components: [
            { name: '平时表现', weight: 30 }, { name: '期末考试', weight: 70 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '2026-06-22T10:30', finalExamLocation: '北229' },
          { id: generateId(), name: '高级语言程序设计', credits: 2, components: [
            { name: '平时作业', weight: 30 }, { name: '期末考试', weight: 70 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '2026-06-23T08:00', finalExamLocation: '四平公共机房' },
          { id: generateId(), name: '高级语言程序设计实验', credits: 1, components: [
            { name: '实验报告', weight: 60 }, { name: '期末考核', weight: 40 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '大学物理实验（下）', credits: 1, components: [
            { name: '实验操作', weight: 50 }, { name: '实验报告', weight: 50 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '跨文化交际', credits: 2, components: [
            { name: '课堂参与', weight: 30 }, { name: '平时作业', weight: 30 }, { name: '期末考核', weight: 40 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '体育(2)', credits: 1, components: [
            { name: '课堂表现', weight: 80 }, { name: '期末测试', weight: 20 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '孙子兵法及其应用', credits: 1.5, components: [
            { name: '平时表现', weight: 40 }, { name: '期末论文', weight: 60 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '人工智能科学与技术创新实践', credits: 0.5, components: [
            { name: '实践操作', weight: 100 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '人工智能科学与技术(信息与智能网联类)', credits: 1.5, components: [
            { name: '课堂表现', weight: 30 }, { name: '期末考核', weight: 70 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '奇妙的微观世界与人类健康', credits: 1.5, components: [
            { name: '课堂参与', weight: 30 }, { name: '期末考核', weight: 70 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '四史新讲', credits: 0, components: [
            { name: '考勤', weight: 50 }, { name: '心得报告', weight: 50 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
          { id: generateId(), name: '形势与政策(2)', credits: 0.5, components: [
            { name: '考勤', weight: 50 }, { name: '期末报告', weight: 50 },
          ], projectName: '', projectDeadline: '', finalExamDeadline: '' },
        ]);
      }
      if (load(KEYS.quickLinks).length === 0) {
        save(KEYS.quickLinks, [
          { name: 'GitHub', url: 'https://github.com' },
          { name: 'Google Scholar', url: 'https://scholar.google.com' },
          { name: 'arXiv', url: 'https://arxiv.org' },
          { name: 'Overleaf', url: 'https://overleaf.com' },
        ]);
      }
      if (load(KEYS.toolLinks).length === 0) {
        save(KEYS.toolLinks, [
          { id: generateId(), name: 'arXiv', url: 'https://arxiv.org', category: '学习资源' },
          { id: generateId(), name: 'Papers With Code', url: 'https://paperswithcode.com', category: '学习资源' },
          { id: generateId(), name: 'Google Scholar', url: 'https://scholar.google.com', category: '学习资源' },
          { id: generateId(), name: 'ChatGPT', url: 'https://chat.openai.com', category: '实用工具' },
          { id: generateId(), name: 'DeepL', url: 'https://www.deepl.com/translator', category: '实用工具' },
          { id: generateId(), name: 'Overleaf', url: 'https://overleaf.com', category: '实用工具' },
          { id: generateId(), name: 'GitHub', url: 'https://github.com', category: '其他资源' },
        ]);
      }
    }

    // ============================================================
    // CLOCK
    // ============================================================
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('clock');
      const dateEl = document.getElementById('current-date');
      if (el) el.textContent = now.toLocaleTimeString('zh-CN', { hour12: false });
      if (dateEl) {
        dateEl.textContent = now.toLocaleDateString('zh-CN', {
          year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short',
        });
      }
    }

    // ============================================================
    // COUNTDOWN FORMATTER
    // ============================================================
    function formatCountdown(deadline: string): { text: string; expired: boolean } {
      const diff = new Date(deadline).getTime() - Date.now();
      if (diff <= 0) return { text: '已到期', expired: true };
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      if (d > 0) return { text: `${d}<span class="text-zinc-500 mx-0.5">天</span>${h}<span class="text-zinc-500 mx-0.5">小时</span>`, expired: false };
      if (h > 0) return { text: `${h}<span class="text-zinc-500 mx-0.5">小时</span>${m}<span class="text-zinc-500 mx-0.5">分钟</span>`, expired: false };
      return { text: `${m}<span class="text-zinc-500 mx-0.5">分钟</span>`, expired: false };
    }

    // ============================================================
    // TAB SWITCHING
    // ============================================================
    function switchTab(tab: string) {
      document.querySelectorAll('.sidebar-btn').forEach(btn => {
        const isActive = (btn as HTMLElement).dataset.tab === tab;
        btn.classList.toggle('active', isActive);
        if (isActive) {
          (btn as HTMLElement).style.cssText = 'color:#e4e4e7;background:#1b1c23;border-left-color:#38bdf8;';
        } else {
          (btn as HTMLElement).style.cssText = '';
        }
      });
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
      const pane = document.getElementById('tab-' + tab);
      if (pane) pane.classList.remove('hidden');
      const titleEl = document.getElementById('tab-title');
      if (titleEl) titleEl.textContent = (window as any).__TAB_TITLES?.[tab] || tab;
    }

    (window as any).__TAB_TITLES = { dashboard: '控制面板', calendar: '日程与倒计时', courses: '课程管理', tools: '常用工具' };

    // ============================================================
    // MODAL MANAGEMENT
    // ============================================================
    function openModal(id: string) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
    }

    function closeModal(id: string) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
      const form = el?.querySelector('form');
      if (form) form.reset();
      if (id === 'modal-course') {
        const titleEl = document.getElementById('modal-course-title');
        if (titleEl) titleEl.textContent = '注册新课程';
        clearComponentRows();
        addComponentRow('', 0);
        addComponentRow('', 0);
        updateWeightTotal();
      }
    }

    function closeAllModals() {
      document.querySelectorAll('[id^="modal-"]').forEach(m => m.classList.add('hidden'));
    }

    // ============================================================
    // SEMESTER PROGRESS
    // ============================================================
    function renderSemesterProgress() {
      const now = Date.now();
      const start = SEMESTER.start.getTime();
      const end = SEMESTER.end.getTime();
      const totalDays = Math.ceil((end - start) / 86400000);
      const elapsed = Math.max(0, Math.floor((now - start) / 86400000));
      const remaining = Math.max(0, Math.ceil((end - now) / 86400000));
      const week = Math.min(SEMESTER.totalWeeks, Math.max(1, Math.ceil((now - start) / (7 * 86400000))));
      const pct = Math.min(100, Math.max(0, (elapsed / totalDays) * 100));

      const barEl = document.getElementById('semester-bar');
      if (barEl) barEl.style.width = pct.toFixed(1) + '%';
      const labelEl = document.getElementById('semester-label');
      if (labelEl) labelEl.textContent = `Week ${week} / ${SEMESTER.totalWeeks}`;
      const elapsedEl = document.getElementById('semester-elapsed');
      if (elapsedEl) elapsedEl.textContent = `已用 ${elapsed} 天`;
      const remEl = document.getElementById('semester-remaining');
      if (remEl) remEl.textContent = `剩余 ${remaining} 天`;
    }

    // ============================================================
    // EVENTS RENDERING
    // ============================================================
    function renderEvents() {
      const events = load(KEYS.events);
      events.sort((a: any, b: any) => new Date(a.deadline).getTime() - new Date(b.deadline).getTime());

      // Update upcoming deadlines on dashboard
      const upcomingContainer = document.getElementById('upcoming-deadlines');
      if (upcomingContainer) {
        const upcoming = events.slice(0, 3);
        if (upcoming.length === 0) {
          upcomingContainer.innerHTML = '<p class="text-sm text-zinc-600">暂无日程</p>';
        } else {
          upcomingContainer.innerHTML = upcoming.map((e: any) => {
            const cd = formatCountdown(e.deadline);
            return `
              <div class="flex items-center justify-between py-2 border-b border-zinc-800/30 last:border-0">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="text-[10px] px-1.5 py-0.5 rounded font-medium ${CATEGORY_COLORS[e.category] || 'text-zinc-500'} flex-shrink-0">${e.category}</span>
                  <span class="text-sm text-zinc-300 truncate">${e.name}</span>
                </div>
                <span class="font-mono text-xs ${cd.expired ? 'text-rose-500/60' : 'text-zinc-400'} flex-shrink-0 ml-3">${cd.text}</span>
              </div>`;
          }).join('');
        }
      }

      // Update events list on calendar tab
      const listContainer = document.getElementById('events-list');
      if (listContainer) {
        if (events.length === 0) {
          listContainer.innerHTML = '<p class="text-sm text-zinc-600">暂无日程</p>';
        } else {
          listContainer.innerHTML = events.map((e: any) => {
            const cd = formatCountdown(e.deadline);
            const d = new Date(e.deadline);
            const dateStr = d.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
            const timeStr = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
            return `
              <div class="flex items-center justify-between py-3 px-4 bg-[#1b1c23] rounded-lg group">
                <div class="flex items-center gap-4 min-w-0">
                  <div class="text-center flex-shrink-0 w-12">
                    <div class="font-mono text-xs text-zinc-500">${dateStr}</div>
                    <div class="font-mono text-[10px] text-zinc-600">${timeStr}</div>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm text-zinc-300 truncate">${e.name}</div>
                    <span class="text-[10px] px-1.5 py-0.5 rounded font-medium ${CATEGORY_COLORS[e.category] || 'text-zinc-500'}">${e.category}</span>
                  </div>
                </div>
                <div class="flex items-center gap-3 flex-shrink-0 ml-3">
                  <span class="font-mono text-xs ${cd.expired ? 'text-rose-500/60' : 'text-zinc-400'}">${cd.text}</span>
                  <button onclick="deleteEvent('${e.id}')" class="text-zinc-700 hover:text-rose-500/60 transition-colors opacity-0 group-hover:opacity-100">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  </button>
                </div>
              </div>`;
          }).join('');
        }
      }
      lucide.createIcons();
    }

    function addEvent(data: { name: string; deadline: string; category: string }) {
      const events = load(KEYS.events);
      events.push({ id: generateId(), ...data });
      save(KEYS.events, events);
      renderEvents();
    }

    function deleteEvent(id: string) {
      const events = load(KEYS.events).filter((e: any) => e.id !== id);
      save(KEYS.events, events);
      renderEvents();
    }

    (window as any).deleteEvent = deleteEvent;

    // ============================================================
    // QUICK LINKS RENDERING
    // ============================================================
    function renderQuickLinks() {
      const links = load(KEYS.quickLinks);
      const container = document.getElementById('quick-links');
      if (!container) return;
      if (links.length === 0) {
        container.innerHTML = '<p class="text-sm text-zinc-600 col-span-2">暂无链接</p>';
        return;
      }
      container.innerHTML = links.map((l: any, i: number) => `
        <a href="${l.url}" target="_blank" rel="noopener"
          class="flex items-center justify-between p-3 bg-[#1b1c23] border border-zinc-800/40 rounded-lg hover:border-sky-400/30 transition-colors group no-underline">
          <span class="text-sm text-zinc-300 group-hover:text-zinc-200 truncate">${l.name}</span>
          <button onclick="event.preventDefault();removeQuickLink(${i})" class="text-zinc-700 hover:text-rose-500/60 transition-colors opacity-0 group-hover:opacity-100 flex-shrink-0 ml-2">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </a>
      `).join('');
      lucide.createIcons();
    }

    function removeQuickLink(index: number) {
      const links = load(KEYS.quickLinks);
      links.splice(index, 1);
      save(KEYS.quickLinks, links);
      renderQuickLinks();
    }

    (window as any).removeQuickLink = removeQuickLink;

    // ============================================================
    // COURSES RENDERING
    // ============================================================
    function migrateCourses() {
      const courses = load(KEYS.courses);
      let changed = false;
      for (const c of courses) {
        if (!Array.isArray(c.components)) {
          c.components = [];
          if (typeof c.midtermWeight === 'number' && c.midtermWeight > 0) {
            c.components.push({ name: '平时', weight: c.midtermWeight });
          }
          if (typeof c.finalWeight === 'number' && c.finalWeight > 0) {
            c.components.push({ name: '期末', weight: c.finalWeight });
          }
          delete c.midtermWeight;
          delete c.finalWeight;
          changed = true;
        }
      }
      if (changed) save(KEYS.courses, courses);
    }

    function addComponentRow(name: string = '', weight: number = 0) {
      const container = document.getElementById('components-container');
      if (!container) return;
      const empty = document.getElementById('components-empty');
      if (empty) empty.style.display = 'none';

      const row = document.createElement('div');
      row.className = 'component-row flex items-center gap-2';
      row.innerHTML =
        `<input type="text" name="compName" value="${name.replace(/"/g, '&quot;')}" placeholder="例如：平时作业"
          class="flex-1 bg-[#1b1c23] border border-zinc-800/40 rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-sky-400/50 transition-colors" />
        <input type="number" name="compWeight" min="0" max="100" value="${weight || ''}" placeholder="0"
          class="w-16 bg-[#1b1c23] border border-zinc-800/40 rounded-lg px-2 py-2 text-sm text-zinc-200 text-center focus:outline-none focus:border-sky-400/50 transition-colors" />
        <span class="text-xs text-zinc-500 flex-shrink-0">%</span>
        <button type="button" class="btn-remove-component text-zinc-600 hover:text-rose-500/60 transition-colors p-1 flex-shrink-0"
          onclick="removeComponentRow(this)">
          <i data-lucide="x" class="w-3.5 h-3.5"></i>
        </button>`;
      container.appendChild(row);
      lucide.createIcons();
    }

    function removeComponentRow(btn: HTMLElement) {
      const row = btn.closest('.component-row');
      if (row) row.remove();
      const container = document.getElementById('components-container');
      const empty = document.getElementById('components-empty');
      if (container && empty && container.querySelectorAll('.component-row').length === 0) {
        empty.style.display = '';
      }
      updateWeightTotal();
    }

    function clearComponentRows() {
      const container = document.getElementById('components-container');
      if (!container) return;
      container.querySelectorAll('.component-row').forEach(r => r.remove());
      const empty = document.getElementById('components-empty');
      if (empty) empty.style.display = '';
    }

    function updateWeightTotal() {
      const container = document.getElementById('components-container');
      const totalEl = document.getElementById('weight-total');
      if (!container || !totalEl) return;
      let total = 0;
      container.querySelectorAll('[name="compWeight"]').forEach(inp => {
        total += parseInt((inp as HTMLInputElement).value) || 0;
      });
      totalEl.textContent = `合计: ${total}%`;
      if (total === 100) {
        totalEl.className = 'text-[10px] text-emerald-500';
      } else if (total > 0) {
        totalEl.className = 'text-[10px] text-amber-500';
      } else {
        totalEl.className = 'text-[10px] text-zinc-500';
      }
    }

    (window as any).removeComponentRow = removeComponentRow;
    function renderCourses() {
      const courses = load(KEYS.courses);
      const container = document.getElementById('courses-grid');
      if (!container) return;
      if (courses.length === 0) {
        container.innerHTML = '<p class="text-sm text-zinc-600">暂无课程</p>';
        return;
      }
      container.innerHTML = courses.map((c: any) => {
        let deadlinesHtml = '';
        if (c.projectName && c.projectDeadline) {
          const cd = formatCountdown(c.projectDeadline);
          deadlinesHtml += `
            <div class="flex items-center justify-between mt-1">
              <span class="text-xs text-zinc-500 truncate">${c.projectName}</span>
              <span class="font-mono text-xs ${cd.expired ? 'text-rose-500/60' : 'text-zinc-400'} flex-shrink-0 ml-2">${cd.text}</span>
            </div>`;
        }
        if (c.finalExamDeadline) {
          const cd = formatCountdown(c.finalExamDeadline);
          const d = new Date(c.finalExamDeadline);
          const dateStr = d.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
          const timeStr = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
          const locStr = c.finalExamLocation ? `<span class="text-zinc-600 mx-1">${c.finalExamLocation}</span>` : '';
          deadlinesHtml += `
            <div class="flex items-center justify-between mt-1">
              <span class="text-xs text-zinc-500 truncate">期末考试 <span class="font-mono text-zinc-500">${dateStr} ${timeStr}</span>${locStr}</span>
              <span class="font-mono text-xs ${cd.expired ? 'text-rose-500/60' : 'text-zinc-400'} flex-shrink-0 ml-2">${cd.text}</span>
            </div>`;
        }
        if (deadlinesHtml) {
          deadlinesHtml = `<div class="mt-3 pt-3 border-t border-zinc-800/30">${deadlinesHtml}</div>`;
        }
        return `
          <div class="bg-[#14151a] border border-zinc-800/40 rounded-xl p-5 hover:border-zinc-700/50 transition-colors group relative">
            <div class="absolute top-3 right-3 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              <button onclick="editCourse('${c.id}')" class="text-zinc-600 hover:text-sky-400 transition-colors p-0.5">
                <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
              </button>
              <button onclick="deleteCourse('${c.id}')" class="text-zinc-600 hover:text-rose-500/60 transition-colors p-0.5">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              </button>
            </div>
            <h4 class="text-sm font-medium text-zinc-200 mb-3 pr-6 truncate">${c.name}</h4>
            <div class="flex items-center gap-4 text-xs text-zinc-500 mb-2">
              <span>${c.credits} 学分</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-1">
              ${(c.components || []).map((comp: any) =>
                `<span class="text-[10px] px-1.5 py-0.5 rounded bg-[#1b1c23] text-zinc-400 border border-zinc-800/40">${comp.name} ${comp.weight}%</span>`
              ).join('')}
            </div>
            ${deadlinesHtml}
          </div>`;
      }).join('');
      lucide.createIcons();
    }

    function addCourse(data: any) {
      const courses = load(KEYS.courses);
      const course = { id: generateId(), ...data };
      courses.push(course);
      save(KEYS.courses, courses);

      const events = load(KEYS.events);
      if (data.projectName && data.projectDeadline) {
        events.push({
          id: generateId(),
          name: `${data.name} · ${data.projectName}`,
          deadline: data.projectDeadline,
          category: 'pre',
        });
      }
      if (data.finalExamDeadline) {
        events.push({
          id: generateId(),
          name: `${data.name} · 期末考试`,
          deadline: data.finalExamDeadline,
          category: '考试',
        });
      }
      save(KEYS.events, events);
      renderEvents();
      renderCourses();
    }

    function deleteCourse(id: string) {
      const courses = load(KEYS.courses).filter((c: any) => c.id !== id);
      save(KEYS.courses, courses);
      renderCourses();
    }

    function editCourse(id: string) {
      const courses = load(KEYS.courses);
      const course = courses.find((c: any) => c.id === id);
      if (!course) return;
      const form = document.getElementById('form-course') as HTMLFormElement;
      if (!form) return;
      (form.querySelector('[name="editId"]') as HTMLInputElement).value = course.id;
      (form.querySelector('[name="name"]') as HTMLInputElement).value = course.name || '';
      (form.querySelector('[name="credits"]') as HTMLInputElement).value = String(course.credits ?? 3);
      (form.querySelector('[name="projectName"]') as HTMLInputElement).value = course.projectName || '';
      (form.querySelector('[name="projectDeadline"]') as HTMLInputElement).value = course.projectDeadline || '';
      (form.querySelector('[name="finalExamDeadline"]') as HTMLInputElement).value = course.finalExamDeadline || '';
      (form.querySelector('[name="finalExamLocation"]') as HTMLInputElement).value = course.finalExamLocation || '';

      clearComponentRows();
      const comps = course.components || [];
      if (comps.length > 0) {
        comps.forEach((c: any) => addComponentRow(c.name, c.weight));
      } else {
        addComponentRow('', 0);
        addComponentRow('', 0);
      }
      updateWeightTotal();

      const titleEl = document.getElementById('modal-course-title');
      if (titleEl) titleEl.textContent = '编辑课程';
      openModal('modal-course');
    }

    (window as any).deleteCourse = deleteCourse;
    (window as any).editCourse = editCourse;

    // ============================================================
    // TOOL LINKS RENDERING
    // ============================================================
    function renderToolLinks() {
      const links = load(KEYS.toolLinks);
      const container = document.getElementById('tools-sections');
      if (!container) return;

      container.innerHTML = TOOL_CATEGORIES.map(cat => {
        const items = links.filter((l: any) => l.category === cat);
        if (items.length === 0) return '';
        return `
          <div class="mb-6">
            <h4 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-3">${cat}</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
              ${items.map((l: any) => `
                <a href="${l.url}" target="_blank" rel="noopener"
                  class="flex items-center justify-between p-3 bg-[#14151a] border border-zinc-800/40 rounded-lg hover:border-sky-400/30 transition-colors group no-underline">
                  <span class="text-sm text-zinc-300 group-hover:text-zinc-200 truncate">${l.name}</span>
                  <button onclick="event.preventDefault();deleteToolLink('${l.id}')"
                    class="text-zinc-700 hover:text-rose-500/60 transition-colors opacity-0 group-hover:opacity-100 flex-shrink-0 ml-2">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                  </button>
                </a>
              `).join('')}
            </div>
          </div>`;
      }).filter(Boolean).join('') || '<p class="text-sm text-zinc-600">暂无工具链接</p>';
      lucide.createIcons();
    }

    function addToolLink(data: { name: string; url: string; category: string }) {
      const links = load(KEYS.toolLinks);
      links.push({ id: generateId(), ...data });
      save(KEYS.toolLinks, links);
      renderToolLinks();
    }

    function deleteToolLink(id: string) {
      const links = load(KEYS.toolLinks).filter((l: any) => l.id !== id);
      save(KEYS.toolLinks, links);
      renderToolLinks();
    }

    (window as any).deleteToolLink = deleteToolLink;

    // ============================================================
    // COUNTDOWN TICKER (update all rendered countdowns)
    // ============================================================
    function tickCountdowns() {
      renderEvents();
      renderCourses();
    }

    // ============================================================
    // EVENT LISTENERS SETUP
    // ============================================================
    function setupListeners() {
      // Sidebar tab switching
      document.querySelectorAll('.sidebar-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = (btn as HTMLElement).dataset.tab;
          if (tab) switchTab(tab);
        });
      });

      // Modal backdrop click to close
      document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', () => {
          const modalId = (overlay as HTMLElement).dataset.close;
          if (modalId) closeModal(modalId);
        });
      });

      // Modal cancel buttons
      document.querySelectorAll('[data-close]').forEach(el => {
        if (el.classList.contains('modal-overlay')) return;
        el.addEventListener('click', () => {
          const modalId = (el as HTMLElement).dataset.close;
          if (modalId) closeModal(modalId);
        });
      });

      // Escape key to close all modals
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllModals();
      });

      // Inline event form (calendar tab)
      const formEventInline = document.getElementById('form-event-inline') as HTMLFormElement;
      if (formEventInline) {
        formEventInline.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formEventInline);
          addEvent({
            name: fd.get('name') as string,
            deadline: fd.get('deadline') as string,
            category: fd.get('category') as string,
          });
          formEventInline.reset();
        });
      }

      // Modal event form
      const formEvent = document.getElementById('form-event') as HTMLFormElement;
      if (formEvent) {
        formEvent.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formEvent);
          addEvent({
            name: fd.get('name') as string,
            deadline: fd.get('deadline') as string,
            category: fd.get('category') as string,
          });
          closeModal('modal-event');
        });
      }

      // Modal course form
      const formCourse = document.getElementById('form-course') as HTMLFormElement;
      if (formCourse) {
        formCourse.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formCourse);
          const editId = (fd.get('editId') as string)?.trim();

          const components: {name: string, weight: number}[] = [];
          document.querySelectorAll('#components-container .component-row').forEach(row => {
            const nameInput = row.querySelector('[name="compName"]') as HTMLInputElement;
            const weightInput = row.querySelector('[name="compWeight"]') as HTMLInputElement;
            const name = nameInput?.value?.trim();
            const weight = parseInt(weightInput?.value) || 0;
            if (name && weight > 0) {
              components.push({ name, weight });
            }
          });

          const data: any = {
            name: fd.get('name') as string,
            credits: parseInt(fd.get('credits') as string) || 3,
            components,
            projectName: fd.get('projectName') as string,
            projectDeadline: fd.get('projectDeadline') as string,
            finalExamDeadline: fd.get('finalExamDeadline') as string,
            finalExamLocation: fd.get('finalExamLocation') as string,
          };

          if (editId) {
            // Edit existing course
            const courses = load(KEYS.courses);
            const oldCourse = courses.find((c: any) => c.id === editId);
            const idx = courses.findIndex((c: any) => c.id === editId);
            if (idx !== -1) {
              courses[idx] = { ...courses[idx], ...data };
              save(KEYS.courses, courses);

              // Remove old linked DDLs
              let events = load(KEYS.events);
              if (oldCourse && oldCourse.projectName && oldCourse.projectDeadline) {
                const oldName = `${oldCourse.name} · ${oldCourse.projectName}`;
                events = events.filter((ev: any) =>
                  !(ev.name === oldName && ev.deadline === oldCourse.projectDeadline)
                );
              }
              if (oldCourse && oldCourse.finalExamDeadline) {
                const oldName = `${oldCourse.name} · 期末考试`;
                events = events.filter((ev: any) =>
                  !(ev.name === oldName && ev.deadline === oldCourse.finalExamDeadline)
                );
              }
              save(KEYS.events, events);

              // Create new linked DDLs
              if (data.projectName && data.projectDeadline) {
                events.push({
                  id: generateId(),
                  name: `${data.name} · ${data.projectName}`,
                  deadline: data.projectDeadline,
                  category: 'pre',
                });
              }
              if (data.finalExamDeadline) {
                events.push({
                  id: generateId(),
                  name: `${data.name} · 期末考试`,
                  deadline: data.finalExamDeadline,
                  category: '考试',
                });
              }
              save(KEYS.events, events);
              renderEvents();
            }
          } else {
            addCourse(data);
          }

          closeModal('modal-course');
        });
      }

      // Modal quick link form
      const formQuickLink = document.getElementById('form-quicklink') as HTMLFormElement;
      if (formQuickLink) {
        formQuickLink.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formQuickLink);
          const links = load(KEYS.quickLinks);
          links.push({
            name: fd.get('name') as string,
            url: fd.get('url') as string,
          });
          save(KEYS.quickLinks, links);
          renderQuickLinks();
          closeModal('modal-quicklink');
        });
      }

      // Add component button
      const btnAddComp = document.getElementById('btn-add-component');
      if (btnAddComp) {
        btnAddComp.addEventListener('click', () => {
          addComponentRow();
          updateWeightTotal();
        });
      }

      // Live weight total update
      const compContainer = document.getElementById('components-container');
      if (compContainer) {
        compContainer.addEventListener('input', (e) => {
          if ((e.target as HTMLElement).getAttribute('name') === 'compWeight') {
            updateWeightTotal();
          }
        });
      }

      // Modal tool form
      const formTool = document.getElementById('form-tool') as HTMLFormElement;
      if (formTool) {
        formTool.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(formTool);
          addToolLink({
            name: fd.get('name') as string,
            url: fd.get('url') as string,
            category: fd.get('category') as string,
          });
          closeModal('modal-tool');
        });
      }
    }

    // Expose to global scope for inline onclick handlers
    (window as any).openModal = openModal;

    // ============================================================
    // INIT
    // ============================================================
    function init() {
      initDemoDataIfEmpty();
      migrateCourses();
      setupListeners();
      updateClock();
      renderSemesterProgress();
      renderEvents();
      renderQuickLinks();
      renderCourses();
      renderToolLinks();

      setInterval(updateClock, 1000);
      setInterval(tickCountdowns, 30000);
      setInterval(renderSemesterProgress, 60000);
    }

    // Wait for DOM and Lucide
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Layout>
