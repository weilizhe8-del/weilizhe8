<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <link rel="canonical" href="https://weilizhe8.com/">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>课间 · 学生工作台</title>
  <link rel="stylesheet" href="desk.css">
  <link rel="stylesheet" href="planner.css">
  <link rel="stylesheet" href="workspace.css">
  <script defer src="catalog.js"></script>
  <script defer src="schedule-data.js"></script>
  <script defer src="desk.js"></script>
  <script defer src="planner.js"></script>
  <script defer src="personal.js"></script>
  <script defer src="backup.js"></script>
  <script defer src="bookmarks.js"></script>
  <script defer src="workspace.js"></script>
  <script is:inline type="module" src="/cloud-sync.js"></script>
</head>
<body>
  <header class="top"><div class="top-inner">
    <a class="brand" href="#overview"><span class="desk-mark" aria-hidden="true"></span>课间<span class="brand-sub">学生工作台</span></a>
    <nav aria-label="主要栏目"><a href="#overview"><svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.6"/><rect x="14" y="3" width="7" height="7" rx="1.6"/><rect x="3" y="14" width="7" height="7" rx="1.6"/><rect x="14" y="14" width="7" height="7" rx="1.6"/></svg>总览</a><a href="#desk"><svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="17" rx="2"/><path d="M8 2v4m8-4v4M4 9h16m-12 6 2.5 2.5L16 12"/></svg>每日计划</a><a href="#calendar"><svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-14 4h2m3 0h2m-7 3h2"/></svg>月历</a><a href="#inbox"><svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14.5 6 5h12l3 9.5V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M3 14h5l2 3h4l2-3h5"/></svg>收件箱</a><a href="#courses"><svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6c-2.5-2-6-2.5-10-1v14c4-1.5 7.5-1 10 1 2.5-2 6-2.5 10-1V5c-4-1.5-7.5-1-10 1Zm0 0v14"/></svg>课程</a><a href="#projects"><svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8V6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8Zm0 2h18"/></svg>项目库</a><a href="#tools"><svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="20" height="12" rx="2"/><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M2 13h20m-12-1v3h4v-3"/></svg>工具架</a></nav>
    <div class="side-group side-projects"><h2>课程与项目</h2><div id="desk-pins"></div></div>
    <div class="side-group side-links"><h2>常用入口</h2><div id="desk-tools"></div></div>
    <span class="term"><i></i> 2026 秋季学期</span>
  </div></header>
  <main>
    <section id="overview" aria-label="工作台总览">
      <header class="overview-head">
        <div><p id="overview-date" class="eyebrow"></p><h1 id="overview-greeting">工作台总览</h1><p id="overview-summary"></p></div>
        <a href="#desk" id="overview-plan" class="desk-primary">进入每日计划 →</a>
      </header>
      <div class="overview-grid">
        <section class="panel panel-today"><div class="panel-head"><h2>今日安排</h2><span id="overview-progress"></span></div><div id="overview-today"></div></section>
        <section class="panel panel-due"><div class="panel-head"><h2>近期作业</h2><span>未来 7 天（含今天）</span></div><div id="overview-due"></div></section>
      </div>
      <section class="overview-platforms"><div class="panel-head"><h2>常用平台</h2><div class="platform-actions"><button class="text-button" id="manage-home-platforms">自定义</button><a class="text-button" href="#tools">工具架 →</a></div></div>
        <div class="platform-links" id="platform-links"></div>
        <button id="more-platforms" class="text-button" aria-controls="platform-links" aria-expanded="false" hidden>展开其余平台</button>
      </section>
      <div class="footnote"><span id="cloud-status" role="status">正在检查账号同步…</span>
        <button id="cloud-retry" class="text-button" type="button">立即同步</button>
        <span id="cloud-conflict" hidden><button id="cloud-local" class="secondary" type="button">冲突项用本机版本</button> <button id="cloud-remote" class="secondary" type="button">冲突项用云端版本</button></span>
      </div>
      <p class="footnote">内置课程排期为示例</p>
    </section>
    <section id="desk" class="workspace" hidden>
      <div class="desk-heading"><div><p id="desk-date"></p><h1>每日计划</h1></div><button class="desk-primary" id="desk-new">＋ 新建安排</button></div>
      <div class="desk-layout">
        <section class="desk-board" aria-label="每日任务看板">
          <div class="board-toolbar"><div class="desk-switch"><a href="#desk" aria-current="page">看板</a><a href="#calendar">月历</a></div><div class="day-controls"><button id="desk-prev" aria-label="前一天">‹</button><button id="desk-today">今天</button><button id="desk-next" aria-label="后一天">›</button></div></div>
          <div id="desk-columns"></div>
        </section>
        <aside class="desk-agenda" aria-labelledby="timeline-day">
          <div class="agenda-heading"><div><p>日程时间轴</p><h2 id="timeline-day"></h2></div><button id="timeline-range" class="range-button" aria-pressed="false" aria-controls="hours">显示全天</button></div>
          <div id="timeline-due"></div>
          <p id="timeline-empty" hidden>当天还没有排好的时段。</p>
          <div id="hour-scroll"><div id="hours"></div></div>
        </aside>
        <section class="desk-backlog" aria-labelledby="backlog-title">
          <div class="later-head"><h2 id="backlog-title">待安排</h2><select id="queue-scope" aria-label="待安排范围"><option value="week">近七天与逾期</option><option value="undated">日期待定</option><option value="all">全部未完成</option></select></div><div id="desk-queue"></div>
        </section>
      </div><p id="desk-message" role="status"></p>
    </section>
    <section id="calendar" hidden>
      <div class="heading"><div><div class="eyebrow"><i></i> <span id="calendar-eyebrow">2026 秋季学期</span></div><h1>学习月历</h1></div><span class="demo">本地演示 · 课程排期为示例</span></div>
      <div class="planner">
        <section class="month-panel panel" aria-label="月份日历">
          <div class="month-bar"><h2 id="month"></h2><div class="month-controls"><button id="prev" aria-label="上个月">‹</button><button id="today">今天</button><button id="next" aria-label="下个月">›</button></div></div>
          <div class="filter-strip"><select id="calendar-filter" aria-label="按课程或项目筛选"></select><div class="legend"><span>● 交付</span><span>● 参加</span><span>● 测验</span><span>● 计划</span></div></div>
          <div class="weekdays" aria-hidden="true"><span class="week-head">周次</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span></div>
          <div id="days" class="days" role="group" aria-label="日期：方向键切换日期，PageUp/PageDown 切换月份"></div>
        </section>
        <aside class="agenda"><section class="panel day-panel"><div class="panel-head"><div class="kicker">当天安排</div><button class="primary" id="new-task" type="button">＋ 新建</button></div><h2 id="agenda-title"></h2><p id="agenda-meta" class="agenda-meta"></p><div id="agenda-list"></div></section>
          <section class="panel"><h2>日期待定</h2><div id="undated"></div></section>
          <a class="inbox-link" href="#inbox">查看收件箱与来源动态 <span>↗</span></a></aside>
      </div>
    </section>
    <section id="inbox" hidden>
      <div class="heading"><div><div class="eyebrow"><i></i> <span id="inbox-eyebrow">教学第 10 周</span></div><h1>安排收件箱</h1></div><span class="demo">交互演示 · 模拟安排与同步</span></div>
      <article class="feature">
        <div class="feature-text"><div class="kicker" id="hero-label"></div><h2 id="hero-title"></h2><p id="hero-meta"></p><button class="primary" id="continue">继续处理 <b>↗</b></button></div>
        <div class="art" aria-hidden="true"><div class="paper back"></div><div class="paper middle"></div><div class="paper front"><span class="clip"></span><small>DUE DATE</small><strong id="paper-day"></strong><div class="paper-rule"></div><span id="paper-time"></span></div></div>
      </article>
      <div class="columns"><section class="panel queue">
        <div class="panel-head"><h2>全部安排</h2><select id="course-filter" aria-label="按课程或项目筛选"></select></div>
        <div class="tabs" aria-label="作业状态"><button id="pending">待处理</button><button id="finished">已提交</button></div>
        <div id="rows"></div>
      </section><aside>
        <section class="panel"><div class="panel-head"><h2>来源动态</h2><button id="sync" class="text-button">模拟同步 ↻</button></div><div id="sources"></div><p class="footnote" id="sync-info" role="status"></p><div class="backup-tools"><h3>数据备份</h3><div class="backup-actions"><button id="export-data" class="secondary">导出 JSON</button><button id="import-data" class="secondary">从文件恢复</button><button id="undo-import" class="text-button" hidden>撤销上次恢复</button></div><input id="backup-file" type="file" accept=".json,application/json" hidden><p id="backup-status" role="status"></p></div><div class="reset-row"><button id="reset" type="button" class="text-button danger">重置演示数据</button></div></section>
        <section class="panel quick"><div class="panel-head"><h2>常用入口</h2><a href="#tools" class="text-button">全部 ↗</a></div><div id="shortcuts"></div></section>
      </aside></div>
    </section>
    <section id="courses" hidden><div class="heading"><div><div class="eyebrow"><i></i> 2026 AUTUMN</div><h1>我的课程</h1></div><span class="demo">旧站本学期课程</span></div><div id="course-grid" class="grid"></div></section>
    <section id="projects" hidden><div class="heading"><div><div class="eyebrow"><i></i> 课程 · 科研 · 创作</div><h1>项目库</h1></div><select id="project-group" aria-label="项目分类"></select></div><div id="project-grid" class="grid"></div></section>
    <section id="tools" hidden><div class="heading"><div><div class="eyebrow"><i></i> BOOKMARKS</div><h1>工具架</h1></div><div class="platform-actions"><button id="manage-tool-platforms" class="secondary">管理首页入口</button><button id="add-bookmark" class="desk-primary">＋ 添加网站</button></div></div><div id="tool-grid"></div></section>
  </main>
  <dialog id="detail" aria-labelledby="detail-title"><div class="dialog-top"><span class="eyebrow" id="detail-course"></span><button class="close" aria-label="关闭详情">×</button></div><h2 id="detail-title"></h2><p id="detail-meta"></p><div class="brief"><h3>安排说明</h3><p id="detail-brief"></p></div><div id="detail-links"></div><div id="personal-actions" hidden><button class="secondary" id="edit-personal">编辑安排</button> <button class="danger-button" id="delete-plan">删除安排</button></div><label for="next-step">下次从这里继续</label><textarea id="next-step" rows="2" placeholder="记下做到哪一步，或下次要打开哪份材料"></textarea><small id="save-status" role="status"></small><div class="dialog-actions"><button class="secondary close">返回</button><button class="primary" id="toggle-done"></button></div></dialog>
  <dialog id="project-dialog" aria-labelledby="project-name"><div class="dialog-top"><span class="eyebrow" id="project-category"></span><button class="close" aria-label="关闭项目">×</button></div><h2 id="project-name"></h2><p id="project-about"></p><div id="project-resources"></div><label for="project-note">项目下一步</label><textarea id="project-note" rows="2"></textarea><small id="project-status" role="status"></small><h3>项目安排</h3><div id="project-events"></div><form id="plan-form"><h3>添加到日历</h3><label>节点名称<input id="plan-name" required maxlength="120" placeholder="例如：复核实验结果"></label><div class="plan-times"><label>日期<input type="date" id="plan-date" required></label><label>时刻（可选）<input type="time" id="plan-time"></label></div><button class="primary">保存个人计划</button></form></dialog>
  <dialog id="entry-dialog" aria-labelledby="entry-heading">
    <div class="dialog-top"><h2 id="entry-heading">新建安排</h2><button class="close" aria-label="关闭安排表单">×</button></div>
    <form id="entry-form" class="entry-form">
      <label>标题<input id="entry-title" required maxlength="120" placeholder="例如：离散数学随堂小测" autofocus></label>
      <div class="plan-times"><label>类型<select id="entry-type"></select></label><label>来源（可选）<input id="entry-source" list="entry-sources" maxlength="120" placeholder="课堂、Canvas…"></label></div>
      <datalist id="entry-sources"><option>Canvas</option><option>学习通</option><option>智慧树</option><option>课堂通知</option></datalist>
      <div class="plan-times"><label>日期<input id="entry-date" type="date" max="9999-12-31" required></label><label>时刻（可选）<input id="entry-time" type="time"></label></div>
      <label class="check"><input id="entry-undated" type="checkbox">日期待定</label>
      <div class="plan-times"><label>关联课程<select id="entry-course"></select></label><label>关联项目<select id="entry-project"></select></label></div>
      <details id="entry-extra"><summary>说明与链接（可选）</summary>
        <label>安排说明<textarea rows="2" id="entry-brief"></textarea></label>
        <label>要求链接<input type="url" id="entry-requirement" placeholder="https://…"></label>
        <label>提交链接<input type="url" id="entry-link" placeholder="https://…"></label>
      </details>
      <div class="dialog-actions"><button class="secondary close" type="button">取消</button><button class="primary">保存安排</button></div><p id="entry-status" role="status"></p>
    </form>
  </dialog>
  <dialog id="platform-dialog" aria-labelledby="platform-heading">
    <div class="dialog-top"><h2 id="platform-heading">首页常用平台</h2><button class="close" aria-label="关闭常用平台设置">×</button></div>
    <label for="platform-picker">从工具架选择网站</label>
    <div class="platform-picker"><select id="platform-picker"></select><button id="pin-platform" class="secondary">加入首页</button></div>
    <ol id="platform-order" aria-label="首页显示顺序"></ol>
    <p id="platform-error" role="status"></p>
    <div class="dialog-actions"><button class="secondary close">取消</button><button class="primary" id="save-platforms">保存</button></div>
  </dialog>
  <dialog id="bookmark-dialog" aria-labelledby="bookmark-heading">
    <div class="dialog-top"><h2 id="bookmark-heading">添加网站</h2><button class="close" aria-label="关闭网站表单">×</button></div>
    <form id="bookmark-form" class="entry-form">
      <label>网站名称<input id="bookmark-name" maxlength="100" required placeholder="例如：数字逻辑实验平台"></label>
      <label>网址<input id="bookmark-url" type="url" required placeholder="https://…"></label>
      <label>分类<input id="bookmark-category" list="bookmark-categories" maxlength="60" required></label>
      <datalist id="bookmark-categories"></datalist>
      <p id="bookmark-error" role="alert"></p>
      <div class="dialog-actions"><button type="button" id="remove-bookmark" class="danger-button" hidden>删除网站</button><button type="button" class="secondary close">取消</button><button class="primary">保存网站</button></div>
    </form>
  </dialog>
  <dialog id="restore-dialog" aria-labelledby="restore-title">
    <div class="dialog-top"><h2 id="restore-title">恢复备份</h2><button class="close" aria-label="关闭备份预览">×</button></div>
    <p id="backup-description"></p><p id="backup-count"></p><p id="restore-error" role="status"></p>
    <div class="dialog-actions"><button class="secondary close">取消</button><button class="primary" id="confirm-restore">确认恢复</button></div>
  </dialog>
  <dialog id="session-dialog" aria-labelledby="session-title"><div class="dialog-top"><h2 id="session-title">安排学习时段</h2><button class="close" aria-label="关闭时段选择">×</button></div>
    <p id="session-task"></p><form id="session-form" class="entry-form"><label>学习日期<input id="study-date" type="date" min="0001-01-01" max="9999-12-31" required></label><div class="plan-times"><label>开始<input id="study-start" type="time" required></label><label>结束<input id="study-end" type="time" required></label></div><p id="session-conflict" role="status"></p><div class="dialog-actions"><button type="button" class="secondary close">取消</button><button class="desk-primary">保存时段</button></div></form>
  </dialog>
</body>
</html>
