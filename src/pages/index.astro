    function loadGrades() {
      try { return JSON.parse(localStorage.getItem(KEYS.grades) || '{}'); }
      catch { return {}; }
    }

    function saveGrades(data: any) {
      localStorage.setItem(KEYS.grades, JSON.stringify(data));
