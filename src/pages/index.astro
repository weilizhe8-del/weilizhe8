---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Modals from '../components/Modals.astro';
---

<Layout>
  <div class="flex h-screen overflow-hidden">
    <Sidebar />
    <main class="flex-1 flex flex-col overflow-hidden">
      <!-- Header -->
      <header class="h-16 flex items-center justify-between px-8 flex-shrink-0" style="border-bottom:1px solid var(--border-subtle)">
        <h1 class="text-sm font-medium tracking-wide" style="color:var(--text-muted)" id="tab-title">
          <span class="accent-prefix">&gt;&gt;&gt;</span> 控制面板
        </h1>
        <div class="flex items-center gap-5">
          <span class="text-xs" style="color:var(--text-muted)" id="current-date"></span>
          <span class="font-mono text-sm tabular-nums tracking-wider" style="color:var(--text-primary)" id="clock">00:00:00</span>
        </div>
      </header>

      <!-- Tab Content -->
      <div class="flex-1 overflow-y-auto p-8">

        <!-- ====== Tab 1: Dashboard ====== -->
        <div id="tab-dashboard" class="tab-pane space-y-8">
          <!-- Semester Progress -->
          <div class="t-bg-card border t-border rounded-xl p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-zinc-500 uppercase tracking-wider">学期进度</span>
              <span class="font-mono text-xs text-zinc-600" id="semester-label">Week ? / ?</span>
            </div>
            <div class="h-1 t-bg-input rounded-full overflow-hidden">
              <div class="progress-fill h-full bg-sky-400/60 rounded-full" id="semester-bar" style="width:0%"></div>
            </div>
            <div class="flex justify-between mt-3">
              <span class="text-xs text-zinc-500" id="semester-elapsed">已用 ? 天</span>
              <span class="text-xs text-zinc-600" id="semester-remaining">剩余 ? 天</span>
            </div>
          </div>

          <!-- Two Column -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Upcoming Deadlines -->
            <div class="t-bg-card border t-border rounded-xl p-6">
              <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-5">临近倒计时</h3>
              <div id="upcoming-deadlines" class="space-y-4">
                <p class="text-sm text-zinc-600">暂无日程</p>
              </div>
            </div>
            <!-- Quick Links -->
            <div class="t-bg-card border t-border rounded-xl p-6">
              <div class="flex items-center justify-between mb-5">
                <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">快速导航</h3>
                <button onclick="openModal('modal-quicklink')" class="text-xs text-sky-400/70 hover:text-sky-400 transition-colors">
                  <i data-lucide="plus" class="w-3.5 h-3.5 inline"></i>
                  新增
                </button>
              </div>
              <div id="quick-links" class="grid grid-cols-2 gap-3">
                <p class="text-sm text-zinc-600 col-span-2">暂无链接</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ====== Tab 2: Calendar ====== -->
        <div id="tab-calendar" class="tab-pane hidden">
          <!-- View Toggle -->
          <div class="flex items-center justify-end mb-4 gap-1">
            <button id="btn-view-list" onclick="switchCalendarView('list')"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-sky-400/10 border border-sky-400/30 text-sky-400 transition-colors">
              <i data-lucide="list" class="w-3.5 h-3.5"></i> 时间排序
            </button>
            <button id="btn-view-quadrant" onclick="switchCalendarView('quadrant')"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border t-border text-zinc-400 hover:text-zinc-200 hover:t-bg-input transition-colors">
              <i data-lucide="grid-2x2" class="w-3.5 h-3.5"></i> 四象限
            </button>
          </div>

          <!-- List View -->
          <div id="calendar-list-view">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
              <!-- Add Event Form -->
              <div class="t-bg-card border t-border rounded-xl p-6">
                <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-5">新增日程</h3>
                <form id="form-event-inline" class="space-y-4">
                  <div>
                    <label class="block text-xs font-medium text-zinc-500 mb-1.5">事件名称</label>
                    <input type="text" name="name" required placeholder="例如：机器学习期末答辩"
                      class="w-full t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-sky-400/50 transition-colors" />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-zinc-500 mb-1.5">截止时间</label>
                    <div class="flex gap-2">
                      <input type="date" name="deadlineDate" required placeholder="年/月/日"
                        class="flex-1 t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-400/50 transition-colors" />
                      <input type="time" name="deadlineTime" required placeholder="时:分"
                        class="w-28 t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-400/50 transition-colors" />
                    </div>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-zinc-500 mb-1.5">类别</label>
                    <select name="category"
                      class="w-full t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-400/50 transition-colors">
                      <option value="作业">作业</option>
                      <option value="pre">pre</option>
                      <option value="考试">考试</option>
                      <option value="个人">个人</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-zinc-500 mb-1.5">四象限分类</label>
                    <select name="quadrant"
                      class="w-full t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-400/50 transition-colors">
                      <option value="q4">不紧急不重要</option>
                      <option value="q1">紧急且重要</option>
                      <option value="q2">重要不紧急</option>
                      <option value="q3">紧急不重要</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-zinc-500 mb-1.5">考场/地点 <span class="text-zinc-600">(选填)</span></label>
                    <input type="text" name="location" placeholder="例如：北215"
                      class="w-full t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-sky-400/50 transition-colors" />
                  </div>
                  <button type="submit"
                    class="w-full py-2 rounded-lg bg-sky-400/10 border border-sky-400/30 text-sm text-sky-400 hover:bg-sky-400/20 transition-colors">
                    添加日程
                  </button>
                </form>
              </div>
              <!-- Events Timeline -->
              <div class="lg:col-span-2 t-bg-card border t-border rounded-xl p-6">
                <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-5">全部日程</h3>
                <div id="events-list" class="space-y-3">
                  <p class="text-sm text-zinc-600">暂无日程</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Quadrant View -->
          <div id="quadrant-view" class="hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" style="height:calc(100vh - 11rem)">
              <!-- Q1: 紧急且重要 -->
              <div class="quadrant-drop rounded-xl border border-rose-500/30 bg-rose-500/5 p-4 flex flex-col" data-quadrant="q1"
                ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'q1')">
                <div class="flex items-center gap-2 mb-3 flex-shrink-0">
                  <div class="w-2 h-2 rounded-full bg-rose-400"></div>
                  <h3 class="text-sm font-semibold text-rose-300">紧急且重要</h3>
                  <span class="text-[10px] text-rose-400/60 ml-auto">立即处理</span>
                </div>
                <div id="quadrant-q1-items" class="flex-1 space-y-2 overflow-y-auto min-h-[80px]"></div>
              </div>
              <!-- Q2: 重要不紧急 -->
              <div class="quadrant-drop rounded-xl border border-sky-400/30 bg-sky-400/5 p-4 flex flex-col" data-quadrant="q2"
                ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'q2')">
                <div class="flex items-center gap-2 mb-3 flex-shrink-0">
                  <div class="w-2 h-2 rounded-full bg-sky-400"></div>
                  <h3 class="text-sm font-semibold text-sky-300">重要不紧急</h3>
                  <span class="text-[10px] text-sky-400/60 ml-auto">规划执行</span>
                </div>
                <div id="quadrant-q2-items" class="flex-1 space-y-2 overflow-y-auto min-h-[80px]"></div>
              </div>
              <!-- Q3: 紧急不重要 -->
              <div class="quadrant-drop rounded-xl border border-amber-400/30 bg-amber-400/5 p-4 flex flex-col" data-quadrant="q3"
                ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'q3')">
                <div class="flex items-center gap-2 mb-3 flex-shrink-0">
                  <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                  <h3 class="text-sm font-semibold text-amber-300">紧急不重要</h3>
                  <span class="text-[10px] text-amber-400/60 ml-auto">委托他人</span>
                </div>
                <div id="quadrant-q3-items" class="flex-1 space-y-2 overflow-y-auto min-h-[80px]"></div>
              </div>
              <!-- Q4: 不紧急不重要 -->
              <div class="quadrant-drop rounded-xl border border-zinc-700/30 bg-zinc-800/20 p-4 flex flex-col" data-quadrant="q4"
                ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'q4')">
                <div class="flex items-center gap-2 mb-3 flex-shrink-0">
                  <div class="w-2 h-2 rounded-full bg-zinc-500"></div>
                  <h3 class="text-sm font-semibold text-zinc-400">不紧急不重要</h3>
                  <span class="text-[10px] text-zinc-500 ml-auto">考虑删减</span>
                </div>
                <div id="quadrant-q4-items" class="flex-1 space-y-2 overflow-y-auto min-h-[80px]"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- ====== Tab 3: Courses ====== -->
        <div id="tab-courses" class="tab-pane hidden space-y-6">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">在研课程</h3>
            <button onclick="openModal('modal-course')" class="text-xs text-sky-400/70 hover:text-sky-400 transition-colors">
              <i data-lucide="plus" class="w-3.5 h-3.5 inline"></i>
              注册课程
            </button>
          </div>
          <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            <p class="text-sm text-zinc-600">暂无课程</p>
          </div>
        </div>

        <!-- ====== Tab: GPA Calculator ====== -->
        <div id="tab-gpa" class="tab-pane hidden space-y-6">
          <!-- Mode Toggle & Header -->
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">绩点计算</h3>
            <div class="flex items-center gap-1 t-bg-input rounded-lg p-0.5">
              <button id="btn-gpa-five" onclick="switchGpaMode('five')"
                class="px-3 py-1.5 rounded-md text-xs font-medium bg-sky-400/10 border border-sky-400/30 text-sky-400 transition-colors">5分制</button>
              <button id="btn-gpa-hundred" onclick="switchGpaMode('hundred')"
                class="px-3 py-1.5 rounded-md text-xs font-medium border border-transparent text-zinc-400 hover:text-zinc-200 transition-colors">百分制</button>
            </div>
          </div>

          <!-- Grade Reference Table -->
          <div class="t-bg-card border t-border rounded-xl p-5">
            <h4 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-4">成绩对照表</h4>
            <div class="overflow-x-auto">
              <table class="w-full text-xs">
                <thead>
                  <tr class="border-b t-border">
                    <th class="text-left py-2 px-3 text-zinc-500 font-medium">成绩等级</th>
                    <th class="text-center py-2 px-3 text-zinc-500 font-medium">课程绩点</th>
                    <th class="text-center py-2 px-3 text-zinc-500 font-medium">百分制成绩区间</th>
                    <th class="text-center py-2 px-3 text-zinc-500 font-medium">百分制折算值</th>
                  </tr>
                </thead>
                <tbody class="text-zinc-400">
                  <tr class="border-b t-border">
                    <td class="py-2.5 px-3"><span class="text-emerald-400 font-medium">优</span> <span class="text-zinc-500">/ A</span></td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">5.0</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-500">89.5 – 100</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">95</td>
                  </tr>
                  <tr class="border-b t-border">
                    <td class="py-2.5 px-3"><span class="text-sky-400 font-medium">良</span> <span class="text-zinc-500">/ B</span></td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">4.0</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-500">79.5 – 89.4</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">85</td>
                  </tr>
                  <tr class="border-b t-border">
                    <td class="py-2.5 px-3"><span class="text-amber-400 font-medium">中</span> <span class="text-zinc-500">/ C</span></td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">3.0</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-500">69.5 – 79.4</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">75</td>
                  </tr>
                  <tr class="border-b t-border">
                    <td class="py-2.5 px-3"><span class="text-orange-400 font-medium">及格</span> <span class="text-zinc-500">/ D</span></td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">2.0</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-500">59.5 – 69.4</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">65</td>
                  </tr>
                  <tr>
                    <td class="py-2.5 px-3"><span class="text-rose-400 font-medium">不及格/无效</span> <span class="text-zinc-500">/ F</span></td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">0.0</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-500">0 – 59.4</td>
                    <td class="py-2.5 px-3 text-center font-mono text-zinc-200">30</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Course Grade Inputs -->
          <div id="gpa-courses" class="space-y-3">
            <p class="text-sm text-zinc-600">请在"课程管理"中先注册课程</p>
          </div>

          <!-- GPA Result -->
          <div class="t-bg-card border t-border rounded-xl p-6">
            <div class="flex items-end justify-center gap-8">
              <div class="text-center">
                <span id="gpa-value" class="text-5xl font-mono font-light text-sky-400">--</span>
                <p id="gpa-label" class="text-xs text-zinc-500 mt-2">5分制 GPA</p>
              </div>
              <div class="text-center text-xs text-zinc-500 mb-1">
                <span id="gpa-course-count">0</span> 门课程已评分，共计 <span id="gpa-total-credits">0</span> 学分
              </div>
            </div>
          </div>
        </div>

        <!-- ====== Tab 4: Tools ====== -->
        <div id="tab-tools" class="tab-pane hidden space-y-8">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">常用工具</h3>
            <button onclick="openModal('modal-tool')" class="text-xs text-sky-400/70 hover:text-sky-400 transition-colors">
              <i data-lucide="plus" class="w-3.5 h-3.5 inline"></i>
              新增
            </button>
          </div>
          <div id="tools-sections"></div>
        </div>

        <!-- ====== Tab 5: Script Builder ====== -->
        <div id="tab-script-builder" class="tab-pane hidden" style="height:calc(100vh - 4rem);">
          <iframe src="/script-builder/" class="w-full h-full border-0" style="min-height:100%;"></iframe>
        </div>

        <!-- ====== Tab 6: Base Converter ====== -->
        <div id="tab-base-converter" class="tab-pane hidden" style="height:calc(100vh - 4rem);">
          <iframe src="/jin-zhi-converter/" class="w-full h-full border-0" style="min-height:100%;"></iframe>
        </div>

        <!-- ====== Tab 7: LaTeX Tool ====== -->
        <div id="tab-latex-tool" class="tab-pane hidden" style="height:calc(100vh - 4rem);">
          <iframe src="/latex-tool/" class="w-full h-full border-0" style="min-height:100%;"></iframe>
        </div>

        <!-- ====== Tab: Decision Spinner ====== -->
        <div id="tab-spinner" class="tab-pane hidden space-y-6">
          <!-- Header + Presets -->
          <div class="flex items-center justify-between flex-wrap gap-3">
            <h3 class="text-xs font-medium text-zinc-500 uppercase tracking-wider">我来决策</h3>
            <div class="flex items-center gap-2">
              <button onclick="loadPreset('yesno')" class="px-2.5 py-1 rounded-md text-[11px] font-medium t-bg-input border t-border text-zinc-400 hover:text-zinc-200 hover:border-zinc-600/60 transition-colors">是/否</button>
              <button onclick="loadPreset('gogo')" class="px-2.5 py-1 rounded-md text-[11px] font-medium t-bg-input border t-border text-zinc-400 hover:text-zinc-200 hover:border-zinc-600/60 transition-colors">去/不去</button>
              <button onclick="loadPreset('eat')" class="px-2.5 py-1 rounded-md text-[11px] font-medium t-bg-input border t-border text-zinc-400 hover:text-zinc-200 hover:border-zinc-600/60 transition-colors">吃啥</button>
              <button onclick="loadPreset('custom')" class="px-2.5 py-1 rounded-md text-[11px] font-medium bg-sky-400/10 border border-sky-400/30 text-sky-400 hover:bg-sky-400/20 transition-colors">自定义</button>
            </div>
          </div>

          <!-- Wheel + Controls Row -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Canvas Wheel -->
            <div class="lg:col-span-2 flex flex-col items-center gap-4">
              <div class="relative inline-block">
                <canvas id="wheel-canvas" width="420" height="420" class="block"></canvas>
                <div id="wheel-pointer" class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1 w-0 h-0" style="border-left: 14px solid transparent; border-right: 14px solid transparent; border-top: 22px solid #e4e4e7; filter: drop-shadow(0 1px 3px rgba(0,0,0,0.5));"></div>
              </div>
              <button id="btn-spin" onclick="spinWheel()"
                class="px-10 py-3 rounded-xl bg-sky-400/10 border border-sky-400/30 text-base font-semibold text-sky-400 hover:bg-sky-400/20 transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-sky-400/10">
                开始转动
              </button>
              <div id="spin-result" class="text-lg font-medium text-zinc-200 min-h-[2rem]"></div>
            </div>

            <!-- Add Options + List -->
            <div class="space-y-4">
              <div class="t-bg-card border t-border rounded-xl p-4">
                <h4 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-3">添加选项</h4>
                <div class="flex gap-2">
                  <input type="text" id="input-option" placeholder="输入选项名称..."
                    onkeydown="if(event.key==='Enter'){addOption();event.preventDefault();}"
                    class="flex-1 t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-sky-400/50 transition-colors" />
                  <button onclick="addOption()"
                    class="px-4 py-2 rounded-lg bg-sky-400/10 border border-sky-400/30 text-sm text-sky-400 hover:bg-sky-400/20 transition-colors flex-shrink-0">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                  </button>
                </div>
              </div>

              <div class="t-bg-card border t-border rounded-xl p-4">
                <h4 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-3">选项列表 <span id="option-count" class="text-zinc-600">(0)</span></h4>
                <div id="options-list" class="space-y-1.5 max-h-64 overflow-y-auto">
                  <p class="text-xs text-zinc-600">请添加至少 2 个选项</p>
                </div>
              </div>

              <!-- History -->
              <div class="t-bg-card border t-border rounded-xl p-4">
                <h4 class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-3">历史记录</h4>
                <div id="spinner-history" class="space-y-1.5 max-h-48 overflow-y-auto">
                  <p class="text-xs text-zinc-600">暂无记录</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </main>
    <Modals />
  </div>

  <script>
    declare const lucide: { createIcons: () => void };
    // ============================================================
    // DATA LAYER
    // ============================================================
    const KEYS = {
      events: 'wd_events',
      courses: 'wd_courses',
      quickLinks: 'wd_quick_links',
      toolLinks: 'wd_tool_links',
      grades: 'wd_grades',
    };

    const GRADE_MAP: Record<string, { label: string; gpa: number; min: number; max: number; convert: number }> = {
      'A': { label: '优 / A', gpa: 5.0, min: 89.5, max: 100, convert: 95 },
      'B': { label: '良 / B', gpa: 4.0, min: 79.5, max: 89.4, convert: 85 },
      'C': { label: '中 / C', gpa: 3.0, min: 69.5, max: 79.4, convert: 75 },
      'D': { label: '及格 / D', gpa: 2.0, min: 59.5, max: 69.4, convert: 65 },
      'F': { label: '不及格 / F', gpa: 0.0, min: 0, max: 59.4, convert: 30 },
    };

    function percentToGrade(pct: number): string {
      if (pct >= 89.5) return 'A';
