    function getGpaMode(): string {
      const grades = loadGrades();
      return grades.mode || 'five';
    }

    function switchGpaMode(mode: string) {
      const grades = loadGrades();
      grades.mode = mode;
      saveGrades(grades);

      const btnFive = document.getElementById('btn-gpa-five');
      const btnHundred = document.getElementById('btn-gpa-hundred');
      if (btnFive && btnHundred) {
        if (mode === 'five') {
          btnFive.className = 'px-3 py-1.5 rounded-md text-xs font-medium bg-sky-400/10 border border-sky-400/30 text-sky-400 transition-colors';
          btnHundred.className = 'px-3 py-1.5 rounded-md text-xs font-medium border border-transparent text-zinc-400 hover:text-zinc-200 transition-colors';
        } else {
          btnFive.className = 'px-3 py-1.5 rounded-md text-xs font-medium border border-transparent text-zinc-400 hover:text-zinc-200 transition-colors';
          btnHundred.className = 'px-3 py-1.5 rounded-md text-xs font-medium bg-sky-400/10 border border-sky-400/30 text-sky-400 transition-colors';
        }
      }

      const labelEl = document.getElementById('gpa-label');
      if (labelEl) labelEl.textContent = mode === 'five' ? '5分制 GPA' : '百分制 GPA';

      renderGpaCourses();
      updateGpaResult();
    }

    function setGpaGrade(courseId: string, grade: string) {
      const grades = loadGrades();
      if (!grades.grades) grades.grades = {};
      if (grade === '') {
        delete grades.grades[courseId];
      } else {
        grades.grades[courseId] = grade;
      }
      saveGrades(grades);
      updateGpaResult();
    }

    function updateGpaResult() {
      const courses = load(KEYS.courses);
      const grades = loadGrades();
      const gradeEntries = grades.grades || {};
      const mode = grades.mode || 'five';

      let totalWeighted = 0;
      let totalCredits = 0;

      for (const c of courses) {
        const g = gradeEntries[c.id];
        if (!g) continue;
        const credits = c.credits || 0;

        if (mode === 'five') {
          const info = GRADE_MAP[g];
          if (info) {
            totalWeighted += info.gpa * credits;
            totalCredits += credits;
          }
        } else {
          const pct = parseFloat(g);
          if (!isNaN(pct)) {
            const gradeKey = percentToGrade(pct);
            const info = GRADE_MAP[gradeKey];
            if (info) {
              totalWeighted += info.convert * credits;
              totalCredits += credits;
            }
          }
        }
      }

      const gpaValue = document.getElementById('gpa-value');
      const countEl = document.getElementById('gpa-course-count');
      const totalCreditsEl = document.getElementById('gpa-total-credits');
      if (gpaValue) {
        gpaValue.textContent = totalCredits > 0 ? (totalWeighted / totalCredits).toFixed(2) : '--';
      }
      if (countEl) {
        const count = Object.keys(gradeEntries).filter(id => courses.some((c: any) => c.id === id)).length;
        countEl.textContent = String(count);
      }
      if (totalCreditsEl) {
        totalCreditsEl.textContent = String(totalCredits);
      }
    }

    function renderGpaCourses() {
      const container = document.getElementById('gpa-courses');
      if (!container) return;

      const courses = load(KEYS.courses);
      if (courses.length === 0) {
        container.innerHTML = '<p class="text-sm text-zinc-600">请在"课程管理"中先注册课程</p>';
        return;
      }

      const grades = loadGrades();
      const gradeEntries = grades.grades || {};
      const mode = grades.mode || 'five';

      container.innerHTML = courses.map((c: any) => {
        const savedGrade = gradeEntries[c.id] || '';
        let inputHtml = '';

        if (mode === 'five') {
          inputHtml = `
            <select onchange="setGpaGrade('${c.id}', this.value)"
              class="t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-400/50 transition-colors">
              <option value="" class="t-bg-card text-zinc-500">-- 选择等级 --</option>
              <option value="A" class="t-bg-card text-emerald-400" ${savedGrade === 'A' ? 'selected' : ''}>优 / A (5.0)</option>
              <option value="B" class="t-bg-card text-sky-400" ${savedGrade === 'B' ? 'selected' : ''}>良 / B (4.0)</option>
              <option value="C" class="t-bg-card text-amber-400" ${savedGrade === 'C' ? 'selected' : ''}>中 / C (3.0)</option>
              <option value="D" class="t-bg-card text-orange-400" ${savedGrade === 'D' ? 'selected' : ''}>及格 / D (2.0)</option>
              <option value="F" class="t-bg-card text-rose-400" ${savedGrade === 'F' ? 'selected' : ''}>不及格 / F (0.0)</option>
            </select>`;
        } else {
          const mappedGrade = savedGrade && !isNaN(parseFloat(savedGrade)) ? percentToGrade(parseFloat(savedGrade)) : null;
          inputHtml = `
            <div class="flex items-center gap-2">
              <input type="number" min="0" max="100" value="${savedGrade}" placeholder="0-100"
                onchange="setGpaGrade('${c.id}', this.value)"
                class="w-24 t-bg-input border t-border rounded-lg px-3 py-2 text-sm text-zinc-200 text-center placeholder-zinc-600 focus:outline-none focus:border-sky-400/50 transition-colors" />
              ${mappedGrade ? `<span class="text-xs px-2 py-1 rounded ${gradeColorClass(mappedGrade)}">${GRADE_MAP[mappedGrade].label}</span>` : ''}
            </div>`;
        }

        return `
          <div class="t-bg-card border t-border rounded-xl p-4 flex items-center justify-between">
            <div class="min-w-0 flex-1">
              <h4 class="text-sm text-zinc-200 truncate">${c.name}</h4>
              <span class="text-xs text-zinc-500">${c.credits} 学分</span>
            </div>
            <div class="flex-shrink-0 ml-4">
              ${inputHtml}
            </div>
          </div>`;
      }).join('');

      updateGpaResult();
    }

    function gradeColorClass(grade: string) {
      const map: Record<string, string> = {
        'A': 'bg-emerald-400/15 text-emerald-400 border border-emerald-400/30',
        'B': 'bg-sky-400/15 text-sky-400 border border-sky-400/30',
        'C': 'bg-amber-400/15 text-amber-400 border border-amber-400/30',
        'D': 'bg-orange-400/15 text-orange-400 border border-orange-400/30',
        'F': 'bg-rose-400/15 text-rose-400 border border-rose-400/30',
      };
      return map[grade] || 'text-zinc-500';
    }

