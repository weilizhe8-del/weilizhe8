    function init() {
      initDemoDataIfEmpty();
      migrateCourses();
      syncCourseEvents();
      syncManualEvents();
      syncToolLinks();
      syncQuickLinks();
      setupListeners();
      updateClock();
      renderSemesterProgress();
      renderEvents();
      renderQuickLinks();
      renderCourses();
      renderToolLinks();
      const savedView = localStorage.getItem('wd_calendar_view');
      if (savedView === 'quadrant') switchCalendarView('quadrant');

      setInterval(updateClock, 1000);
      setInterval(tickCountdowns, 30000);
      setInterval(renderSemesterProgress, 60000);
    }

    // Wait for DOM and Lucide
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
