    function quadrantToFields(q: string): { importance: string; urgency: string } {
      if (q === 'q1') return { importance: 'high', urgency: 'high' };
      if (q === 'q2') return { importance: 'high', urgency: 'low' };
      if (q === 'q3') return { importance: 'low', urgency: 'high' };
      return { importance: 'low', urgency: 'low' };
    }

    function fieldsToQuadrant(importance: string, urgency: string): string {
      if (importance === 'high' && urgency === 'high') return 'q1';
      if (importance === 'high' && urgency === 'low') return 'q2';
      if (importance === 'low' && urgency === 'high') return 'q3';
      return 'q4';
    }

    function addEvent(data: { name: string; deadline: string; category: string; location?: string; importance?: string; urgency?: string }) {
      const events = load(KEYS.events);
      events.push({ id: generateId(), importance: 'low', urgency: 'low', ...data });
      save(KEYS.events, events);
      renderEvents();
    }

    function deleteEvent(id: string) {
      const events = load(KEYS.events).filter((e: any) => e.id !== id);
      save(KEYS.events, events);
      renderEvents();
    }

    function editEvent(id: string) {
      const events = load(KEYS.events);
      const event = events.find((e: any) => e.id === id);
      if (!event) return;
      const form = document.getElementById('form-event') as HTMLFormElement;
      if (!form) return;
      (form.querySelector('[name="editId"]') as HTMLInputElement).value = event.id;
      (form.querySelector('[name="name"]') as HTMLInputElement).value = event.name || '';
      (form.querySelector('[name="deadlineDate"]') as HTMLInputElement).value = event.deadline ? event.deadline.slice(0, 10) : '';
      (form.querySelector('[name="deadlineTime"]') as HTMLInputElement).value = event.deadline ? event.deadline.slice(11, 16) : '';
      (form.querySelector('[name="category"]') as HTMLSelectElement).value = event.category || '作业';
      (form.querySelector('[name="location"]') as HTMLInputElement).value = event.location || '';
      const qSelect = form.querySelector('[name="quadrant"]') as HTMLSelectElement;
      if (qSelect) qSelect.value = fieldsToQuadrant(event.importance || 'low', event.urgency || 'low');
      const titleEl = document.getElementById('modal-event-title');
      if (titleEl) titleEl.textContent = '编辑日程';
      openModal('modal-event');
    }

