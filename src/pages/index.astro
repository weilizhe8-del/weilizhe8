---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="概览" active="home">
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(0,122,255,0.08)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <div class="stat-body">
        <span class="stat-value" id="count-events">--</span>
        <span class="stat-label">日历事件</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(52,199,89,0.08)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#34C759" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </div>
      <div class="stat-body">
        <span class="stat-value" id="count-courses">--</span>
        <span class="stat-label">课程</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(255,59,48,0.08)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FF3B30" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="stat-body">
        <span class="stat-value" id="count-ddl">--</span>
        <span class="stat-label">即将截止</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(255,149,0,0.08)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FF9500" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      </div>
      <div class="stat-body">
        <span class="stat-value" id="count-tools">--</span>
        <span class="stat-label">快捷工具</span>
      </div>
    </div>
  </div>

  <div class="dash-grid">
    <section class="card">
      <div class="card-header">
        <h3>近期事件</h3>
        <a href="/calendar" class="link-sm">全部</a>
      </div>
      <div id="upcoming-events" class="list-compact"></div>
    </section>
    <section class="card">
      <div class="card-header">
        <h3>课程 DDL</h3>
        <a href="/courses" class="link-sm">全部</a>
      </div>
      <div id="upcoming-ddl" class="list-compact"></div>
    </section>
  </div>

</BaseLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .stat-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  .stat-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .stat-body {
    display: flex;
    flex-direction: column;
  }
  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: 0.78rem;
    color: #86868B;
  }

  .dash-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .card-header h3 {
    font-size: 1rem;
    font-weight: 600;
  }
  .link-sm {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-accent-soft);
  }
  .link-sm:hover {
    color: var(--color-accent);
  }
  .list-compact {
    min-height: 80px;
  }
  .list-item-sm {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.88rem;
  }
  .list-item-sm:last-child {
    border-bottom: none;
  }
  .list-item-sm .date {
    color: #64748B;
    font-size: 0.8rem;
    white-space: nowrap;
    margin-left: 0.75rem;
    font-family: var(--font-heading);
  }
  .text-muted {
    color: #64748B;
    font-size: 0.88rem;
    padding: 1rem 0;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .dash-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  interface CalendarEvent {
    id: string;
    title: string;
    date: string;
    type: 'event' | 'ddl' | 'exam';
    courseId?: string;
  }
  interface Course {
    id: string;
    name: string;
    credits: number;
    teacher: string;
    ddl: string;
    grading: { item: string; weight: number }[];
  }

  function load<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch { return fallback; }
  }

  const events: CalendarEvent[] = load<CalendarEvent[]>('weilizhe8_events', []);
  const courses: Course[] = load<Course[]>('weilizhe8_courses', []);
  const tools: { category: string; items: { name: string; url: string }[] }[] = load('weilizhe8_tools', []);

  document.getElementById('count-events')!.textContent = String(events.length);
  document.getElementById('count-courses')!.textContent = String(courses.length);

  const now = new Date();
  const weekLater = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
  const upcoming = events
    .filter(e => new Date(e.date) >= now && new Date(e.date) <= weekLater)
    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
  document.getElementById('count-ddl')!.textContent = String(upcoming.length);

  let toolCount = 0;
  for (const cat of tools) toolCount += cat.items.length;
  document.getElementById('count-tools')!.textContent = String(toolCount);

  const evtContainer = document.getElementById('upcoming-events')!;
  const recentEvents = events
    .filter(e => new Date(e.date) >= now)
    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
    .slice(0, 5);
  if (recentEvents.length > 0) {
    evtContainer.innerHTML = recentEvents.map(e =>
      `<div class="list-item-sm"><span>${e.title}</span><span class="date">${e.date}</span></div>`
    ).join('');
  } else {
    evtContainer.innerHTML = '<p class="text-muted">暂无近期事件，去<a href="/calendar">日历</a>添加吧</p>';
  }

  const ddlContainer = document.getElementById('upcoming-ddl')!;
  const ddls = events
    .filter(e => (e.type === 'ddl' || e.type === 'exam') && new Date(e.date) >= now)
    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
    .slice(0, 5);
  if (ddls.length > 0) {
    ddlContainer.innerHTML = ddls.map(e =>
      `<div class="list-item-sm"><span>${e.title}</span><span class="date">${e.date}</span></div>`
    ).join('');
  } else {
    ddlContainer.innerHTML = '<p class="text-muted">暂无即将到期的 DDL</p>';
  }
</script>
